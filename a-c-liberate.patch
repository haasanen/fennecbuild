+package com.google.android.play.core.integrity;
+
+import android.app.Activity;
+import com.google.android.gms.tasks.Task;
+import java.util.Set;
+
+/*
+ * Classes hierarchy in this file:
+ *
+ * StandardIntegrityManager
+ * ├── PrepareIntegrityTokenRequest
+ * │   └── Builder
+ * ├── StandardIntegrityTokenRequest
+ * │   └── Builder
+ * ├── StandardIntegrityToken
+ * ├── StandardIntegrityTokenProvider
+ * └── StandardIntegrityDialogRequest
+ *     ├── Builder
+ *     └── StandardIntegrityResponse
+ *         ├── ExceptionDetails
+ *         └── TokenResponse
+ */
+public interface StandardIntegrityManager {
+
+    Task<StandardIntegrityTokenProvider> prepareIntegrityToken(
+            PrepareIntegrityTokenRequest request);
+
+    Task<Integer> showDialog(
+            StandardIntegrityDialogRequest request);
+
+    abstract class PrepareIntegrityTokenRequest {
+
+        public PrepareIntegrityTokenRequest() {
+        }
+
+        public static Builder builder() {
+            throw new UnsupportedOperationException();
+        }
+
+        public abstract long cloudProjectNumber();
+
+        public abstract int webViewRequestMode();
+
+        public abstract static class Builder {
+
+            public Builder() {
+            }
+
+            public abstract PrepareIntegrityTokenRequest build();
+            public abstract Builder setCloudProjectNumber(long value);
+            public abstract Builder setWebViewRequestMode(int value);
+
+        }
+
+    }
+
+    abstract class StandardIntegrityTokenRequest {
+
+        public StandardIntegrityTokenRequest() {
+        }
+
+        public static Builder builder() {
+            throw new UnsupportedOperationException();
+        }
+
+        public abstract String requestHash();
+
+        public abstract Set<Integer> verdictOptOut();
+
+        public abstract static class Builder {
+
+            public Builder() {
+            }
+
+            public abstract StandardIntegrityTokenRequest build();
+            public abstract Builder setRequestHash(String value);
+            public abstract Builder setVerdictOptOut(Set<Integer> value);
+
+        }
+
+    }
+
+    abstract class StandardIntegrityToken {
+
+        public StandardIntegrityToken() {
+        }
+
+        public abstract String token();
+
+    }
+
+    interface StandardIntegrityTokenProvider {
+
+        Task<StandardIntegrityToken> request(StandardIntegrityTokenRequest request);
+
+    }
+
+    abstract class StandardIntegrityDialogRequest {
+
+        public StandardIntegrityDialogRequest() {
+        }
+
+        public static Builder builder() {
+            throw new UnsupportedOperationException();
+        }
+
+        public abstract Activity activity();
+        public abstract StandardIntegrityResponse standardIntegrityResponse();
+        public abstract int typeCode();
+
+        public abstract static class Builder {
+
+            public Builder() {
+            }
+
+            public abstract StandardIntegrityDialogRequest build();
+            public abstract Builder setActivity(Activity activity);
+            public abstract Builder setStandardIntegrityResponse(
+                    StandardIntegrityResponse standardIntegrityResponse);
+            public abstract Builder setTypeCode(int typeCode);
+
+        }
+
+        public abstract static class StandardIntegrityResponse {
+
+            public StandardIntegrityResponse() {
+            }
+
+            public static final class ExceptionDetails extends StandardIntegrityResponse {
+
+                private final StandardIntegrityException exception;
+
+                public ExceptionDetails(StandardIntegrityException exception) {
+                    this.exception = exception;
+                }
+
+                public StandardIntegrityException getException() {
+                    return exception;
+                }
+
+            }
+
+            public static final class TokenResponse extends StandardIntegrityResponse {
+
+                private final StandardIntegrityToken token;
+
+                public TokenResponse(StandardIntegrityToken token) {
+                    this.token = token;
+                }
+
+                public StandardIntegrityToken getToken() {
+                    return token;
+                }
+
+            }
+
+        }
+
+    }
+
+}
