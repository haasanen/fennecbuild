+package com.google.android.play.core.review.testing;
+
+import android.app.Activity;
+import android.content.Context;
+import android.os.Parcel;
+
+import com.google.android.gms.tasks.Task;
+import com.google.android.gms.tasks.Tasks;
+import com.google.android.play.core.review.ReviewInfo;
+import com.google.android.play.core.review.ReviewManager;
+
+/**
+ * Test double for Google Play's review Fake. The fork ships in-tree review
+ * dummies (com.google.android.play.core.review) instead of the Play Core
+ * artifact; this mirrors them for unit tests (upstream test imports).
+ */
+public final class FakeReviewManager implements ReviewManager {
+    private final Context context;
+
+    public FakeReviewManager(Context context) {
+        this.context = context;
+    }
+
+    @Override
+    public Task<ReviewInfo> requestReviewFlow() {
+        return Tasks.forResult(new ReviewInfo() {
+            @Override
+            public int describeContents() {
+                return 0;
+            }
+
+            @Override
+            public void writeToParcel(Parcel dest, int flags) {
+            }
+
+            @Override
+            public String toString() {
+                return "ReviewInfo{pendingIntent=null, }";
+            }
+        });
+    }
+
+    @Override
+    public Task<Void> launchReviewFlow(Activity activity, ReviewInfo reviewInfo) {
+        return Tasks.forResult(null);
+    }
+}
