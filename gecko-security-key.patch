+    assertEquals("none", attObj.get("fmt").AsString());
+    assertArrayEquals(new byte[] {9, 9}, attObj.get("attStmt").get("x5c").GetByteString());
+  }
+
+  @Test
+  public void makeCredential_decodeResponse_missingFieldThrows() {
+    final CBORObject resp = CBORObject.NewMap()
