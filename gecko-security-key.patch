@@ -0,0 +1,434 @@
+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+import android.hardware.usb.UsbConstants;
+import android.hardware.usb.UsbDevice;
+import android.hardware.usb.UsbDeviceConnection;
+import android.hardware.usb.UsbEndpoint;
+import android.hardware.usb.UsbInterface;
+import android.hardware.usb.UsbManager;
+import android.hardware.usb.UsbRequest;
+import android.util.Log;
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.security.SecureRandom;
+
+/**
+ * CTAP2 over USB HID transport ("CTAPHID"), per the FIDO Alliance CTAP v2.0 spec, section 8.1.
+ *
+ * <p>Wire layer (spec 8.1.4): fixed-size HID reports (64 bytes on full-speed devices).
+ * Initialization packet: CID(4) CMD(1, bit 7 set) BCNT(2, big-endian) DATA(...). Continuation
+ * packet: CID(4) SEQ(1, 0..0x7f, ascending) DATA(...).
+ *
+ * <p>Handshake (spec 8.1.9.1.3, CTAPHID_INIT 0x06): INIT on the broadcast CID (0xFFFFFFFF)
+ * allocates a channel. Request data is an 8-byte nonce; the response carries the same nonce, then
+ * the 4-byte channel ID, protocol version, device version, capability flags. Commands then run on
+ * the allocated channel.
+ *
+ * <p>CTAP2 commands (spec 8.1.9.1.2, CTAPHID_CBOR 0x10): request data is the CTAP command byte
+ * followed by the CBOR payload; response data is the CTAP status byte followed by the CBOR
+ * payload. Keep-alive packets (CTAPHID_KEEPALIVE 0x3B) are consumed and skipped. A CTAPHID_ERROR
+ * (0x3F) response carries a 1-byte CTAPHID error code (spec 8.1.9.1.6).
+ *
+ * <p>Host side: standard Android USB host mode (UsbRequest + requestWait). Both the IN and OUT
+ * UsbRequests are always queued; requestWait returns whichever completes first, so an in-flight
+ * response is never lost even though a write completes as soon as the report hits the bus.
+ *
+ * <p>Ported (Java) from the Proton Mail fork's fido-nfc module; the request method is generalized
+ * to take the CTAP command byte so makeCredential (0x01) works beside getAssertion (0x02).
+ */
+public class UsbCtap2Transport {
+
+  static final String TAG = "GeckoCtap2Usb";
+
+  // CTAPHID commands (spec 8.1.9).
+  private static final byte CMD_CBOR = (byte) 0x10;
+  private static final byte CMD_INIT = (byte) 0x06;
+  private static final byte CMD_KEEPALIVE = (byte) 0x3B;
+  private static final byte CMD_ERROR = (byte) 0x3F;
+
+  private static final int BROADCAST_CID = -1; // 0xFFFFFFFF
+  private static final int CAPABILITY_CBOR = 0x04;
+
+  private static final int USB_CLASS_HID = 0x03;
+  // YubiKey interface layout: 0 = keyboard (HID boot), 1 = CTAP HID.
+  private static final int HID_INTERFACE_ID = 1;
+
+  private static final int REPORT_SIZE_DEFAULT = 64;
+  private static final int MIN_REPORT_SIZE = 8;
+
+  private static final int NONCE_SIZE = 8;
+  // INIT response (spec 8.1.9.1.3): nonce(8) cid(4) protVer(1) devVer(3) caps(1).
+  private static final int INIT_RESPONSE_SIZE = 17;
+
+  private static final long WAIT_TIMEOUT_MS = 1000L;
+  private static final long PACKET_TIMEOUT_MS = 30_000L;
+
+  private UsbDeviceConnection mConnection;
+  private UsbRequest mInRequest;
+  private UsbRequest mOutRequest;
+  private int mChannel = -1;
+  private int mReportSize = REPORT_SIZE_DEFAULT;
+  private final ByteBuffer mInBuffer = ByteBuffer.allocateDirect(REPORT_SIZE_DEFAULT);
+  private final ByteBuffer mOutBuffer = ByteBuffer.allocateDirect(REPORT_SIZE_DEFAULT);
+
+  /**
+   * Binds the CTAPHID interface of {@code device}. Returns false when the device has no HID
+   * interface with both an IN and an OUT endpoint (the CTAPHID pair, spec 8.1.8.1) or the
+   * interface cannot be claimed.
+   */
+  public boolean bindDevice(final UsbDevice device, final UsbManager usb) {
+    UsbInterface intf = null;
+    for (int i = 0; i < device.getInterfaceCount(); i++) {
+      if (device.getInterface(i).getId() == HID_INTERFACE_ID) {
+        intf = device.getInterface(i);
+        break;
+      }
+    }
+    if (intf == null) {
+      for (int i = 0; i < device.getInterfaceCount(); i++) {
+        if (device.getInterface(i).getInterfaceClass() == USB_CLASS_HID) {
+          intf = device.getInterface(i);
+          break;
+        }
+      }
+    }
+    if (intf == null) {
+      return false;
+    }
+    UsbEndpoint out = null;
+    UsbEndpoint inp = null;
+    for (int i = 0; i < intf.getEndpointCount(); i++) {
+      final UsbEndpoint ep = intf.getEndpoint(i);
+      if (ep.getDirection() == UsbConstants.USB_DIR_OUT) {
+        out = ep;
+      } else if (ep.getDirection() == UsbConstants.USB_DIR_IN) {
+        inp = ep;
+      }
+    }
+    if (out == null || inp == null) {
+      return false;
+    }
+    mReportSize = Math.max(inp.getMaxPacketSize(), MIN_REPORT_SIZE);
+    try {
+      final UsbDeviceConnection conn = usb.openDevice(device);
+      if (conn == null) {
+        return false;
+      }
+      if (!conn.claimInterface(intf, true)) {
+        conn.close();
+        return false;
+      }
+      mConnection = conn;
+      mInRequest = new UsbRequest();
+      mInRequest.initialize(conn, inp);
+      mOutRequest = new UsbRequest();
+      mOutRequest.initialize(conn, out);
+      return true;
+    } catch (final Exception e) {
+      Log.e(TAG, "bindDevice failed", e);
+      release();
+      return false;
+    }
+  }
+
+  public void release() {
+    try {
+      if (mInRequest != null) {
+        mInRequest.cancel();
+        mInRequest.close();
+      }
+      if (mOutRequest != null) {
+        mOutRequest.cancel();
+        mOutRequest.close();
+      }
+    } catch (final Exception e) {
+      // best-effort
+    }
+    try {
+      if (mConnection != null) {
+        mConnection.close();
+      }
+    } catch (final Exception e) {
+      // best-effort
+    }
+    mInRequest = null;
+    mOutRequest = null;
+    mConnection = null;
+    mChannel = -1;
+  }
+
+  /**
+   * Allocates a CTAPHID channel via INIT on the broadcast CID. Returns true on success; the
+   * response must echo the request nonce (guards against a stale broadcast response from another
+   * client).
+   */
+  public boolean initialize() {
+    final byte[] nonce = new byte[NONCE_SIZE];
+    new SecureRandom().nextBytes(nonce);
+    final ByteBuffer packet = newOutPacket();
+    packet.putInt(BROADCAST_CID);
+    packet.put(CMD_INIT);
+    putBcnt(packet, nonce.length);
+    packet.put(nonce);
+
+    final byte[] resp = transact(packet, CMD_INIT, BROADCAST_CID);
+    if (resp == null || resp.length < INIT_RESPONSE_SIZE) {
+      return false;
+    }
+    for (int i = 0; i < NONCE_SIZE; i++) {
+      if (resp[i] != nonce[i]) {
+        return false;
+      }
+    }
+    mChannel =
+        ((resp[NONCE_SIZE] & 0xFF) << 24)
+            | ((resp[NONCE_SIZE + 1] & 0xFF) << 16)
+            | ((resp[NONCE_SIZE + 2] & 0xFF) << 8)
+            | (resp[NONCE_SIZE + 3] & 0xFF);
+    final int caps = resp[NONCE_SIZE + 8] & 0xFF;
+    if ((caps & CAPABILITY_CBOR) == 0) {
+      Log.w(TAG, "device reports no CTAPHID_CBOR capability (caps=0x" + Integer.toHexString(caps) + ")");
+    }
+    return true;
+  }
+
+  /**
+   * Runs one CTAP2 command ({@link Ctap2Session#CTAP_MAKE_CREDENTIAL} or {@link
+   * Ctap2Session#CTAP_GET_ASSERTION}) on the allocated channel. Returns the CBOR response body
+   * when the CTAP status is 0x00; otherwise throws {@link Ctap2Error} with the CTAP status code.
+   */
+  public byte[] sendCtapCommand(final int ctapCmd, final byte[] cborPayload) {
+    if (mChannel < 0) {
+      throw new Ctap2Error("USB channel not initialized");
+    }
+    final byte[] data = new byte[cborPayload.length + 1];
+    data[0] = (byte) ctapCmd;
+    System.arraycopy(cborPayload, 0, data, 1, cborPayload.length);
+    final byte[] resp = transactMessage(CMD_CBOR, data);
+    if (resp == null) {
+      throw new Ctap2Error("no USB response to CTAP command 0x" + Integer.toHexString(ctapCmd));
+    }
+    if (resp.length == 0) {
+      throw new Ctap2Error("empty USB response");
+    }
+    final int ctapStatus = resp[0];
+    final byte[] body = new byte[resp.length - 1];
+    System.arraycopy(resp, 1, body, 0, body.length);
+    if (ctapStatus != 0x00) {
+      throw new Ctap2Error(
+          "CTAP command 0x"
+              + Integer.toHexString(ctapCmd)
+              + " failed, status 0x"
+              + Integer.toHexString(ctapStatus & 0xFF).toUpperCase(),
+          ctapStatus,
+          null);
+    }
+    return body;
+  }
+
+  /**
+   * Sends one CTAPHID message (command {@code cmd}, payload {@code data}; spans continuation
+   * packets when the payload exceeds one report) and returns the full response payload.
+   * Keep-alive packets are skipped; a CTAPHID_ERROR throws {@link Ctap2Error}.
+   */
+  private byte[] transactMessage(final byte cmd, final byte[] data) {
+    final int total = data.length;
+    final int perPacket = mReportSize - 7;
+    int offset = 0;
+    int packetIndex = 0;
+    while (true) {
+      final int chunk = Math.min(perPacket, total - offset);
+      final ByteBuffer packet = newOutPacket();
+      packet.putInt(mChannel);
+      if (packetIndex == 0) {
+        packet.put(cmd);
+        putBcnt(packet, total);
+      } else {
+        packet.put((byte) packetIndex); // SEQ, 0-based continuation index
+      }
+      if (chunk > 0) {
+        packet.put(data, offset, chunk);
+      }
+      if (!sendOut(packet)) {
+        return null;
+      }
+      offset += chunk;
+      packetIndex++;
+      if (offset >= total) {
+        break;
+      }
+    }
+
+    final ByteArrayOutputStream body = new ByteArrayOutputStream();
+    while (true) {
+      final ByteBuffer resp = waitForIn();
+      if (resp == null) {
+        return null;
+      }
+      final byte cmdByte = resp.get(4);
+      final int len = bcntOf(resp);
+      if (cmdByte == CMD_KEEPALIVE) {
+        continue; // processing / user-presence indicator
+      }
+      if (cmdByte == CMD_ERROR) {
+        final int code = len >= 1 ? resp.get(5) & 0xFF : -1;
+        throw new Ctap2Error("USB CTAPHID error 0x" + Integer.toHexString(code).toUpperCase());
+      }
+      if (cidOf(resp) != mChannel) {
+        continue;
+      }
+      if (len < 1) {
+        return null;
+      }
+      final int take = Math.min(len, resp.remaining() - 5);
+      final byte[] bytes = new byte[take];
+      resp.position(5);
+      resp.get(bytes);
+      resp.position(0);
+      body.write(bytes, 0, bytes.length);
+      return body.toByteArray();
+    }
+  }
+
+  /**
+   * Sends {@code packet} and returns the payload of the next non-keepalive response matching
+   * {@code expectedCmd} on {@code expectedCid}, or null on failure. Used for INIT.
+   */
+  private byte[] transact(final ByteBuffer packet, final byte expectedCmd, final int expectedCid) {
+    if (!sendOut(packet)) {
+      return null;
+    }
+    while (true) {
+      final ByteBuffer resp = waitForIn();
+      if (resp == null) {
+        return null;
+      }
+      final byte cmdByte = resp.get(4);
+      final int len = bcntOf(resp);
+      if (cmdByte == CMD_KEEPALIVE) {
+        continue;
+      }
+      if (cmdByte == CMD_ERROR) {
+        final int code = len >= 1 ? resp.get(5) & 0xFF : -1;
+        throw new Ctap2Error("USB CTAPHID error 0x" + Integer.toHexString(code).toUpperCase());
+      }
+      if (cmdByte != expectedCmd || cidOf(resp) != expectedCid) {
+        continue;
+      }
+      if (len < 1) {
+        return null;
+      }
+      final int take = Math.min(len, resp.remaining() - 5);
+      final byte[] out = new byte[take];
+      for (int i = 0; i < take; i++) {
+        out[i] = resp.get(5 + i);
+      }
+      return out;
+    }
+  }
+
+  /** Queues the OUT request; the write completes once the report hits the bus. */
+  private boolean sendOut(final ByteBuffer packet) {
+    if (mOutRequest == null || mConnection == null) {
+      return false;
+    }
+    // Spec 8.1.4: unused bytes of the fixed-size report SHOULD be zero.
+    while (packet.hasRemaining()) {
+      packet.put((byte) 0);
+    }
+    packet.rewind();
+    try {
+      mOutRequest.queue(packet, mReportSize);
+    } catch (final Exception e) {
+      Log.e(TAG, "queue out failed", e);
+      return false;
+    }
+    while (true) {
+      final UsbRequest got = waitRequest(WAIT_TIMEOUT_MS);
+      if (got == null) {
+        return false;
+      }
+      if (got == mOutRequest) {
+        return true;
+      }
+      if (got == mInRequest) {
+        mInBuffer.rewind(); // response already arrived; kept for waitForIn
+      }
+    }
+  }
+
+  /**
+   * Queues the IN request and waits until one full report is received. Returns the buffer (rewound)
+   * or null on timeout/failure.
+   */
+  private ByteBuffer waitForIn() {
+    if (mInRequest == null || mConnection == null) {
+      return null;
+    }
+    mInBuffer.clear();
+    mInBuffer.limit(mReportSize);
+    try {
+      mInRequest.queue(mInBuffer, mReportSize);
+    } catch (final Exception e) {
+      Log.e(TAG, "queue in failed", e);
+      return null;
+    }
+    while (true) {
+      final UsbRequest got = waitRequest(PACKET_TIMEOUT_MS);
+      if (got == null) {
+        return null;
+      }
+      if (got == mInRequest) {
+        mInBuffer.rewind();
+        return mInBuffer;
+      }
+      // got == mOutRequest: a write finished; the IN packet is still due
+    }
+  }
+
+  private UsbRequest waitRequest(final long timeoutMs) {
+    if (mConnection == null) {
+      return null;
+    }
+    try {
+      return mConnection.requestWait(timeoutMs);
+    } catch (final Exception e) {
+      Log.e(TAG, "requestWait failed", e);
+      return null;
+    }
+  }
+
+  private ByteBuffer newOutPacket() {
+    mOutBuffer.clear();
+    mOutBuffer.limit(mReportSize);
+    mOutBuffer.order(ByteOrder.BIG_ENDIAN);
+    return mOutBuffer;
+  }
+
+  private static int cidOf(final ByteBuffer p) {
+    p.mark();
+    final int cid = p.getInt();
+    p.reset();
+    return cid;
+  }
+
+  /** BCNT field (bytes 5..6, big-endian) of a CTAPHID packet. */
+  private static int bcntOf(final ByteBuffer p) {
+    p.mark();
+    p.position(5);
+    final int hi = p.get() & 0xFF;
+    final int lo = p.get() & 0xFF;
+    p.reset();
+    return (hi << 8) | lo;
+  }
+
+  private static void putBcnt(final ByteBuffer p, final int len) {
+    p.put((byte) (len >> 8));
+    p.put((byte) (len & 0xFF));
+  }
+}
