+++ b/mobile/android/geckoview/src/test/java/org/mozilla/gecko/ctap2/UsbCtap2RankingTest.java
@@ -0,0 +1,124 @@
+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package org.mozilla.gecko.ctap2;
+
+import static org.junit.Assert.assertArrayEquals;
+
+import java.util.Arrays;
+import org.junit.Test;
+
+/**
+ * Regression tests for {@link UsbCtap2Transport#rankCandidates}: the 2026-09-30 field failure
+ * was a hardcoded CTAP interface position (interface 1 on a YubiKey layout where 1 is the CCID
+ * smart-card interface) — the CTAP INIT was sent to the keyboard interface and timed out after
+ * 30 s. The ranking must therefore select by the layout-independent markers (HID class, IN+OUT
+ * pair, CTAP protocol 0x21, report size) and never by position. Pure JVM — no Android.
+ */
+public class UsbCtap2RankingTest {
+  private static final int CLASS_HID = 0x03;
+  private static final int CLASS_SMART_CARD = 0x0B; // CCID
+  private static final int CLASS_VENDOR = 0xFF;
+  private static final int PROTO_CTAP = 0x21;
+  private static final int PROTO_KEYBOARD = 0x01;
+
+  private static UsbCtap2Transport.HidInterfaceInfo info(
+      int cls, int proto, boolean in, boolean out, int report) {
+    return new UsbCtap2Transport.HidInterfaceInfo() {
+      @Override
+      public int interfaceClass() {
+        return cls;
+      }
+
+      @Override
+      public int interfaceProtocol() {
+        return proto;
+      }
+
+      @Override
+      public boolean hasInEndpoint() {
+        return in;
+      }
+
+      @Override
+      public boolean hasOutEndpoint() {
+        return out;
+      }
+
+      @Override
+      public int inReportSize() {
+        return report;
+      }
+    };
+  }
+
+  /** YubiKey 5-style layout: 0 = keyboard, 1 = CCID smart-card, 2 = CTAP. */
+  @Test
+  public void yubiKey5Layout_ctapFirstDespiteHighestIndex() {
+    assertArrayEquals(
+        new int[] {2, 0},
+        UsbCtap2Transport.rankCandidates(
+            Arrays.asList(
+                info(CLASS_HID, PROTO_KEYBOARD, true, true, 64),
+                info(CLASS_SMART_CARD, 0x00, true, true, 16),
+                info(CLASS_HID, PROTO_CTAP, true, true, 64))));
+  }
+
+  /** Keyboard listed before CTAP: protocol still wins over descriptor order. */
+  @Test
+  public void keyboardBeforeCtap_stillPicksCtapFirst() {
+    assertArrayEquals(
+        new int[] {0, 1},
+        UsbCtap2Transport.rankCandidates(
+            Arrays.asList(
+                info(CLASS_HID, PROTO_CTAP, true, true, 64),
+                info(CLASS_HID, PROTO_KEYBOARD, true, true, 64))));
+  }
+
+  /** An interface missing the OUT endpoint is not a CTAPHID pair (spec 8.1.8.1) — excluded. */
+  @Test
+  public void outEndpointMissing_excluded() {
+    assertArrayEquals(
+        new int[] {0},
+        UsbCtap2Transport.rankCandidates(
+            Arrays.asList(
+                info(CLASS_HID, PROTO_CTAP, true, true, 64),
+                info(CLASS_HID, PROTO_KEYBOARD, true, false, 64))));
+  }
+
+  /** Non-HID classes (CCID smart-card, vendor-defined) never qualify. */
+  @Test
+  public void nonHidClasses_excluded() {
+    assertArrayEquals(
+        new int[] {2},
+        UsbCtap2Transport.rankCandidates(
+            Arrays.asList(
+                info(CLASS_SMART_CARD, 0x00, true, true, 16),
+                info(CLASS_VENDOR, 0x00, true, true, 64),
+                info(CLASS_HID, PROTO_CTAP, true, true, 64))));
+  }
+
+  /** No CTAP-protocol marker anywhere: full-speed report 64 ranks first among the rest. */
+  @Test
+  public void noCtapProtocol_reportSizeBreaksTie() {
+    assertArrayEquals(
+        new int[] {1, 0},
+        UsbCtap2Transport.rankCandidates(
+            Arrays.asList(
+                info(CLASS_HID, PROTO_KEYBOARD, true, true, 8),
+                info(CLASS_HID, PROTO_KEYBOARD, true, true, 64))));
+  }
+
+  /** Nothing qualifies: empty, caller treats as "no interface" without NPE. */
+  @Test
+  public void nothingQualifies_emptyResult() {
+    assertArrayEquals(
+        new int[] {},
+        UsbCtap2Transport.rankCandidates(
+            Arrays.asList(
+                info(CLASS_SMART_CARD, 0x00, true, true, 16),
+                info(CLASS_HID, PROTO_KEYBOARD, false, false, 64))));
+  }
+}
