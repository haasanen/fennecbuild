index 0000000000..5b027ad620
--- /dev/null
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/gecko/ctap2/NfcCtap2Transport.java
@@ -0,0 +1,287 @@
+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+import android.app.Activity;
+import android.nfc.NfcAdapter;
+import android.nfc.Tag;
+import android.nfc.tech.IsoDep;
+import android.util.Log;
+import java.io.ByteArrayOutputStream;
+
+/**
+ * CTAP2 over NFC (ISO 14443-4 / IsoDep) transport, per CTAP2 spec section 8.2.
+ *
+ * <p>Framing (spec 8.2.4):
+ *
+ * <ul>
+ *   <li>applet select: 00 A4 04 00 Lc &lt;AID&gt;. Success SW 9000.
+ *   <li>command: 80 10 00 00 Lc &lt;CTAP command byte || CBOR&gt; Le. The data field is the single
+ *       CTAP command byte followed by the CBOR parameters.
+ *   <li>response: SW 9000 + data, where data = CTAP status byte (1) || CBOR. 91 00 = status
+ *       update, 61 xx = xx more bytes; both are followed with a GETRESPONSE.
+ *   <li>GETRESPONSE: 80 C0 00 00 [Le]. INS 0xC0 per the spec's normative trace.
+ * </ul>
+ *
+ * <p>Ported (Java) from the Proton Mail fork's fido-nfc module; the request method is generalized
+ * to take the CTAP command byte so makeCredential (0x01) works beside getAssertion (0x02).
+ */
+public class NfcCtap2Transport {
+
+  static final String TAG = "GeckoCtap2Nfc";
+
+  private static final int TIMEOUT_MS = 5000;
+  private static final int CONNECT_RETRIES = 3;
+  private static final int MAX_SHORT_DATA = 255;
+  private static final byte INS_GETRESPONSE = (byte) 0xC0;
+
+  // FIDO2 AID: RID A0 00 00 06 47, PIX 2F 00 01.
+  private static final byte[] AID =
+      new byte[] {(byte) 0xA0, 0x00, 0x00, 0x06, 0x47, 0x2F, 0x00, 0x01};
+
+  private IsoDep mIsoDep;
+
+  /**
+   * Binds {@code tag}. Returns false if the tag does not support IsoDep or connect fails.
+   * The first connect attempt on many phones transiently fails right after tag detection
+   * (the NFCC is still settling the route); retry a few times before giving up.
+   */
+  public boolean bindTag(final Tag tag) {
+    final IsoDep dep = IsoDep.get(tag);
+    if (dep == null) {
+      return false;
+    }
+    for (int attempt = 0; attempt < CONNECT_RETRIES; attempt++) {
+      try {
+        dep.connect();
+        mIsoDep = dep;
+        return true;
+      } catch (final Exception e) {
+        try {
+          Thread.sleep(100L);
+        } catch (final InterruptedException ie) {
+          Thread.currentThread().interrupt();
+          return false;
+        }
+      }
+    }
+    return false;
+  }
+
+  public void release() {
+    try {
+      if (mIsoDep != null) {
+        mIsoDep.close();
+      }
+    } catch (final Exception e) {
+      // best-effort
+    }
+    mIsoDep = null;
+  }
+
+  /** FIDO2 applet select (spec 8.2.3). Returns true when the applet is present. */
+  public boolean selectFidoApplet() {
+    final IsoDep dep = mIsoDep;
+    if (dep == null) {
+      return false;
+    }
+    try {
+      final byte[] apdu = new byte[5 + AID.length];
+      apdu[0] = 0x00;
+      apdu[1] = (byte) 0xA4;
+      apdu[2] = 0x04;
+      apdu[3] = 0x00;
+      apdu[4] = (byte) AID.length;
+      System.arraycopy(AID, 0, apdu, 5, AID.length);
+      final byte[] resp = transceive(dep, apdu);
+      final int sw = statusWord(resp);
+      return sw == 0x9000 || (sw >> 8) == 0x61;
+    } catch (final Exception e) {
+      return false;
+    }
+  }
+
+  /**
+   * Runs one CTAP2 command ({@link Ctap2Session#CTAP_MAKE_CREDENTIAL} or {@link
+   * Ctap2Session#CTAP_GET_ASSERTION}). Returns the CBOR response body when the CTAP status is
+   * 0x00; otherwise throws {@link Ctap2Error} with the CTAP status code.
+   */
+  public byte[] sendCtapCommand(final int ctapCmd, final byte[] cborPayload) {
+    final IsoDep dep = mIsoDep;
+    if (dep == null) {
+      throw new Ctap2Error("NFC transport not bound");
+    }
+    // Spec 8.2.4.1: data field = CTAP command byte || CBOR parameters.
+    final byte[] data = new byte[cborPayload.length + 1];
+    data[0] = (byte) ctapCmd;
+    System.arraycopy(cborPayload, 0, data, 1, cborPayload.length);
+    if (data.length > MAX_SHORT_DATA) {
+      throw new Ctap2Error(
+          "CTAP request too large for short APDU: " + data.length);
+    }
+    // Single short (case-4) APDU: 80 10 00 00 Lc <cmd || CBOR> Le=00.
+    final byte[] apdu = new byte[5 + data.length + 1];
+    apdu[0] = (byte) 0x80;
+    apdu[1] = 0x10;
+    apdu[2] = 0x00;
+    apdu[3] = 0x00;
+    apdu[4] = (byte) data.length;
+    System.arraycopy(data, 0, apdu, 5, data.length);
+    apdu[5 + data.length] = 0x00;
+    final byte[] raw = unwrapResponse(transceive(dep, apdu), dep);
+    if (raw.length == 0) {
+      throw new Ctap2Error("empty NFC response");
+    }
+    final int ctapStatus = raw[0];
+    final byte[] body = new byte[raw.length - 1];
+    System.arraycopy(raw, 1, body, 0, body.length);
+    if (ctapStatus != 0x00) {
+      throw new Ctap2Error(
+          "CTAP command 0x"
+              + Integer.toHexString(ctapCmd)
+              + " failed, status 0x"
+              + Integer.toHexString(ctapStatus & 0xFF).toUpperCase()
+              + " "
+              + Ctap2Error.describe(ctapStatus),
+          ctapStatus,
+          null);
+    }
+    return body;
+  }
+
+  /**
+   * Unwraps the ISO 7816 layer: strips status words, follows 9100 (status update) and 61xx (xx
+   * trailing bytes) chains via GETRESPONSE. Returns the application data, i.e. CTAP status byte ||
+   * CBOR. The attestation object of a makeCredential response routinely exceeds 255 bytes, so the
+   * chain is not optional.
+   */
+  private byte[] unwrapResponse(final byte[] first, final IsoDep dep) {
+    final ByteArrayOutputStream out = new ByteArrayOutputStream();
+    byte[] resp = first;
+    int sw = statusWord(resp);
+    while (true) {
+      if (sw == 0x9000) {
+        out.write(bodyOf(resp), 0, bodyOf(resp).length);
+        return out.toByteArray();
+      } else if (sw == 0x9100) {
+        // Status update — poll for data.
+        resp = getResponse(dep, 0);
+        sw = statusWord(resp);
+      } else if ((sw & 0xFF00) == 0x6100) {
+        // xx trailing bytes available; request exactly that many.
+        final byte[] b = bodyOf(resp);
+        out.write(b, 0, b.length);
+        resp = getResponse(dep, sw & 0xFF);
+        sw = statusWord(resp);
+      } else {
+        throw new Ctap2Error(
+            "NFC rejected, SW 0x" + Integer.toHexString(sw).toUpperCase());
+      }
+    }
+  }
+
+  /**
+   * GETRESPONSE (INS 0xC0, per the spec's normative trace). {@code le} is the number of bytes to
+   * request; 0 = up to 256 (Le omitted / 0x00 in short form).
+   */
+  private byte[] getResponse(final IsoDep dep, final int le) {
+    final byte[] apdu =
+        le == 0
+            ? new byte[] {(byte) 0x80, INS_GETRESPONSE, 0x00, 0x00}
+            : new byte[] {(byte) 0x80, INS_GETRESPONSE, 0x00, 0x00, (byte) le};
+    return transceive(dep, apdu);
+  }
+
+  private byte[] transceive(final IsoDep dep, final byte[] apdu) {
+    dep.setTimeout(TIMEOUT_MS);
+    try {
+      return dep.transceive(apdu);
+    } catch (final Exception e) {
+      Log.e(TAG, "transceive failed req=[" + toHex(apdu) + "]", e);
+      throw new Ctap2Error("NFC transceive failed: " + e.getMessage(), 0, e);
+    }
+  }
+
+  private static byte[] bodyOf(final byte[] resp) {
+    if (resp.length <= 2) {
+      return new byte[0];
+    }
+    final byte[] body = new byte[resp.length - 2];
+    System.arraycopy(resp, 0, body, 0, body.length);
+    return body;
+  }
+
+  private static String toHex(final byte[] data) {
+    final StringBuilder sb = new StringBuilder();
+    for (final byte b : data) {
+      if (sb.length() > 0) {
+        sb.append(' ');
+      }
+      sb.append(String.format("%02X", b & 0xFF));
+    }
+    return sb.toString();
+  }
+
+  private static int statusWord(final byte[] resp) {
+    if (resp.length < 2) {
+      return -1;
+    }
+    return ((resp[resp.length - 2] & 0xFF) << 8) | (resp[resp.length - 1] & 0xFF);
+  }
+
+  /**
+   * Holds the host activity in NFC reader mode for the duration of a key tap; every
+   * IsoDep-capable tag is forwarded to the listener. Ending the activity tears the reader down
+   * (Android disables reader mode with the activity).
+   */
+  public static class NfcReader {
+
+    /** Receives every IsoDep-capable tag tapped while the reader is armed. */
+    public interface TagListener {
+      void onTag(Tag tag);
+    }
+
+    private final TagListener mListener;
+
+    public NfcReader(final TagListener listener) {
+      mListener = listener;
+    }
+
+    public boolean start(final Activity activity) {
+      final NfcAdapter adapter = NfcAdapter.getDefaultAdapter(activity);
+      if (adapter == null || !adapter.isEnabled()) {
+        return false;
+      }
+      try {
+        adapter.enableReaderMode(
+            activity,
+            tag -> mListener.onTag(tag),
+            NfcAdapter.FLAG_READER_NFC_A
+                | NfcAdapter.FLAG_READER_SKIP_NDEF_CHECK
+                | NfcAdapter.FLAG_READER_NO_PLATFORM_SOUNDS,
+            null);
+      } catch (final Exception e) {
+        return false;
+      }
+      return true;
+    }
+
+    /**
+     * Disables reader mode on {@code activity}. Called when the USB transport wins the first-wins
+     * race while reader mode is armed.
+     */
+    public void stop(final Activity activity) {
+      final NfcAdapter adapter = NfcAdapter.getDefaultAdapter(activity);
+      if (adapter == null) {
+        return;
+      }
+      try {
+        adapter.disableReaderMode(activity);
+      } catch (final Exception e) {
+        // best-effort
+      }
+    }
+  }
+}
diff --git a/mobile/android/geckoview/src/main/java/org/mozilla/gecko/ctap2/PinProtocolOne.java b/mobile/android/geckoview/src/main/java/org/mozilla/gecko/ctap2/PinProtocolOne.java
new file mode 100644
index 0000000000..401b662f36
--- /dev/null
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/gecko/ctap2/PinProtocolOne.java
@@ -0,0 +1,227 @@
+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+import com.upokecenter.cbor.CBORObject;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.security.KeyFactory;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.security.MessageDigest;
+import java.security.interfaces.ECPrivateKey;
+import java.security.interfaces.ECPublicKey;
+import java.security.spec.ECGenParameterSpec;
+import java.security.spec.ECParameterSpec;
+import java.security.spec.ECPoint;
+import java.security.spec.ECPublicKeySpec;
+import java.util.Arrays;
+import javax.crypto.Cipher;
+import javax.crypto.KeyAgreement;
+import javax.crypto.Mac;
+import javax.crypto.spec.IvParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * pinUvAuthProtocol 1 (CTAP2 spec sections 5.4, 5.5.1.1, 6.5, 6.6): an ECDH P-256 shared secret,
+ * AES-256-CBC with a zero IV and zero padding, and HMAC-SHA-256 truncated to 16 bytes. The
+ * handshake rides authenticatorClientPIN (CTAP command 0x06) over an open {@link Ctap2Session}.
+ *
+ * <p>Message shapes and crypto constants mirror the production Rust client that Firefox desktop
+ * runs against these same keys (authenticator crate: client_pin.rs, crypto/mod.rs), down to
+ * omitted-optional-key encoding and the un-padded {@code SHA-256(pin)} pin hash.
+ *
+ * <p>A key with an enrolled PIN answers makeCredential/getAssertion with PIN_REQUIRED (0x36). The
+ * platform then runs {@link #obtainPinToken} and retries the operation with the 16-byte
+ * {@link #authenticate}(pinToken, clientDataHash) value in makeCredential key 8 (protocol 1 in key
+ * 9) or getAssertion key 6 (protocol 1 in key 7).
+ */
+public final class PinProtocolOne {
+  /** authenticatorClientPIN (CTAP2 spec section 5.4). */
+  public static final int CTAP_CLIENT_PIN = 0x06; // spec 5.5; 0x04 is authenticatorGetInfo
+
+  // PIN-family status codes (spec section 6.1; byte values verified against the auth-rs and
+  // CTAP-2.2 mapping tables).
+  public static final int STATUS_PIN_INVALID = 0x31;
+  public static final int STATUS_PIN_BLOCKED = 0x32;
+  public static final int STATUS_PIN_AUTH_BLOCKED = 0x34;
+  public static final int STATUS_PIN_NOT_SET = 0x35;
+  public static final int STATUS_PIN_REQUIRED = 0x36;
+  public static final int STATUS_UV_BLOCKED = 0x3C;
+
+  private static final int PIN_HASH_LEN = 16;
+  private static final int PIN_TOKEN_LEN = 16;
+  private static final int PIN_AUTH_LEN = 16;
+  private static final int AES_BLOCK = 16;
+
+  private PinProtocolOne() {}
+
+  /** Fresh ephemeral P-256 pair for one handshake (platform side, per spec 6.6.1). */
+  public static KeyPair generatePlatformKey() throws Ctap2Error {
+    try {
+      final KeyPairGenerator gen = KeyPairGenerator.getInstance("EC");
+      gen.initialize(new ECGenParameterSpec("secp256r1"));
+      return gen.generateKeyPair();
+    } catch (final Exception e) {
+      throw new Ctap2Error("no P-256 key pair available for the PIN handshake", 0, e);
+    }
+  }
+
+  /** Our COSE EC2 keyAgreement map {@code {1: 2 (EC2), -1: 1 (P-256), -2: x, -3: y}} (spec 4.2.8). */
+  static CBORObject toCoseKey(final ECPublicKey pub) {
+    final ECPoint w = pub.getW();
+    final CBORObject map = CBORObject.NewMap();
+    map.Add(CBORObject.FromObject(1), CBORObject.FromObject(2)); // kty EC2
+    map.Add(CBORObject.FromObject(-1), CBORObject.FromObject(1)); // crv P-256
+    map.Add(CBORObject.FromObject(-2), CBORObject.FromObject(fixed32(w.getAffineX())));
+    map.Add(CBORObject.FromObject(-3), CBORObject.FromObject(fixed32(w.getAffineY())));
+    return map;
+  }
+
+  /** Rebuilds the authenticator's EC public key from its keyAgreement COSE map. */
+  static ECPublicKey peerPublicKey(final CBORObject cose) throws Ctap2Error {
+    try {
+      final CBORObject x = cose.get(-2);
+      final CBORObject y = cose.get(-3);
+      if (x == null || y == null) {
+        throw new IllegalStateException("keyAgreement map missing x/y");
+      }
+      final ECParameterSpec spec = p256Spec();
+      final ECPoint point =
+          new ECPoint(new BigInteger(1, x.GetByteString()), new BigInteger(1, y.GetByteString()));
+      return (ECPublicKey) KeyFactory.getInstance("EC").generatePublic(new ECPublicKeySpec(point, spec));
+    } catch (final Ctap2Error e) {
+      throw e;
+    } catch (final Exception e) {
+      throw new Ctap2Error("malformed keyAgreement key from the security key", 0, e);
+    }
+  }
+
+  /**
+   * Shared secret = SHA-256 over the raw 32-byte ECDH x-coordinate (auth-rs ecdhe_p256_raw +
+   * Sha256 parity; JDK and Android KeyAgreement both return the raw x).
+   */
+  static byte[] sharedSecret(final ECPrivateKey ourPrivate, final ECPublicKey peer)
+      throws Ctap2Error {
+    try {
+      final KeyAgreement ka = KeyAgreement.getInstance("ECDH");
+      ka.init(ourPrivate);
+      ka.doPhase(peer, true);
+      final byte[] raw = ka.generateSecret();
+      if (raw.length != 32) {
+        // Defensive: a provider that hands back an encoded point instead of the raw coordinate.
+        throw new IllegalStateException("ECDH returned " + raw.length + " bytes, expected raw x (32)");
+      }
+      return sha256(raw);
+    } catch (final Exception e) {
+      throw new Ctap2Error("PIN key agreement failed", 0, e);
+    }
+  }
+
+  /**
+   * Runs GetKeyAgreement then GetPinToken on an open session and returns the 16-byte pinToken.
+   * The PIN travels only as pinHashEnc (AES-CBC of the pin hash), never in the clear.
+   *
+   * @throws Ctap2Error with status {@link #STATUS_PIN_INVALID} for a wrong PIN and the matching
+   *     code for blocked/unset PIN states, so the caller can re-prompt or fail cleanly.
+   */
+  public static byte[] obtainPinToken(final Ctap2Session session, final String pin)
+      throws Ctap2Error {
+    final KeyPair pair = generatePlatformKey();
+    final byte[] kaResp = session.send(CTAP_CLIENT_PIN, Ctap2Cbor.encodeClientPinGetKeyAgreement());
+    final ECPublicKey peerKey = peerPublicKey(Ctap2Cbor.decodeClientPinKeyAgreement(kaResp));
+    final byte[] secret = sharedSecret((ECPrivateKey) pair.getPrivate(), peerKey);
+    final byte[] pinHashEnc = aesCbc(secret, pinHash(pin), true);
+    final byte[] tokenResp =
+        session.send(
+            CTAP_CLIENT_PIN,
+            Ctap2Cbor.encodeClientPinGetPinToken(
+                toCoseKey((ECPublicKey) pair.getPublic()), pinHashEnc));
+    final byte[] decrypted = aesCbc(secret, Ctap2Cbor.decodeClientPinPinTokenEnc(tokenResp), false);
+    final byte[] token = stripTrailingZeros(decrypted);
+    if (token.length < PIN_TOKEN_LEN) {
+      throw new Ctap2Error("the security key returned a short pinToken");
+    }
+    return Arrays.copyOf(token, PIN_TOKEN_LEN);
+  }
+
+  /** Pin hash: first 16 bytes of SHA-256 over the UTF-8 PIN bytes (auth-rs for_pin_token parity). */
+  public static byte[] pinHash(final String pin) {
+    return Arrays.copyOf(sha256(pin.getBytes(StandardCharsets.UTF_8)), PIN_HASH_LEN);
+  }
+
+  /** pinUvAuthParam / pinAuth: first 16 bytes of HMAC-SHA-256(key, message) (spec 6.5.1). */
+  public static byte[] authenticate(final byte[] key, final byte[] message) throws Ctap2Error {
+    try {
+      final Mac mac = Mac.getInstance("HmacSHA256");
+      mac.init(new SecretKeySpec(key, "HmacSHA256"));
+      return Arrays.copyOf(mac.doFinal(message), PIN_AUTH_LEN);
+    } catch (final Exception e) {
+      throw new Ctap2Error("PIN authentication failed", 0, e);
+    }
+  }
+
+  /** AES-256-CBC with zero IV; encrypt zero-pads to a block multiple (spec 6.5), decrypt keeps
+   * raw output for {@link #stripTrailingZeros}. */
+  static byte[] aesCbc(final byte[] key32, final byte[] data, final boolean encrypt)
+      throws Ctap2Error {
+    return aesCbc(key32, new byte[AES_BLOCK], data, encrypt);
+  }
+
+  static byte[] aesCbc(
+      final byte[] key32, final byte[] iv16, final byte[] data, final boolean encrypt)
+      throws Ctap2Error {
+    try {
+      final Cipher cipher = Cipher.getInstance("AES/CBC/NoPadding");
+      cipher.init(
+          encrypt ? Cipher.ENCRYPT_MODE : Cipher.DECRYPT_MODE,
+          new SecretKeySpec(key32, "AES"),
+          new IvParameterSpec(iv16));
+      if (!encrypt) {
+        return cipher.doFinal(data);
+      }
+      final int rem = data.length % AES_BLOCK;
+      final byte[] padded = rem == 0 ? data : Arrays.copyOf(data, data.length + AES_BLOCK - rem);
+      return cipher.doFinal(padded);
+    } catch (final Exception e) {
+      throw new Ctap2Error("AES-CBC PIN transport failed", 0, e);
+    }
+  }
+
+  static byte[] stripTrailingZeros(final byte[] in) {
+    int end = in.length;
+    while (end > 0 && in[end - 1] == 0) {
+      end--;
+    }
+    return Arrays.copyOf(in, end);
+  }
+
+  private static ECParameterSpec p256Spec() throws Ctap2Error {
+    // Pull the curve spec off a generated key instead of hard-coding p/a/b/G/n literals.
+    return ((ECPublicKey) generatePlatformKey().getPublic()).getParams();
+  }
+
+  private static byte[] fixed32(final BigInteger v) {
+    final byte[] raw = v.toByteArray();
+    if (raw.length == 32) {
+      return raw;
+    }
+    final byte[] out = new byte[32];
+    if (raw.length > 32) { // leading sign zero
+      System.arraycopy(raw, raw.length - 32, out, 0, 32);
+    } else {
+      System.arraycopy(raw, 0, out, 32 - raw.length, raw.length);
+    }
+    return out;
+  }
+
+  private static byte[] sha256(final byte[] in) {
+    try {
+      return MessageDigest.getInstance("SHA-256").digest(in);
+    } catch (final Exception e) {
+      throw new Ctap2Error("SHA-256 unavailable", 0, e);
+    }
+  }
+}
