+   *
+   * @param clientDataHash SHA-256 of the request's clientDataJSON, as computed by Gecko
+   */
+  public static GeckoResult<WebAuthnUtils.GetAssertionResponse> getAssertion(
+      final String rpId,
+      final byte[] clientDataHash,
+      final List<Ctap2Cbor.CredentialId> allowList,
+      final String appId,
