@@ -0,0 +1,160 @@
+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import com.upokecenter.cbor.CBORObject;
+import java.util.Map;
+import org.junit.Test;
+
+/**
+ * The capability seam: options sent to a key must come from the key's own authenticatorGetInfo
+ * report, never from a guess. Scripted-key tests (the fake key composes and answers the GetInfo
+ * map itself) plus the request-shape assertions pin spec sections 5.1/5.2/5.4 behaviour.
+ */
+public class WebAuthnCtap2KeyInfoTest {
+
+  /** Scripted key: answers authenticatorGetInfo (and only that) with the canned CBOR body. */
+  private static final class InfoSession implements Ctap2Session {
+    private final byte[] mInfoBody;
+    int mLastCmd = -1;
+    byte[] mLastPayload;
+
+    InfoSession(final byte[] infoBody) {
+      mInfoBody = infoBody;
+    }
+
+    @Override
+    public boolean prepare() {
+      return true;
+    }
+
+    @Override
+    public byte[] send(final int ctapCmd, final byte[] cborPayload) {
+      mLastCmd = ctapCmd;
+      mLastPayload = cborPayload;
+      if (ctapCmd == CTAP_GET_INFO) {
+        assertArrayEquals("GetInfo request is the empty CBOR map", CBOR_EMPTY_MAP, cborPayload);
+        return mInfoBody;
+      }
+      throw new Ctap2Error("scripted key: unexpected command 0x" + Integer.toHexString(ctapCmd));
+    }
+
+    @Override
+    public void close() {}
+  }
+
+  /**
+   * Builds a key-side GetInfo body. Shape from the CTAP 2.0 spec section 5.4 response table
+   * (1=versions, 2=extensions, 4=options, 5=pinUvAuthProtocols); the readable sample map
+   * {1:["FIDO_2_0"], 2:["hmac-secret"], ...} printed in the spec pins versions/extensions.
+   */
+  private static byte[] infoBody(final boolean rk, final boolean uv, final boolean pinProtocols) {
+    final CBORObject info = CBORObject.NewMap();
+    info.set(CBORObject.FromObject(1), CBORObject.NewArray().Add("FIDO_2_0").Add("U2F_V2"));
+    info.set(CBORObject.FromObject(2), CBORObject.NewArray().Add("hmac-secret"));
+    final CBORObject options = CBORObject.NewMap();
+    options.set(CBORObject.FromObject("rk"), CBORObject.FromObject(rk));
+    options.set(CBORObject.FromObject("up"), CBORObject.FromObject(true));
+    options.set(CBORObject.FromObject("uv"), CBORObject.FromObject(uv));
+    info.set(CBORObject.FromObject(4), options);
+    if (pinProtocols) {
+      info.set(CBORObject.FromObject(5), CBORObject.NewArray().Add(1));
+    }
+    return info.EncodeToBytes();
+  }
+
+  @Test
+  public void fetchKeyInfo_parsesDeclaredCapabilities() {
+    final WebAuthnCtap2.KeyInfo info =
+        WebAuthnCtap2.fetchKeyInfo(new InfoSession(infoBody(true, false, true)));
+    assertTrue(info.versions.contains("FIDO_2_0"));
+    assertEquals(1, info.pinUvAuthProtocols.size());
+    assertEquals(Integer.valueOf(1), info.pinUvAuthProtocols.get(0));
+    assertTrue(info.declaredOptions.contains("rk"));
+    assertTrue(info.declaredOptions.contains("up"));
+    assertFalse("an option declared FALSE is not a declared option",
+        info.declaredOptions.contains("uv"));
+  }
+
+  @Test
+  public void fetchKeyInfo_unusableResponseThrows() {
+    try {
+      WebAuthnCtap2.fetchKeyInfo(new InfoSession(CBORObject.NewMap().Add(2, "x").EncodeToBytes()));
+      fail("expected Ctap2Error");
+    } catch (final Ctap2Error e) {
+      assertTrue(e.getMessage().contains("authenticatorGetInfo"));
+    }
+  }
+
+  @Test
+  public void makeCredentialOptions_sendsOnlyRequestedAndDeclared() {
+    final WebAuthnCtap2.KeyInfo both =
+        WebAuthnCtap2.fetchKeyInfo(new InfoSession(infoBody(true, true, true)));
+    final Map<String, Boolean> options = WebAuthnCtap2.makeCredentialOptions(true, true, both);
+    assertEquals(2, options.size());
+    assertEquals(Boolean.TRUE, options.get("rk"));
+    assertEquals(Boolean.TRUE, options.get("uv"));
+    assertNull("\"up\" is normative true: never sent", options.get("up"));
+  }
+
+  @Test
+  public void makeCredentialOptions_emptyRequestOmitsOptions() {
+    final WebAuthnCtap2.KeyInfo both =
+        WebAuthnCtap2.fetchKeyInfo(new InfoSession(infoBody(true, true, false)));
+    assertNull(WebAuthnCtap2.makeCredentialOptions(false, false, both));
+  }
+
+  @Test
+  public void makeCredentialOptions_neverSendsUndeclaredOptions() {
+    // This is the 2026-11-08 failure: the site asked for rk+uv, the key declared neither.
+    // Before the capability probe we sent the guess and the key answered 0x2C INVALID_OPTION.
+    final WebAuthnCtap2.KeyInfo plain =
+        WebAuthnCtap2.fetchKeyInfo(new InfoSession(infoBody(false, false, false)));
+    try {
+      WebAuthnCtap2.makeCredentialOptions(true, true, plain);
+      fail("expected Ctap2Error for undeclared rk");
+    } catch (final Ctap2Error e) {
+      assertEquals("must surface as NotSupportedError at the web seam", 0x2B, e.getCtapStatus());
+      assertTrue(e.getMessage().contains("options.rk"));
+    }
+  }
+
+  @Test
+  public void assertionOptions_uvOnlyWhenDeclared() {
+    final WebAuthnCtap2.KeyInfo uvCapable =
+        WebAuthnCtap2.fetchKeyInfo(new InfoSession(infoBody(false, true, true)));
+    final Map<String, Boolean> options = WebAuthnCtap2.assertionOptions(true, uvCapable);
+    assertEquals(1, options.size());
+    assertEquals(Boolean.TRUE, options.get("uv"));
+    assertNull(WebAuthnCtap2.assertionOptions(false, uvCapable));
+
+    final WebAuthnCtap2.KeyInfo noUv =
+        WebAuthnCtap2.fetchKeyInfo(new InfoSession(infoBody(false, false, true)));
+    try {
+      WebAuthnCtap2.assertionOptions(true, noUv);
+      fail("expected Ctap2Error for undeclared uv");
+    } catch (final Ctap2Error e) {
+      assertEquals(0x2B, e.getCtapStatus());
+      assertTrue(e.getMessage().contains("options.uv"));
+    }
+  }
+
+  @Test
+  public void getStatusDescriptionsMatchSpecTable() {
+    // The 2026-11-08 log said "status 0x2c"; this name is the CTAP 2.0 section 6.1 table.
+    assertEquals("INVALID_OPTION", Ctap2Error.describe(0x2C));
+    assertEquals("UNSUPPORTED_OPTION", Ctap2Error.describe(0x2B));
+    assertEquals("NO_CREDENTIALS", Ctap2Error.describe(0x2E));
+    assertEquals("PIN_REQUIRED", Ctap2Error.describe(0x36));
+    assertEquals("VENDOR_RANGE", Ctap2Error.describe(0xF7));
+  }
+}
