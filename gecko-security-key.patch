+package org.mozilla.gecko.ctap2;
+
+import android.hardware.usb.UsbConstants;
+import android.hardware.usb.UsbDevice;
+import android.hardware.usb.UsbDeviceConnection;
+import android.hardware.usb.UsbEndpoint;
+import android.hardware.usb.UsbInterface;
+import android.hardware.usb.UsbManager;
+import android.hardware.usb.UsbRequest;
+import android.util.Log;
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.security.SecureRandom;
+import java.util.List;
+
+/**
+ * CTAP2 over USB HID transport ("CTAPHID"), per the FIDO Alliance CTAP v2.0 spec, section 8.1.
+ *
+ * <p>Wire layer (spec 8.1.4): fixed-size HID reports (64 bytes on full-speed devices).
+ * Initialization packet: CID(4) CMD(1, bit 7 set) BCNT(2, big-endian) DATA(...). Continuation
+ * packet: CID(4) SEQ(1, 0..0x7f, ascending) DATA(...).
+ *
+ * <p>Handshake (spec 8.1.9.1.3, CTAPHID_INIT 0x06): INIT on the broadcast CID (0xFFFFFFFF)
+ * allocates a channel. Request data is an 8-byte nonce; the response carries the same nonce, then
+ * the 4-byte channel ID, protocol version, device version, capability flags. Commands then run on
+ * the allocated channel.
+ *
+ * <p>CTAP2 commands (spec 8.1.9.1.2, CTAPHID_CBOR 0x10): request data is the CTAP command byte
+ * followed by the CBOR payload; response data is the CTAP status byte followed by the CBOR
+ * payload. Keep-alive packets (CTAPHID_KEEPALIVE 0x3B) are consumed and skipped. A CTAPHID_ERROR
+ * (0x3F) response carries a 1-byte CTAPHID error code (spec 8.1.9.1.6).
+ *
+ * <p>Host side: standard Android USB host mode (UsbRequest + requestWait). Both the IN and OUT
+ * UsbRequests are always queued; requestWait returns whichever completes first, so an in-flight
+ * response is never lost even though a write completes as soon as the report hits the bus.
+ *
+ * <p>Ported (Java) from the Proton Mail fork's fido-nfc module; the request method is generalized
+ * to take the CTAP command byte so makeCredential (0x01) works beside getAssertion (0x02).
+ */
+public class UsbCtap2Transport {
+
+  static final String TAG = "GeckoCtap2Usb";
+
+  // CTAPHID commands (spec 8.1.9). The TYPE bit (0x80) marks an INITIATOR (first)
+  // packet: spec 8.1.9.1 "the command byte has always the highest bit set". Without
+  // it the device reads every packet as a continuation and stays silent — that was
+  // the CTAPHID_INIT timeout on real YubiKeys. The device sets the same bit on its
+  // first response packets, so responses are read through {@link #cmdOf}.
+  private static final byte INITIATOR_BIT = (byte) 0x80;
+  private static final byte CMD_CBOR = (byte) 0x10;
+  private static final byte CMD_INIT = (byte) 0x06;
+  private static final byte CMD_KEEPALIVE = (byte) 0x3B;
+  private static final byte CMD_ERROR = (byte) 0x3F;
+
+  private static final int BROADCAST_CID = -1; // 0xFFFFFFFF
+  private static final int CAPABILITY_CBOR = 0x04;
+
+  private static final int USB_CLASS_HID = 0x03;
+  // CTAP HID devices declare bInterfaceProtocol 0x21 on their CTAP interface (CTAP 2.0 spec
+  // section 8.1.2.1 / USB HID usage table). This is the only layout-independent marker the
+  // spec provides; the interface POSITION differs between vendors and even YubiKey models
+  // (e.g. 0 = keyboard, 1 = CCID smart-card, 2 = CTAP), so it must never be hardcoded.
+  private static final int CTAP_HID_PROTOCOL = 0x21;
+
+  private static final int REPORT_SIZE_DEFAULT = 64;
+  private static final int MIN_REPORT_SIZE = 8;
+
+  private static final int NONCE_SIZE = 8;
+  // INIT response (spec 8.1.9.1.3): nonce(8) cid(4) protVer(1) devVer(3) caps(1).
+  private static final int INIT_RESPONSE_SIZE = 17;
+
+  private static final long WAIT_TIMEOUT_MS = 1000L;
+  private static final long PACKET_TIMEOUT_MS = 30_000L;
+  // Short timeout used while probing interfaces with CTAPHID_INIT: only a live CTAP applet
+  // answers, everything else is silent, so a wrong interface is rejected in ~2 s instead of 30.
+  private static final long PROBE_TIMEOUT_MS = 2_000L;
+  // Probe budget: max IN waits per interface during probing (bounds keep-alive-only loops).
+  private static final int PROBE_WAIT_BUDGET = 8;
+
+  private UsbDeviceConnection mConnection;
+  private UsbRequest mInRequest;
+  private UsbRequest mOutRequest;
+  private int mChannel = -1;
+  private int mReportSize = REPORT_SIZE_DEFAULT;
+  private long mInTimeoutMs = PACKET_TIMEOUT_MS;
+  private int mProbeWaitsRemaining = -1; // -1 = no budget (normal operation)
+  private final ByteBuffer mInBuffer = ByteBuffer.allocateDirect(REPORT_SIZE_DEFAULT);
+  private final ByteBuffer mOutBuffer = ByteBuffer.allocateDirect(REPORT_SIZE_DEFAULT);
+
+  /**
+   * Binds the CTAPHID interface of {@code device}. The CTAP interface is located by PROBE, not by
+   * position: every HID interface with an IN+OUT endpoint pair (spec 8.1.8.1) is tried in rank
+   * order (see {@link #rankInterfaces}) and given a short CTAPHID_INIT probe; the first interface
+   * that answers is the FIDO one. Interface layouts differ between vendors and models, so a
+   * hardcoded position is unreliable. Returns false when nothing answers.
+   */
+  public boolean bindDevice(final UsbDevice device, final UsbManager usb) {
+    final int[] ranked = rankInterfaces(device);
+    for (final int idx : ranked) {
+      final UsbInterface intf = device.getInterface(idx);
+      if (bindInterface(device, usb, intf)) {
+        mInTimeoutMs = PROBE_TIMEOUT_MS;
+        mProbeWaitsRemaining = PROBE_WAIT_BUDGET;
+        final boolean ok = initialize();
+        mProbeWaitsRemaining = -1;
+        mInTimeoutMs = PACKET_TIMEOUT_MS;
+        if (ok) {
+          // The probe's INIT allocated a channel; per spec 8.1.9.1.3 it is a fresh-CID-on-each-INIT
+          // world, and keys may age the probe channel out at any moment. Discard it: the session
+          // performs its own INIT (see {@link #initialize}).
+          mChannel = -1;
+          Log.i(TAG, "CTAP interface bound (index " + intf.getId() + ", protocol 0x"
+              + Integer.toHexString(intf.getInterfaceProtocol()) + ")");
+          return true;
+        }
+        release();
+      }
+    }
+    Log.w(TAG, "no CTAP interface answered CTAPHID_INIT on this device");
+    return false;
+  }
+
+  /**
+   * Minimal HID interface descriptor used for candidate ranking. Pure JVM (no Android classes) so
+   * the ranking — the exact logic that failed with a hardcoded interface ID — is unit-testable.
+   */
+  public interface HidInterfaceInfo {
+    int interfaceClass();
+
+    int interfaceProtocol();
+
+    boolean hasInEndpoint();
+
+    boolean hasOutEndpoint();
+
+    int inReportSize();
+  }
+
+  /**
+   * Pure, unit-testable candidate ordering for {@link #bindDevice}: a candidate must be
+   * HID-class with both an IN and an OUT endpoint (the CTAPHID pair, spec 8.1.8.1). Primary key:
+   * CTAP HID protocol 0x21 (the spec's layout-independent marker) first. Secondary key:
+   * full-speed report size 64 (spec 8.1.4 default). Ties keep descriptor order.
+   */
+  public static int[] rankCandidates(final List<? extends HidInterfaceInfo> candidates) {
+    final List<Integer> cands = new java.util.ArrayList<>();
+    for (int i = 0; i < candidates.size(); i++) {
+      final HidInterfaceInfo c = candidates.get(i);
+      if (c.interfaceClass() == USB_CLASS_HID && c.hasInEndpoint() && c.hasOutEndpoint()) {
+        cands.add(i);
+      }
+    }
+    cands.sort(
+        (a, b) -> {
+          final HidInterfaceInfo ia = candidates.get(a);
+          final HidInterfaceInfo ib = candidates.get(b);
+          final int pa = ia.interfaceProtocol() == CTAP_HID_PROTOCOL ? 0 : 1;
+          final int pb = ib.interfaceProtocol() == CTAP_HID_PROTOCOL ? 0 : 1;
+          if (pa != pb) {
+            return pa - pb;
+          }
+          final int qa = ia.inReportSize() == REPORT_SIZE_DEFAULT ? 0 : 1;
+          final int qb = ib.inReportSize() == REPORT_SIZE_DEFAULT ? 0 : 1;
+          if (qa != qb) {
+            return qa - qb;
+          }
+          return a - b;
+        });
+    final int[] out = new int[cands.size()];
+    for (int i = 0; i < cands.size(); i++) {
+      out[i] = cands.get(i);
+    }
+    return out;
+  }
+
+  /** {@link #rankCandidates} applied to the descriptor of a real {@link UsbDevice}. */
+  public static int[] rankInterfaces(final UsbDevice device) {
+    final int count = device.getInterfaceCount();
+    final HidInterfaceInfo[] infos = new HidInterfaceInfo[count];
+    for (int i = 0; i < count; i++) {
+      final UsbInterface intf = device.getInterface(i);
+      boolean hasIn = false;
+      boolean hasOut = false;
+      int report = 0;
+      for (int e = 0; e < intf.getEndpointCount(); e++) {
+        final int dir = intf.getEndpoint(e).getDirection();
+        if (dir == UsbConstants.USB_DIR_IN) {
+          hasIn = true;
+          report = intf.getEndpoint(e).getMaxPacketSize();
+        } else if (dir == UsbConstants.USB_DIR_OUT) {
+          hasOut = true;
+        }
+      }
+      final boolean fin = hasIn;
+      final boolean fout = hasOut;
+      final int freport = report;
+      final int cls = intf.getInterfaceClass();
+      final int proto = intf.getInterfaceProtocol();
+      infos[i] =
+          new HidInterfaceInfo() {
+            @Override
+            public int interfaceClass() {
+              return cls;
+            }
+
+            @Override
+            public int interfaceProtocol() {
+              return proto;
+            }
+
+            @Override
+            public boolean hasInEndpoint() {
+              return fin;
+            }
+
+            @Override
+            public boolean hasOutEndpoint() {
+              return fout;
+            }
+
+            @Override
+            public int inReportSize() {
+              return freport;
+            }
+          };
+    }
+    final List<HidInterfaceInfo> list = java.util.Arrays.asList(infos);
+    return rankCandidates(list);
+  }
+
+  /** Claims {@code intf} and sets up the request objects. True when the interface is ready. */
+  private boolean bindInterface(final UsbDevice device, final UsbManager usb, final UsbInterface intf) {
+    UsbEndpoint out = null;
+    UsbEndpoint inp = null;
+    for (int i = 0; i < intf.getEndpointCount(); i++) {
+      final UsbEndpoint ep = intf.getEndpoint(i);
+      if (ep.getDirection() == UsbConstants.USB_DIR_OUT) {
+        out = ep;
+      } else if (ep.getDirection() == UsbConstants.USB_DIR_IN) {
+        inp = ep;
+      }
+    }
+    if (out == null || inp == null) {
+      return false;
+    }
+    mReportSize = Math.max(inp.getMaxPacketSize(), MIN_REPORT_SIZE);
+    try {
+      final UsbDeviceConnection conn = usb.openDevice(device);
+      if (conn == null) {
+        return false;
+      }
+      if (!conn.claimInterface(intf, true)) {
+        conn.close();
+        return false;
+      }
+      mConnection = conn;
+      mInRequest = new UsbRequest();
+      mInRequest.initialize(conn, inp);
+      mOutRequest = new UsbRequest();
+      mOutRequest.initialize(conn, out);
+      return true;
+    } catch (final Exception e) {
+      Log.e(TAG, "bindInterface failed", e);
+      release();
+      return false;
+    }
+  }
+
+  public void release() {
+    try {
+      if (mInRequest != null) {
+        mInRequest.cancel();
+        mInRequest.close();
+      }
+      if (mOutRequest != null) {
+        mOutRequest.cancel();
+        mOutRequest.close();
+      }
+    } catch (final Exception e) {
+      // best-effort
+    }
+    try {
+      if (mConnection != null) {
+        mConnection.close();
+      }
+    } catch (final Exception e) {
+      // best-effort
+    }
+    mInRequest = null;
+    mOutRequest = null;
+    mConnection = null;
+    mChannel = -1;
+  }
+
+  /**
+   * Allocates a CTAPHID channel via INIT on the broadcast CID. Returns true on success; the
+   * response must echo the request nonce (guards against a stale broadcast response from another
+   * client). ALWAYS fresh: spec 8.1.9.1.3 defines INIT as allocating a NEW channel, so a channel
+   * allocated during {@link #bindDevice} probing is deliberately discarded there, and the session
+   * gets its own. Never trust a previously allocated channel across a bind.
+   */
+  public boolean initialize() {
+    return initializeIo(reportIo());
+  }
+
+  /** INIT over an explicit IO seam; instance state (mChannel) is still owned by this transport. */
+  boolean initializeIo(final ReportIo io) {
+    final byte[] nonce = new byte[NONCE_SIZE];
+    new SecureRandom().nextBytes(nonce);
+    final ByteBuffer packet = newOutPacket();
+    putFirstPacketHeader(packet, BROADCAST_CID, CMD_INIT, nonce.length);
+    packet.put(nonce);
+
+    // expectedCid null: the INIT response carries the NEWLY ALLOCATED channel id, not
+    // the broadcast CID; the nonce echo below is the freshness guard.
+    final byte[] resp = transactIo(io, packet, CMD_INIT, null);
+    if (resp == null || resp.length < INIT_RESPONSE_SIZE) {
+      return false;
+    }
+    for (int i = 0; i < NONCE_SIZE; i++) {
+      if (resp[i] != nonce[i]) {
+        return false;
+      }
+    }
+    mChannel =
+        ((resp[NONCE_SIZE] & 0xFF) << 24)
+            | ((resp[NONCE_SIZE + 1] & 0xFF) << 16)
+            | ((resp[NONCE_SIZE + 2] & 0xFF) << 8)
+            | (resp[NONCE_SIZE + 3] & 0xFF);
+    Log.i(TAG, "CTAPHID channel 0x" + Integer.toHexString(mChannel) + " allocated");
+    final int caps = resp[NONCE_SIZE + 8] & 0xFF;
+    if ((caps & CAPABILITY_CBOR) == 0) {
+      Log.w(TAG, "device reports no CTAPHID_CBOR capability (caps=0x" + Integer.toHexString(caps) + ")");
+    }
+    return true;
+  }
+
+  /**
+   * Runs one CTAP2 command ({@link Ctap2Session#CTAP_MAKE_CREDENTIAL} or {@link
+   * Ctap2Session#CTAP_GET_ASSERTION}) on the allocated channel. Returns the CBOR response body
+   * when the CTAP status is 0x00; otherwise throws {@link Ctap2Error} with the CTAP status code.
+   */
+  public byte[] sendCtapCommand(final int ctapCmd, final byte[] cborPayload) {
+    return sendCtapCommandIo(reportIo(), ctapCmd, cborPayload);
+  }
+
+  byte[] sendCtapCommandIo(
+      final ReportIo io, final int ctapCmd, final byte[] cborPayload) {
+    // Spec 8.1.5.4: a CTAP2 CBOR command is legal only on an INIT-allocated channel. Enforce it
+    // HERE, not in callers: if no channel is held, allocate one now. Any future command (GetInfo
+    // probes included) is correct by construction regardless of call order.
+    if (mChannel < 0 && !initializeIo(io)) {
+      throw new Ctap2Error("the security key did not answer CTAPHID INIT");
+    }
+    final byte[] data = new byte[cborPayload.length + 1];
+    data[0] = (byte) ctapCmd;
+    System.arraycopy(cborPayload, 0, data, 1, cborPayload.length);
+    final byte[] resp = transactMessageIo(io, mChannel, CMD_CBOR, data);
+    if (resp == null) {
+      throw new Ctap2Error("no USB response to CTAP command 0x" + Integer.toHexString(ctapCmd));
+    }
+    if (resp.length == 0) {
+      throw new Ctap2Error("empty USB response");
+    }
+    final int ctapStatus = resp[0];
+    final byte[] body = new byte[resp.length - 1];
+    System.arraycopy(resp, 1, body, 0, body.length);
+    if (ctapStatus != 0x00) {
+      throw new Ctap2Error(
+          "CTAP command 0x"
+              + Integer.toHexString(ctapCmd)
+              + " failed, status 0x"
+              + Integer.toHexString(ctapStatus & 0xFF).toUpperCase()
+              + " "
+              + Ctap2Error.describe(ctapStatus),
+          ctapStatus,
+          null);
+    }
+    return body;
+  }
+
+  /**
+   * Sends one CTAPHID message (command {@code cmd}, payload {@code data}; spans continuation
+   * packets when the payload exceeds one report) and returns the full response payload.
+   * Keep-alive packets are skipped; a CTAPHID_ERROR throws {@link Ctap2Error}.
+   */
+  private byte[] transactMessage(final byte cmd, final byte[] data) {
+    return transactMessageIo(reportIo(), mChannel, cmd, data);
+  }
+
+  byte[] transactMessageIo(
+      final ReportIo io, final int cid, final byte cmd, final byte[] data) {
+    final int total = data.length;
+    int offset = 0;
+    int packetIndex = 0;
+    while (true) {
+      final int chunk = Math.min(outPayloadCapacity(mReportSize, packetIndex), total - offset);
+      final ByteBuffer packet = newOutPacket();
+      if (packetIndex == 0) {
+        putFirstPacketHeader(packet, cid, cmd, total);
+      } else {
+        packet.putInt(cid);
+        packet.put((byte) (packetIndex - 1)); // SEQ: first continuation is 0 (spec 8.1.9.1)
+      }
+      if (chunk > 0) {
+        packet.put(data, offset, chunk);
+      }
+      if (!io.send(packet)) {
+        return null;
+      }
+      offset += chunk;
+      packetIndex++;
+      if (offset >= total) {
+        break;
+      }
+    }
+
+    final ByteArrayOutputStream body = new ByteArrayOutputStream();
+    while (true) {
+      final ByteBuffer resp = io.recvReport();
+      if (resp == null) {
+        return null;
+      }
+      final byte cmdByte = cmdOf(resp);
+      final int len = bcntOf(resp);
+      if (cmdByte == CMD_KEEPALIVE) {
+        continue; // processing / user-presence indicator
+      }
+      if (cmdByte == CMD_ERROR) {
+        final int code = len >= 1 ? resp.get(FIRST_PAYLOAD_OFFSET) & 0xFF : -1;
+        throw new Ctap2Error("USB CTAPHID error 0x" + Integer.toHexString(code).toUpperCase()
+            + " on channel 0x" + Integer.toHexString(cid));
+      }
+      if (cidOf(resp) != cid) {
+        continue;
+      }
+      if (len < 1) {
+        return null;
+      }
+      readPayloadInto(body, resp, len, FIRST_PAYLOAD_OFFSET);
+      if (!fillContinuations(io::recvReport, cid, body, len)) {
+        return null;
+      }
+      return body.toByteArray();
+    }
+  }
+
+  /** Inbound HID report source, abstracted so response reassembly is host-testable. */
+  interface InboundReportSource {
+    /** The next inbound report, or null on transport failure/timeout. */
+    ByteBuffer nextReport();
+  }
+
+  /**
+   * Appends continuation reports to {@code body} until it holds {@code payloadLen} bytes, skipping
+   * foreign-channel and unexpected-SEQ packets (spec 8.1.3; the inbound counterpart of
+   * {@link #outPayloadCapacity} on the outbound side). Returns false on transport failure.
+   */
+  static boolean fillContinuations(
+      final InboundReportSource source,
+      final int channel,
+      final ByteArrayOutputStream body,
+      final int payloadLen) {
+    int nextSeq = 0;
+    while (body.size() < payloadLen) {
+      final ByteBuffer cont = source.nextReport();
+      if (cont == null) {
+        return false;
+      }
+      if (cidOf(cont) != channel || (cont.get(4) & 0xFF) != (nextSeq & 0xFF)) {
+        continue; // foreign or out-of-order continuation; keep waiting
+      }
+      readPayloadInto(body, cont, payloadLen - body.size(), CONT_PAYLOAD_OFFSET);
+      nextSeq++;
+    }
+    return true;
+  }
+
+  /**
+   * Sends {@code packet} and returns the payload of the next non-keepalive response matching
+   * {@code expectedCmd} on {@code expectedCid}, or null on failure. Used for INIT.
+   */
+  private ReportIo reportIo() {
+    return new ReportIo() {
+      @Override
+      public boolean send(final ByteBuffer packet) {
+        return sendOut(packet);
+      }
+
+      @Override
+      public ByteBuffer recvReport() {
+        return waitForIn();
+      }
+    };
+  }
+
+  int channelForTest() {
+    return mChannel;
+  }
+
+  /** Report in/out seam; the JVM contract tests drive a scripted key through exactly this. */
+  interface ReportIo {
+    boolean send(ByteBuffer packet);
+
+    ByteBuffer recvReport();
+  }
+
+  private byte[] transact(final ByteBuffer packet, final byte expectedCmd, final Integer expectedCid) {
+    return transactIo(reportIo(), packet, expectedCmd, expectedCid);
+  }
+
+  byte[] transactIo(
+      final ReportIo io,
+      final ByteBuffer packet,
+      final byte expectedCmd,
+      final Integer expectedCid) {
+    if (!io.send(packet)) {
+      return null;
+    }
+    while (true) {
+      final ByteBuffer resp = io.recvReport();
+      if (resp == null) {
+        return null;
+      }
+      final byte cmdByte = cmdOf(resp);
+      final int len = bcntOf(resp);
+      if (cmdByte == CMD_KEEPALIVE) {
+        continue;
+      }
+      if (cmdByte == CMD_ERROR) {
+        final int code = len >= 1 ? resp.get(FIRST_PAYLOAD_OFFSET) & 0xFF : -1;
+        throw new Ctap2Error("USB CTAPHID error 0x" + Integer.toHexString(code).toUpperCase());
+      }
+      if (cmdByte != expectedCmd) {
+        continue;
+      }
+      if (expectedCid != null && cidOf(resp) != expectedCid) {
+        continue;
+      }
+      if (len < 1) {
+        return null;
+      }
+      final int take = Math.min(len, resp.remaining() - FIRST_PAYLOAD_OFFSET);
+      final byte[] out = new byte[take];
+      for (int i = 0; i < take; i++) {
+        out[i] = resp.get(FIRST_PAYLOAD_OFFSET + i);
+      }
+      return out;
+    }
+  }
+
+  /** Queues the OUT request; the write completes once the report hits the bus. */
+  private boolean sendOut(final ByteBuffer packet) {
+    if (mOutRequest == null || mConnection == null) {
+      return false;
+    }
+    // Spec 8.1.4: unused bytes of the fixed-size report SHOULD be zero.
+    while (packet.hasRemaining()) {
+      packet.put((byte) 0);
+    }
+    packet.rewind();
+    try {
+      mOutRequest.queue(packet, mReportSize);
+    } catch (final Exception e) {
+      Log.e(TAG, "queue out failed", e);
+      return false;
+    }
+    while (true) {
+      final UsbRequest got = waitRequest(mInTimeoutMs);
+      if (got == null) {
+        return false;
+      }
+      if (got == mOutRequest) {
+        return true;
+      }
+      if (got == mInRequest) {
+        mInBuffer.rewind(); // response already arrived; kept for waitForIn
+      }
+    }
+  }
+
+  /**
+   * Queues the IN request and waits until one full report is received. Returns the buffer (rewound)
+   * or null on timeout/failure. While a probe budget is active (interface probing), each wait also
+   * decrements the budget so a keep-alive-only interface cannot loop forever.
+   */
+  private ByteBuffer waitForIn() {
+    if (mInRequest == null || mConnection == null) {
+      return null;
+    }
+    if (mProbeWaitsRemaining >= 0) {
+      mProbeWaitsRemaining--;
+      if (mProbeWaitsRemaining < 0) {
+        return null;
+      }
+    }
+    mInBuffer.clear();
+    mInBuffer.limit(mReportSize);
+    try {
+      mInRequest.queue(mInBuffer, mReportSize);
+    } catch (final Exception e) {
+      Log.e(TAG, "queue in failed", e);
+      return null;
+    }
+    while (true) {
+      final UsbRequest got = waitRequest(mInTimeoutMs);
+      if (got == null) {
+        return null;
+      }
+      if (got == mInRequest) {
+        mInBuffer.rewind();
+        return mInBuffer;
+      }
+      // got == mOutRequest: a write finished; the IN packet is still due
+    }
+  }
+
+  private UsbRequest waitRequest(final long timeoutMs) {
+    if (mConnection == null) {
+      return null;
+    }
+    try {
+      return mConnection.requestWait(timeoutMs);
+    } catch (final Exception e) {
+      Log.e(TAG, "requestWait failed", e);
+      return null;
+    }
+  }
+
+  private ByteBuffer newOutPacket() {
+    mOutBuffer.clear();
+    mOutBuffer.limit(mReportSize);
+    mOutBuffer.order(ByteOrder.BIG_ENDIAN);
+    return mOutBuffer;
+  }
+
+  /** Writes the 7-byte header of an initiator (first) packet: CID, CMD|TYPE, BCNT. */
+  static void putFirstPacketHeader(
+      final ByteBuffer p, final int cid, final byte cmd, final int len) {
+    p.putInt(cid);
+    p.put((byte) (cmd | INITIATOR_BIT));
+    putBcnt(p, len);
+  }
+
+  static final int FIRST_PAYLOAD_OFFSET = 7; // CID(4) CMD(1) BCNT(2)
+  static final int CONT_PAYLOAD_OFFSET = 5; // CID(4) SEQ(1)
+
+  /**
+   * Payload capacity of the {@code packetIndex}-th outbound packet (spec 8.1.9.1): the first
+   * packet carries a 7-byte header (CID|CMD|BCNT) while continuation packets carry only 5 bytes
+   * (CID|SEQ). Slicing continuations with the first-packet width inserts two padding bytes into
+   * the middle of the CTAP2 CBOR stream, which real authenticators reject with
+   * CTAP2_ERR_INVALID_CBOR (0x11).
+   */
+  static int outPayloadCapacity(final int reportSize, final int packetIndex) {
+    return reportSize - (packetIndex == 0 ? FIRST_PAYLOAD_OFFSET : CONT_PAYLOAD_OFFSET);
+  }
+
+  /** Command byte of a response packet with the TYPE bit masked off. */
+  static byte cmdOf(final ByteBuffer p) {
+    return (byte) (p.get(4) & 0x7F);
+  }
+
+  /**
+   * Copies up to {@code want} payload bytes of a report into {@code body}. Payload offset:
+   * 7 for a first/initiator packet (CID 0-3, CMD 4, BCNT 5-6), 5 for a continuation packet
+   * (CID 0-3, SEQ 4, no BCNT). Spec 8.1.9.1.
+   */
+  static void readPayloadInto(
+      final ByteArrayOutputStream body, final ByteBuffer report, final int want, final int offset) {
+    final int take = Math.min(want, report.remaining() - offset);
+    final byte[] bytes = new byte[take];
+    report.position(offset);
+    report.get(bytes);
+    report.position(0);
+    body.write(bytes, 0, bytes.length);
+  }
+
+  private static int cidOf(final ByteBuffer p) {
+    p.mark();
+    final int cid = p.getInt();
+    p.reset();
+    return cid;
+  }
+
+  /** BCNT field (bytes 5..6, big-endian) of a CTAPHID packet. */
+  private static int bcntOf(final ByteBuffer p) {
+    p.mark();
+    p.position(5);
+    final int hi = p.get() & 0xFF;
+    final int lo = p.get() & 0xFF;
+    p.reset();
+    return (hi << 8) | lo;
+  }
+
+  private static void putBcnt(final ByteBuffer p, final int len) {
+    p.put((byte) (len >> 8));
+    p.put((byte) (len & 0xFF));
+  }
+}
