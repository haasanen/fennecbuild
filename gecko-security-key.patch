+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+import com.upokecenter.cbor.CBOREncodeOptions;
+import com.upokecenter.cbor.CBORObject;
+import com.upokecenter.cbor.CBORType;
+import java.util.List;
+
+/**
+ * Minimal CBOR codec for the two CTAP2 commands the browser needs, per the CTAP2 spec's normative
+ * examples. Encode uses {@code DefaultCtap2Canonical} (canonical map-key order, minimal integer
+ * forms) as required for requests.
+ *
+ * <p>getAssertion (0x02) request (map, integer keys):
+ *
+ * <pre>
+ *   1  rpId            text, REQUIRED
+ *   2  clientDataHash  bytes, REQUIRED
+ *   3  allowList       array of { "type": "public-key", "id": bytes }, optional  (TEXT keys!)
+ *   4  extensions      map { "appid": text }, optional
+ *   5  options         map { "up": true, "uv"?: true }, optional
+ * </pre>
+ *
+ * getAssertion response (map): 1=credential (INTEGER key 1 holding a TEXT-keyed descriptor
+ * {"id": bytes, "type": "public-key"}), 2=authData, 3=signature, 4=user, 5=numberOfCredentials.
+ *
+ * <p>makeCredential (0x01) request (map):
+ *
+ * <pre>
+ *   1  clientDataHash   bytes, REQUIRED
+ *   2  rp               map { 1: id, 2: name }
+ *   3  user             map { 1: id (bytes), 2: name, 3: displayName }
+ *   4  pubKeyCredParams array of { 1: "public-key", 2: alg }
+ *   5  excludeList      array of { 1: "public-key", 2: id }, optional  (INTEGER keys!)
+ *   6  options          map { "up": true, "rk"?: bool, "uv"?: bool }
+ * </pre>
+ *
+ * makeCredential response (map): 1=fmt, 2=attStmt, 3=attObj.
+ *
+ * <p>The CBOR key-type asymmetry above is deliberate and spec-mandated: allowList entries use text
+ * keys while excludeList and pubKeyCredParams entries use integer keys. Verified against the real
+ * com.upokecenter:cbor 4.5.6 codec (20/20 checks in the Phase-2 harness).
+ *
+ * <p>Ported (Java) from the Proton Mail fork's fido-nfc module with the makeCredential half added.
+ */
+public final class Ctap2Cbor {
+
+  private static final CBOREncodeOptions CTAP2_CANONICAL =
+      CBOREncodeOptions.DefaultCtap2Canonical;
+
+  private Ctap2Cbor() {}
+
+  /** One entry of a getAssertion allowList / makeCredential excludeList. */
+  public static final class CredentialId {
+    public final byte[] id;
+
+    public CredentialId(final byte[] id) {
+      this.id = id;
+    }
+  }
+
+  /** One pubKeyCredParams entry: algorithm identifier (e.g. -7 = ES256). */
+  public static final class PublicKeyCredParam {
+    public final int alg;
+
+    public PublicKeyCredParam(final int alg) {
+      this.alg = alg;
+    }
+  }
+
+  /** Decoded authenticatorGetAssertion response. */
+  public static final class GetAssertionResponse {
+    public final byte[] credentialId;
+    public final byte[] authenticatorData;
+    public final byte[] signature;
+    /** The key's user handle (map key 4, "id") when present; otherwise null. */
+    public final byte[] userHandle;
+
+    GetAssertionResponse(
+        final byte[] credentialId,
+        final byte[] authenticatorData,
+        final byte[] signature,
+        final byte[] userHandle) {
+      this.credentialId = credentialId;
+      this.authenticatorData = authenticatorData;
+      this.signature = signature;
+      this.userHandle = userHandle;
+    }
+  }
+
+  /** Decoded authenticatorMakeCredential response (CTAP2 section 5.1). */
+  public static final class MakeCredentialResponse {
+    public final String fmt;
+    /** Raw authenticator data (binary): rpIdHash(32) flags(1) signCount(4) [aaguid(16) credIdLen(2) credId ...]. */
+    public final byte[] authData;
+    /**
+     * The [WebAuthn] attestation object — a CBOR map with TEXT keys { authData, fmt, attStmt } —
+     * which is what the Gecko (auth-rs) parser expects, NOT the raw CTAP2 response envelope.
+     */
+    public final byte[] attestationObject;
+
+    MakeCredentialResponse(
+        final String fmt, final byte[] authData, final byte[] attestationObject) {
+      this.fmt = fmt;
+      this.authData = authData;
+      this.attestationObject = attestationObject;
+    }
+  }
+
+  /**
+   * Encodes authenticatorGetAssertion (CTAP2 spec section 5.2). {@code clientDataHash} must be the
+   * SHA-256 of the clientDataJSON the relying party received. {@code appId} (the legacy FIDO
+   * AppID extension) is sent as the "appid" extension when non-null; per WebAuthn L2 section 10.1
+   * the caller must also have substituted the AppID for rpId.
+   *
+   * <p>"up" (user presence) is always true for a roaming security key. "uv" is sent only when the
+   * relying party REQUIRES user verification — a plain key has no local gesture and an unrequested
+   * uv:true is rejected with CTAP2_ERR_UNSUPPORTED_OPTION.
+   */
+  public static byte[] encodeGetAssertion(
+      final String rpId,
+      final byte[] clientDataHash,
+      final List<CredentialId> allowCredentials,
+      final String appId,
+      final boolean userVerificationRequired) {
+    final CBORObject map = CBORObject.NewMap();
+    map.Add(CBORObject.FromObject(1), CBORObject.FromObject(rpId));
+    map.Add(CBORObject.FromObject(2), CBORObject.FromObject(clientDataHash));
+    if (allowCredentials != null && !allowCredentials.isEmpty()) {
+      final CBORObject arr = CBORObject.NewArray();
+      for (final CredentialId cred : allowCredentials) {
+        // allowList descriptors use TEXT keys (spec examples; WebAuthn 5.8.3).
+        final CBORObject desc = CBORObject.NewMap();
+        desc.Add(CBORObject.FromObject("type"), CBORObject.FromObject("public-key"));
+        desc.Add(CBORObject.FromObject("id"), CBORObject.FromObject(cred.id));
+        arr.Add(desc);
+      }
+      map.Add(CBORObject.FromObject(3), arr);
+    }
+    if (appId != null && !appId.isEmpty()) {
+      final CBORObject ext = CBORObject.NewMap();
+      ext.Add(CBORObject.FromObject("appid"), CBORObject.FromObject(appId));
+      map.Add(CBORObject.FromObject(4), ext);
+    }
+    final CBORObject opts = CBORObject.NewMap();
+    opts.Add(CBORObject.FromObject("up"), CBORObject.FromObject(true));
+    if (userVerificationRequired) {
+      opts.Add(CBORObject.FromObject("uv"), CBORObject.FromObject(true));
+    }
+    map.Add(CBORObject.FromObject(5), opts);
+    return map.EncodeToBytes(CTAP2_CANONICAL);
+  }
+
+  /**
+   * Decodes the authenticatorGetAssertion response. Response key 1 (credential) is an INTEGER key
+   * holding a TEXT-keyed descriptor — the classic CBOR key-type trap. It may be absent (e.g. a
+   * single-credential allowList response); the id is then recovered from {@code
+   * allowCredentials} when exactly one was allowed.
+   */
+  public static GetAssertionResponse decodeGetAssertion(
+      final byte[] bytes, final List<CredentialId> allowCredentials) {
+    final CBORObject map = CBORObject.DecodeFromBytes(bytes);
+    // Key 1 is the selected credential: CTAP2 5.2 defines it as a single
+    // PublicKeyCredentialDescriptor (a TEXT-keyed map { "id": <bytes>, "type": ... }), but a few
+    // authenticators emit an ARRAY of descriptors, and a device-resident credential may omit the
+    // key entirely. Handle all three defensively.
+    CBORObject credentialId = null;
+    final CBORObject credObj = map.get(1);
+    if (credObj != null) {
+      if (credObj.getType() == CBORType.Array && credObj.size() > 0) {
+        credentialId = credObj.get(0).get("id");
+      } else if (credObj.getType() == CBORType.Map) {
+        credentialId = credObj.get("id");
+      }
+    }
+    if (credentialId == null
+        && allowCredentials != null
+        && allowCredentials.size() == 1) {
+      credentialId = CBORObject.FromObject(allowCredentials.get(0).id);
+    }
+    if (credentialId == null) {
+      throw new IllegalStateException("CTAP2 response missing credential (key 1)");
+    }
+    byte[] userHandle = null;
+    final CBORObject userObj = map.get(4);
+    if (userObj != null && userObj.getType() == CBORType.Map) {
+      // The user entity's id is a byte string under the text key "id" (WebAuthn
+      // PublicKeyCredentialUserEntity); integer key 1 is the CTAP2 wire form.
+      final CBORObject uid =
+          userObj.get("id") != null ? userObj.get("id") : userObj.get(1);
+      if (uid != null && uid.getType() == CBORType.ByteString) {
+        userHandle = uid.GetByteString();
+      }
+    }
+    return new GetAssertionResponse(
+        asBytes(credentialId, "credential.id"),
+        asBytes(map.get(2), "authData"),
+        asBytes(map.get(3), "signature"),
+        userHandle);
+  }
+
+  /**
+   * Encodes authenticatorMakeCredential (CTAP2 spec section 5.1). {@code clientDataHash} must be
+   * the SHA-256 of the clientDataJSON. Top-level CTAP2 parameters use INTEGER keys (1..7); the
+   * nested [WebAuthn] structures (rp, user, credential descriptors, pubKeyCredParams entries)
+   * use TEXT keys. "up" is always true; "rk" is sent only when the request asks for a resident
+   * (discoverable) credential, and "uv" only when user verification is required — an unrequested
+   * option risks CTAP2_ERR_UNSUPPORTED_OPTION.
+   */
+  public static byte[] encodeMakeCredential(
+      final byte[] clientDataHash,
+      final String rpId,
+      final String rpName,
+      final byte[] userId,
+      final String userName,
+      final String userDisplayName,
+      final List<PublicKeyCredParam> pubKeyCredParams,
+      final List<CredentialId> excludeList,
+      final boolean residentKey,
+      final boolean userVerificationRequired) {
+    final CBORObject map = CBORObject.NewMap();
+    map.Add(CBORObject.FromObject(1), CBORObject.FromObject(clientDataHash));
