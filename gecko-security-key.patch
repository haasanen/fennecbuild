+                transport.release();
+                flow.settleError(new WebAuthnUtils.Exception("NETWORK_ERR"));
+                return;
+              }
+              runExchange(flow, new UsbSession(transport));
+            },
+            "GeckoCtap2Usb");
+    worker.setDaemon(true);
+    worker.start();
+  }
+
+  /**
+   * Requests USB access through the system dialog. FLAG_UPDATE_CURRENT, never FLAG_NO_CREATE:
+   * with FLAG_NO_CREATE the first call returns a null PendingIntent and the dialog would be
+   * started without a response channel.
+   */
+  @SuppressLint("UnspecifiedRegisterReceiverFlag")
+  private static void requestUsbPermission(final FlowState flow, final UsbDevice device) {
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    final UsbManager usb = (UsbManager) ctx.getSystemService(Context.USB_SERVICE);
+    if (usb == null) {
+      flow.settleError(new WebAuthnUtils.Exception("UNKNOWN_ERR"));
+      return;
+    }
+    final BroadcastReceiver receiver =
+        new BroadcastReceiver() {
+          @Override
+          public void onReceive(final Context c, final Intent intent) {
+            // A re-enumeration (replug) auto-denies ALL pending system requests at once, so
+            // several receivers can hear one "denied" broadcast. Only the owning flow may act
+            // on it; and a "denied" broadcast is not truth — the system's permission state for
+            // the CURRENT device is. (Our own UsbDevice handle goes stale on replug, so check
+            // the freshly-attached key, not the handle captured when the flow started.)
+            final boolean broadcastGrant =
+                intent.getBooleanExtra(UsbManager.EXTRA_PERMISSION_GRANTED, false);
+            boolean owner;
+            synchronized (LOCK) {
+              owner = sPermissionOwner == flow;
+            }
+            if (!owner) {
+              Log.i(LOGTAG, "USB permission broadcast for another flow; ignoring");
+              return;
+            }
+            final UsbDevice fresh = findUsbSecurityKey();
+            final boolean granted =
+                (fresh != null && usb.hasPermission(fresh))
+                    || (device != null && usb.hasPermission(device))
+                    || (broadcastGrant && sameUsbDevice(device, getUsbDeviceExtra(intent)));
+            unregisterPermissionReceiver(flow);
+            if (!granted) {
+              Log.i(LOGTAG, "USB access was not granted");
+              flow.settleError(new WebAuthnUtils.Exception("NOT_ALLOWED_ERR"));
+              return;
+            }
+            Log.i(LOGTAG, "USB access granted; starting USB flow");
+            startUsbFlow(flow, fresh != null ? fresh : device);
+          }
+        };
+    flow.permissionReceiver = receiver;
+    // A still-pending dialog from a previous flow for the same key means the user started a new
+    // attempt; the old flow can no longer complete — settle it so its result is dropped instead
+    // of lingering (and its receiver does not outlive the flow).
+    synchronized (LOCK) {
+      final FlowState prev = sPermissionOwner;
+      if (prev != null && prev != flow && !prev.settled.get()) {
+        Log.i(LOGTAG, "superseding a pending permission flow");
+        // settle after ownership transfer: cleanup() releases sPermissionOwner only for itself.
+      }
+      sPermissionOwner = flow;
+      if (prev != null && prev != flow && !prev.settled.get()) {
+        prev.settleError(new WebAuthnUtils.Exception("TIMEOUT_ERR"));
+      }
+    }
+    // FLAG_UPDATE_CURRENT, never FLAG_NO_CREATE (see above).
+    final int piFlags = PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT;
+    final Intent intent = new Intent(USB_PERMISSION_ACTION).setPackage(ctx.getPackageName());
+    final PendingIntent pending = PendingIntent.getBroadcast(ctx, 0, intent, piFlags);
+    final IntentFilter filter = new IntentFilter(USB_PERMISSION_ACTION);
+    final Activity activity = sResumedActivity.get();
+    try {
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+        if (activity != null) {
+          activity.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        } else {
+          ctx.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        }
+      } else if (activity != null) {
+        activity.registerReceiver(receiver, filter);
+      } else {
+        ctx.registerReceiver(receiver, filter);
+      }
+    } catch (final Exception e) {
+      Log.e(LOGTAG, "registerReceiver (USB permission) failed", e);
+    }
+    try {
+      usb.requestPermission(device, pending);
+    } catch (final Exception e) {
+      Log.e(LOGTAG, "requestPermission failed", e);
+      flow.settleError(new WebAuthnUtils.Exception("UNKNOWN_ERR"));
+      return;
+    }
+    flow.grantTimeout =
+        () -> {
+          if (flow.permissionReceiver != null) {
+            Log.i(LOGTAG, "USB permission dialog did not complete in time");
+            flow.settleError(new WebAuthnUtils.Exception("NOT_ALLOWED_ERR"));
+          }
+        };
+    MainHolder.H.postDelayed(flow.grantTimeout, USB_GRANT_TIMEOUT_MS);
+  }
+
+  private static void unregisterPermissionReceiver(final FlowState flow) {
+    MainHolder.H.removeCallbacks(flow.grantTimeout);
+    if (flow.permissionReceiver != null) {
+      try {
+        GeckoAppShell.getApplicationContext().unregisterReceiver(flow.permissionReceiver);
+      } catch (final Exception e) {
+        // already unregistered
+      }
+      flow.permissionReceiver = null;
+    }
+  }
+
+  /**
+   * Arms the late-attach watch so a USB key plugged in after the prompt can still win:
+   * ACTION_USB_DEVICE_ATTACHED (primary) plus a bounded deviceList poll (some devices take
+   * seconds to enumerate). Both stop when a transport wins; the poll stops after the window.
+   */
+  @SuppressLint("UnspecifiedRegisterReceiverFlag")
+  private static void startLateUsbWatch(final FlowState flow) {
+    final BroadcastReceiver receiver =
+        new BroadcastReceiver() {
+          @Override
+          public void onReceive(final Context c, final Intent intent) {
+            final UsbDevice device = getUsbDeviceExtra(intent);
+            if (device == null || device.getVendorId() != USB_VENDOR_YUBICO) {
+              return;
+            }
+            onLateUsbAttach(flow, device);
+          }
+        };
+    flow.attachReceiver = receiver;
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    final IntentFilter filter = new IntentFilter(UsbManager.ACTION_USB_DEVICE_ATTACHED);
+    try {
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+        ctx.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED);
+      } else {
+        ctx.registerReceiver(receiver, filter);
+      }
+    } catch (final Exception e) {
+      Log.e(LOGTAG, "registerReceiver (USB attach) failed", e);
+    }
+    final long startMs = System.currentTimeMillis();
+    flow.poll =
+        new Runnable() {
+          @Override
+          public void run() {
+            if (flow.settled.get()) {
+              return;
+            }
+            final UsbDevice device = findUsbSecurityKey();
+            if (device != null) {
+              onLateUsbAttach(flow, device);
+            } else if (System.currentTimeMillis() - startMs < LATE_ATTACH_WATCH_WINDOW_MS) {
+              MainHolder.H.postDelayed(this, LATE_ATTACH_POLL_INTERVAL_MS);
+            }
+          }
+        };
+    MainHolder.H.postDelayed(flow.poll, LATE_ATTACH_POLL_INTERVAL_MS);
+  }
+
+  /** A YubiKey attached while the flow is active: USB wins the race. */
+  private static void onLateUsbAttach(final FlowState flow, final UsbDevice device) {
+    if (flow.settled.get() || flow.permissionReceiver != null) {
+      // settled already, or a permission dialog is up for this flow already
+      return;
+    }
+    Log.i(LOGTAG, "USB key attached during flow; switching NFC -> USB");
+    final Activity activity = sResumedActivity.get();
+    if (flow.nfcReader != null && activity != null) {
+      flow.nfcReader.stop(activity);
+    }
+    unregisterAttachReceiver(flow);
+    MainHolder.H.removeCallbacks(flow.poll);
+    if (hasUsbPermission(device)) {
+      startUsbFlow(flow, device);
+    } else {
+      requestUsbPermission(flow, device);
+    }
+  }
+
+  private static void unregisterAttachReceiver(final FlowState flow) {
+    if (flow.attachReceiver != null) {
+      try {
+        GeckoAppShell.getApplicationContext().unregisterReceiver(flow.attachReceiver);
+      } catch (final Exception e) {
+        // already unregistered
+      }
+      flow.attachReceiver = null;
+    }
+  }
+
+  private static void stopLateUsbWatch(final FlowState flow) {
+    unregisterAttachReceiver(flow);
+    MainHolder.H.removeCallbacks(flow.poll);
+  }
+
+  // ---------------------------------------------------------------- exchange
+
+  /** Worker thread: prepare the session and run the CTAP2 command for {@code flow}. */
+  private static void runExchange(final FlowState flow, final Ctap2Session session) {
+    final Request request = flow.request;
+    try {
+      if (!session.prepare()) {
+        throw new Ctap2Error("could not reach the FIDO2 authenticator on the security key");
+      }
+      final KeyInfo info = fetchKeyInfo(session);
+      Log.i(
+          LOGTAG,
+          "security key capabilities: versions="
+              + info.versions
+              + " options="
+              + info.declaredOptions
+              + " pinUvAuthProtocols="
+              + info.pinUvAuthProtocols);
+      final Object response =
+          request.makeCredential
+              ? doMakeCredential(request, session, info)
+              : doGetAssertion(request, session, info);
+      flow.settleSuccess(response);
+    } catch (final Exception e) {
+      Log.e(LOGTAG, "security key operation failed", e);
+      flow.settleError(mapError(e));
+    } finally {
+      try {
+        session.close();
+      } catch (final Exception e) {
+        // best-effort
+      }
+    }
+  }
+
+  private static WebAuthnUtils.MakeCredentialResponse doMakeCredential(
+      final Request request, final Ctap2Session session, final KeyInfo info) {
+    final Map<String, Boolean> options =
+        makeCredentialOptions(
+            request.residentKeyRequested, request.userVerificationRequired, info);
+    final byte[] cbor =
+        Ctap2Cbor.encodeMakeCredential(
+            request.clientDataHash,
+            request.rpId,
+            request.rpName,
+            request.userId,
+            request.userName,
+            request.userDisplayName,
+            request.pubKeyCredParams,
+            request.excludeList,
+            options);
+    byte[] body;
+    try {
+      body = session.send(Ctap2Session.CTAP_MAKE_CREDENTIAL, cbor);
+    } catch (final Ctap2Error e) {
+      if (e.getCtapStatus() != PinProtocolOne.STATUS_PIN_REQUIRED) {
+        throw e;
+      }
+      // The key has an enrolled PIN (spec 5.1.4): run the ClientPIN handshake and retry with
+      // pinUvAuthParam (key 8, protocol 1 in key 9).
+      final byte[] pinAuth = authorizeWithPin(request, session);
+      body =
+          session.send(
+              Ctap2Session.CTAP_MAKE_CREDENTIAL,
+              Ctap2Cbor.encodeMakeCredential(
+                  request.clientDataHash,
+                  request.rpId,
+                  request.rpName,
+                  request.userId,
+                  request.userName,
+                  request.userDisplayName,
+                  request.pubKeyCredParams,
+                  request.excludeList,
+                  options,
+                  pinAuth));
+    }
+    final Ctap2Cbor.MakeCredentialResponse ctap = Ctap2Cbor.decodeMakeCredential(body);
+    final WebAuthnUtils.MakeCredentialResponse.Builder builder =
+        new WebAuthnUtils.MakeCredentialResponse.Builder()
+            .setKeyHandle(extractCredentialId(ctap.authData))
+            .setClientDataJson(null)
+            .setAttestationObject(ctap.attestationObject)
+        .setTransports(new String[] {"usb", "nfc"})
+        .setAuthenticatorAttachment("cross-platform");
+    if (request.reportCredProps) {
+      // Best effort: report the rk option we actually sent.
+      builder.setCredProps(request.residentKeyRequested);
+    }
+    return builder.build();
+  }
+
+  private static WebAuthnUtils.GetAssertionResponse doGetAssertion(
+      final Request request, final Ctap2Session session, final KeyInfo info) {
+    // WebAuthn L2 10.1 (appid): the AppID replaces the RP id in the CTAP2 request so legacy
+    // U2F credentials (scoped to the AppID) match; clientDataHash still covers the real origin.
+    final String rpIdForKey =
+        request.appId != null && !request.appId.isEmpty() ? request.appId : request.rpId;
+    final byte[] cbor =
+        Ctap2Cbor.encodeGetAssertion(
+            rpIdForKey,
+            request.clientDataHash,
+            request.allowList,
+            request.appId,
+            assertionOptions(request.userVerificationRequired, info));
+    byte[] body;
+    try {
+      body = session.send(Ctap2Session.CTAP_GET_ASSERTION, cbor);
+    } catch (final Ctap2Error e) {
+      if (e.getCtapStatus() != PinProtocolOne.STATUS_PIN_REQUIRED) {
+        throw e;
+      }
+      // PIN_REQUIRED (spec 5.2.4): handshake for a pinToken, then retry with pinUvAuthParam in
+      // key 6 / protocol id in key 7. The param covers the real clientDataHash even under appid.
+      final byte[] pinAuth = authorizeWithPin(request, session);
+      body =
+          session.send(
+              Ctap2Session.CTAP_GET_ASSERTION,
+              Ctap2Cbor.encodeGetAssertion(
+                  rpIdForKey,
+                  request.clientDataHash,
+                  request.allowList,
+                  request.appId,
+                  assertionOptions(request.userVerificationRequired, info),
+                  pinAuth));
+    }
+    final Ctap2Cbor.GetAssertionResponse ctap =
+        Ctap2Cbor.decodeGetAssertion(body, request.allowList);
+    return new WebAuthnUtils.GetAssertionResponse.Builder()
+        .setClientDataJson(null)
+        .setKeyHandle(ctap.credentialId)
+        .setAuthData(ctap.authenticatorData)
+        .setSignature(ctap.signature)
+        .setUserHandle(ctap.userHandle)
+        .setAuthenticatorAttachment("cross-platform")
+        .build();
+  }
+
+  /**
+   * The credential id lives in the authenticator data: after rpIdHash(32) flags(1) signCount(4)
+   * aaguid(16) comes credIdLen(2) credId, present whenever the AT flag 0x40 is set (always the
+   * case for a makeCredential response).
+   */
+  private static byte[] extractCredentialId(final byte[] authData) {
+    if (authData != null
+        && authData.length >= 55
+        && (authData[32] & 0x40) != 0) {
+      final int credIdLen = ((authData[53] & 0xFF) << 8) | (authData[54] & 0xFF);
+      if (authData.length >= 55 + credIdLen) {
+        final byte[] id = new byte[credIdLen];
+        System.arraycopy(authData, 55, id, 0, credIdLen);
+        return id;
+      }
+    }
+    return new byte[0];
+  }
+
+  // ---------------------------------------------------------------- helpers
+
+  private static UsbDevice findUsbSecurityKey() {
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    final UsbManager usb = (UsbManager) ctx.getSystemService(Context.USB_SERVICE);
+    if (usb == null) {
+      return null;
+    }
+    for (final UsbDevice device : usb.getDeviceList().values()) {
+      if (device.getVendorId() == USB_VENDOR_YUBICO) {
+        return device;
+      }
+    }
+    return null;
+  }
+
+  private static boolean hasUsbPermission(final UsbDevice device) {
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    final UsbManager usb = (UsbManager) ctx.getSystemService(Context.USB_SERVICE);
+    return usb != null && usb.hasPermission(device);
+  }
+
+  /**
+   * Same physical device? {@link UsbDevice#equals} compares the native handle, which changes on
+   * every re-enumeration — a replug must not make a granted permission look like another device.
+   */
+  private static boolean sameUsbDevice(final UsbDevice a, final UsbDevice b) {
+    if (a == b) {
+      return true;
+    }
+    if (a == null || b == null) {
+      return false;
+    }
+    return a.getVendorId() == b.getVendorId()
+        && a.getProductId() == b.getProductId()
+        && a.getDeviceName().equals(b.getDeviceName());
+  }
+
+  @SuppressWarnings("deprecation")
+  private static UsbDevice getUsbDeviceExtra(final Intent intent) {
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+      return intent.getParcelableExtra(UsbManager.EXTRA_DEVICE, UsbDevice.class);
+    }
+    return intent.getParcelableExtra(UsbManager.EXTRA_DEVICE);
+  }
+
+  /**
+   * Handles PIN_REQUIRED (0x36): prompts for the key's PIN, obtains a pinToken through the
+   * pinUvAuthProtocol-1 handshake, and returns the pinUvAuthParam for the retried request. A wrong
+   * PIN re-prompts (up to three prompts total); blocked/unset PIN states fail immediately, since
+   * re-entering cannot fix them.
+   */
+  private static byte[] authorizeWithPin(final Request request, final Ctap2Session session)
+      throws Ctap2Error {
+    Ctap2Error last = null;
+    String note = null;
+    for (int attempt = 0; attempt < 3; attempt++) {
+      final String pin = promptForPin(request.rpId, note);
+      if (pin == null) {
+        throw new Ctap2Error("security key PIN entry was cancelled or is unavailable");
+      }
+      try {
+        final byte[] pinToken = PinProtocolOne.obtainPinToken(session, pin);
+        return PinProtocolOne.authenticate(pinToken, request.clientDataHash);
+      } catch (final Ctap2Error e) {
+        if (e.getCtapStatus() != PinProtocolOne.STATUS_PIN_INVALID) {
+          throw e; // blocked / not-set / protocol error: re-prompting cannot help
+        }
+        last = e;
+        note = "The PIN was wrong. Try again.";
+      }
+    }
+    throw last;
+  }
+
+  /**
+   * Shows the security-key PIN dialog on the UI thread and blocks the (background) exchange thread
+   * until it is answered. Returns null on cancel, when no activity is resumed, or after a
+   * 2-minute timeout — an exchange must never hang on a dialog the user is not going to answer.
+   */
+  private static String promptForPin(final String rpId, final String note) {
+    final Activity activity = sResumedActivity.get();
+    if (activity == null) {
+      return null;
+    }
+    final BlockingQueue<String> answer = new ArrayBlockingQueue<>(1);
+    new Handler(Looper.getMainLooper())
+        .post(
+            () -> {
+              final EditText input = new EditText(activity);
+              input.setInputType(
+                  InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+              final StringBuilder message =
+                  new StringBuilder("Enter the PIN of your security key to continue for ")
+                      .append(rpId)
+                      .append('.');
+              if (note != null) {
+                message.append(' ').append(note);
+              }
+              new AlertDialog.Builder(activity)
+                  .setTitle("Security key PIN")
+                  .setMessage(message.toString())
+                  .setView(input)
+                  .setCancelable(false)
+                  .setPositiveButton(
+                      android.R.string.ok,
+                      (dialog, which) -> answer.offer(input.getText().toString()))
+                  .setNegativeButton(android.R.string.cancel, (dialog, which) -> answer.offer(""))
+                  .show();
+            });
+    try {
+      final String pin = answer.poll(2, TimeUnit.MINUTES);
+      return pin == null || pin.isEmpty() ? null : pin;
+    } catch (final InterruptedException e) {
+      Thread.currentThread().interrupt();
+      return null;
+    }
+  }
+
+  /**
+   * Maps CTAP2 status codes (spec section 6.1) and transport failures to the WebAuthn error names
+   * Gecko's AndroidWebAuthnService understands. Presence/consent failures map to NOT_ALLOWED_ERR
+   * per the WebAuthn spec.
+   */
+  private static WebAuthnUtils.Exception mapError(final Throwable ex) {
+    final int status = ex instanceof Ctap2Error ? ((Ctap2Error) ex).getCtapStatus() : 0;
+    switch (status) {
+      case 0x11: // CBOR_UNEXPECTED_TYPE
+      case 0x12: // INVALID_CBOR
+      case 0x14: // MISSING_PARAMETER
+        return new WebAuthnUtils.Exception("ENCODING_ERR");
+      case 0x16: // UNSUPPORTED_EXTENSION
+      case 0x26: // UNSUPPORTED_ALGORITHM
+      case 0x2B: // UNSUPPORTED_OPTION
+      case 0x2C: // INVALID_OPTION
+      case 0x39: // REQUEST_TOO_LARGE
+        return new WebAuthnUtils.Exception("NOT_SUPPORTED_ERR");
+      case 0x19: // CREDENTIAL_EXCLUDED (already registered)
+        return new WebAuthnUtils.Exception("INVALID_STATE_ERR");
+      case 0x2E: // NO_CREDENTIALS
+      case 0x2D: // KEEPALIVE_CANCEL
+      case 0x27: // OPERATION_DENIED
+        return new WebAuthnUtils.Exception("NOT_ALLOWED_ERR");
+      case 0x2F: // USER_ACTION_TIMEOUT
+      case 0x3A: // ACTION_TIMEOUT
+        return new WebAuthnUtils.Exception("TIMEOUT_ERR");
+      default:
+        // WebAuthn spec reserves NotAllowedError for user refusal/policy; a transport or host
+        // failure is a NetworkError ("the authenticator ran into trouble"). Misrouting it as
+        // NOT_ALLOWED_ERR told users "you denied permission" when OUR channel setup failed
+        // (observed 2026-11-08: probe-before-INIT bug surfaced as that mislabel).
+        Log.w(LOGTAG, "security key failure: " + ex.getMessage());
+        return new WebAuthnUtils.Exception("NETWORK_ERR");
+    }
+  }
+
+  // ---------------------------------------------------------------- activity tracking
+
+  /**
+   * Tracks the resumed Activity from the application context: NFC reader mode and the
+   * permission/attach receivers are scoped to it. Registered lazily, once, on the main thread.
+   */
+  private static void ensureActivityTracking() {
+    if (sLifecycleHooked) {
+      return;
+    }
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    if (!(ctx instanceof Application)) {
+      return;
+    }
+    ((Application) ctx)
+        .registerActivityLifecycleCallbacks(
+            new Application.ActivityLifecycleCallbacks() {
+              @Override
+              public void onActivityResumed(final Activity activity) {
+                sResumedActivity = new WeakReference<>(activity);
+              }
+
+              @Override
+              public void onActivityPaused(final Activity activity) {
+                final Activity tracked = sResumedActivity.get();
+                if (tracked == activity) {
+                  sResumedActivity = new WeakReference<>(null);
+                }
+              }
+
+              @Override
+              public void onActivityCreated(
+                  final Activity activity, final android.os.Bundle savedInstanceState) {}
+
+              @Override
+              public void onActivityStarted(final Activity activity) {}
+
+              @Override
+              public void onActivityStopped(final Activity activity) {}
+
+              @Override
+              public void onActivitySaveInstanceState(
+                  final Activity activity, final android.os.Bundle outState) {}
+
+              @Override
+              public void onActivityDestroyed(final Activity activity) {}
+            });
+    sLifecycleHooked = true;
+  }
+
+  // ---------------------------------------------------------------- capabilities
+
+  /*
+   * CTAP2 gives the client exactly one authoritative answer about what a key supports:
+   * authenticatorGetInfo (spec section 5.4). Every option in a makeCredential (key 7) or
+   * getAssertion (key 5) request must be one the key declared in that report; an option the key
+   * did not declare is rejected with UNSUPPORTED_OPTION (0x2B) / INVALID_OPTION (0x2C), which is
+   * how the 2026-11-08 "Operation is not supported" report surfaced: makeCredential died with
+   * 0x2C because we sent options we had guessed at instead of asking the key.
+   */
+
+  /** The capability report from authenticatorGetInfo (spec section 5.4). */
+  static final class KeyInfo {
+    final List<String> versions = new ArrayList<>();
+    final List<Integer> pinUvAuthProtocols = new ArrayList<>();
+    final Set<String> declaredOptions = new HashSet<>();
+  }
+
+  /** Probes the key. GetInfo is mandatory for CTAP2 keys (spec 5.4); asking is not guessing. */
+  static KeyInfo fetchKeyInfo(final Ctap2Session session) {
+    final byte[] body = session.send(Ctap2Session.CTAP_GET_INFO, Ctap2Session.CBOR_EMPTY_MAP);
+    final CBORObject root = CBORObject.DecodeFromBytes(body);
+    final KeyInfo info = new KeyInfo();
+    final CBORObject versions = root.get(CBORObject.FromObject(1));
+    if (versions != null && versions.getType() == CBORType.Array) {
+      for (int i = 0; i < versions.size(); i++) {
+        info.versions.add(versions.get(i).AsString());
+      }
+    }
+    final CBORObject options = root.get(CBORObject.FromObject(4));
+    if (options != null && options.getType() == CBORType.Map) {
+      for (final CBORObject name : options.getKeys()) {
+        if (options.get(name).isTrue()) {
+          info.declaredOptions.add(name.AsString());
+        }
+      }
+    }
+    final CBORObject pinProtocols = root.get(CBORObject.FromObject(5));
+    if (pinProtocols != null && pinProtocols.getType() == CBORType.Array) {
+      for (int i = 0; i < pinProtocols.size(); i++) {
+        info.pinUvAuthProtocols.add(Integer.valueOf(pinProtocols.get(i).AsInt32()));
+      }
+    }
+    if (info.versions.isEmpty()) {
+      throw new Ctap2Error("the security key sent an unusable authenticatorGetInfo response");
+    }
+    return info;
+  }
+
+  /**
+   * makeCredential options (CTAP2 key 7): only rk/uv the relying party asked for AND the key
+   * declared. "up" is never sent (normative true; conformance clients omit it).
+   */
+  static Map<String, Boolean> makeCredentialOptions(
+      final boolean residentKeyRequested,
+      final boolean userVerificationRequired,
+      final KeyInfo info) {
+    if (residentKeyRequested) {
+      requireDeclared(info, "rk", "discoverable (resident) credentials");
+    }
+    if (userVerificationRequired) {
+      requireDeclared(info, "uv", "user verification (PIN or biometric)");
+    }
+    final Map<String, Boolean> options = new LinkedHashMap<>();
+    if (residentKeyRequested) {
+      options.put("rk", Boolean.TRUE);
+    }
+    if (userVerificationRequired) {
+      options.put("uv", Boolean.TRUE);
+    }
+    return options.isEmpty() ? null : options;
+  }
+
+  /** getAssertion options (CTAP2 key 5): uv only when required by the RP and declared by the key. */
+  static Map<String, Boolean> assertionOptions(
+      final boolean userVerificationRequired, final KeyInfo info) {
+    if (!userVerificationRequired) {
+      return null;
+    }
+    requireDeclared(info, "uv", "user verification (PIN or biometric)");
+    final Map<String, Boolean> options = new LinkedHashMap<>();
+    options.put("uv", Boolean.TRUE);
+    return options;
+  }
+
+  private static void requireDeclared(
+      final KeyInfo info, final String option, final String what) {
+    if (!info.declaredOptions.contains(option)) {
+      // Status 0x2B (UNSUPPORTED_OPTION): the web seam must surface NotSupportedError naming the
+      // missing capability, not the old generic rejection.
+      throw new Ctap2Error(
+          "the security key does not support "
+              + what
+              + " (it did not declare options."
+              + option
