+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+/**
+ * A bound CTAP2 channel, transport-agnostic. {@link #prepare()} makes the FIDO2 authenticator
+ * reachable (NFC: applet select; USB: CTAPHID channel allocation). {@link #send(int, byte[])} runs
+ * one CTAP2 command — {@link #CTAP_MAKE_CREDENTIAL} or {@link #CTAP_GET_ASSERTION} — and returns
+ * the CBOR response body when the CTAP status is 0x00, otherwise throws {@link Ctap2Error} with the
+ * CTAP status code.
+ *
+ * <p>Ported (Java) from the Proton Mail fork's fido-nfc module; the command byte is generalized so
+ * the same session can run makeCredential (0x01) as well as getAssertion (0x02), which the
+ * browser needs for credential enrollment.
+ */
+public interface Ctap2Session {
+  /** authenticatorMakeCredential (CTAP2 spec section 5.1). */
+  int CTAP_MAKE_CREDENTIAL = 0x01;
+  /** authenticatorGetAssertion (CTAP2 spec section 5.2). */
+  int CTAP_GET_ASSERTION = 0x02;
+
+  /** Makes the authenticator reachable. Returns false when the key cannot be prepared. */
+  boolean prepare() throws Ctap2Error;
+
+  /**
+   * Runs a CTAP2 command on this session.
+   *
+   * @param ctapCmd the CTAP2 command byte ({@link #CTAP_MAKE_CREDENTIAL} or {@link
+   *     #CTAP_GET_ASSERTION})
+   * @param cborPayload the canonical CBOR request parameters
+   * @return the CBOR response body (CTAP status was 0x00)
+   * @throws Ctap2Error when the key reported a non-zero CTAP status or the transport failed
+   */
+  byte[] send(int ctapCmd, byte[] cborPayload) throws Ctap2Error;
+
+  /** Releases the transport (idempotent). */
+  void close();
+}
