index 0000000000..8e6c938d7e
--- /dev/null
+++ b/mobile/android/geckoview/src/main/java/org/mozilla/gecko/ctap2/Ctap2Cbor.java
@@ -0,0 +1,409 @@
+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+import com.upokecenter.cbor.CBOREncodeOptions;
+import com.upokecenter.cbor.CBORObject;
+import com.upokecenter.cbor.CBORType;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Minimal CBOR codec for the two CTAP2 commands the browser needs, per the CTAP2 spec's normative
+ * examples. Encode uses {@code DefaultCtap2Canonical} (canonical map-key order, minimal integer
+ * forms) as required for requests.
+ *
+ * <p>getAssertion (0x02) request (map, integer keys):
+ *
+ * <pre>
+ *   1  rpId            text, REQUIRED
+ *   2  clientDataHash  bytes, REQUIRED
+ *   3  allowList       array of { "type": "public-key", "id": bytes }, optional  (TEXT keys!)
+ *   4  extensions      map { "appid": text }, optional
+ *   5  options         map { "up": true, "uv"?: true }, optional
+ * </pre>
+ *
+ * getAssertion response (map): 1=credential (INTEGER key 1 holding a TEXT-keyed descriptor
+ * {"id": bytes, "type": "public-key"}), 2=authData, 3=signature, 4=user, 5=numberOfCredentials.
+ *
+ * <p>makeCredential (0x01) request (map):
+ *
+ * <pre>
+ *   1  clientDataHash   bytes, REQUIRED
+ *   2  rp               map { 1: id, 2: name }
+ *   3  user             map { 1: id (bytes), 2: name, 3: displayName }
+ *   4  pubKeyCredParams array of { 1: "public-key", 2: alg }
+ *   5  excludeList      array of { 1: "public-key", 2: id }, optional  (INTEGER keys!)
+ *   6  options          map { "up": true, "rk"?: bool, "uv"?: bool }
+ * </pre>
+ *
+ * makeCredential response (map): 1=fmt, 2=attStmt, 3=attObj.
+ *
+ * <p>The CBOR key-type asymmetry above is deliberate and spec-mandated: allowList entries use text
+ * keys while excludeList and pubKeyCredParams entries use integer keys. Verified against the real
+ * com.upokecenter:cbor 4.5.6 codec (20/20 checks in the Phase-2 harness).
+ *
+ * <p>Ported (Java) from the Proton Mail fork's fido-nfc module with the makeCredential half added.
+ */
+public final class Ctap2Cbor {
+
+  private static final CBOREncodeOptions CTAP2_CANONICAL =
+      CBOREncodeOptions.DefaultCtap2Canonical;
+
+  private Ctap2Cbor() {}
+
+  /** One entry of a getAssertion allowList / makeCredential excludeList. */
+  public static final class CredentialId {
+    public final byte[] id;
+
+    public CredentialId(final byte[] id) {
+      this.id = id;
+    }
+  }
+
+  /** One pubKeyCredParams entry: algorithm identifier (e.g. -7 = ES256). */
+  public static final class PublicKeyCredParam {
+    public final int alg;
+
+    public PublicKeyCredParam(final int alg) {
+      this.alg = alg;
+    }
+  }
+
+  /** Decoded authenticatorGetAssertion response. */
+  public static final class GetAssertionResponse {
+    public final byte[] credentialId;
+    public final byte[] authenticatorData;
+    public final byte[] signature;
+    /** The key's user handle (map key 4, "id") when present; otherwise null. */
+    public final byte[] userHandle;
+
+    GetAssertionResponse(
+        final byte[] credentialId,
+        final byte[] authenticatorData,
+        final byte[] signature,
+        final byte[] userHandle) {
+      this.credentialId = credentialId;
+      this.authenticatorData = authenticatorData;
+      this.signature = signature;
+      this.userHandle = userHandle;
+    }
+  }
+
+  /** Decoded authenticatorMakeCredential response (CTAP2 section 5.1). */
+  public static final class MakeCredentialResponse {
+    public final String fmt;
+    /** Raw authenticator data (binary): rpIdHash(32) flags(1) signCount(4) [aaguid(16) credIdLen(2) credId ...]. */
+    public final byte[] authData;
+    /**
+     * The [WebAuthn] attestation object — a CBOR map with TEXT keys { authData, fmt, attStmt } —
+     * which is what the Gecko (auth-rs) parser expects, NOT the raw CTAP2 response envelope.
+     */
+    public final byte[] attestationObject;
+
+    MakeCredentialResponse(
+        final String fmt, final byte[] authData, final byte[] attestationObject) {
+      this.fmt = fmt;
+      this.authData = authData;
+      this.attestationObject = attestationObject;
+    }
+  }
+
+  /**
+   * Encodes authenticatorGetAssertion (CTAP2 spec section 5.2). {@code clientDataHash} must be the
+   * SHA-256 of the clientDataJSON the relying party received. {@code appId} (the legacy FIDO
+   * AppID extension) is sent as the "appid" extension when non-null; per WebAuthn L2 section 10.1
+   * the caller must also have substituted the AppID for rpId.
+   *
+   * <p>Options are caller-composed from the key's authenticatorGetInfo report — the encoder never
+   * invents any. "up" is normative true and is not sent (conformance clients do not send it); an
+   * option the key did not declare gets the request rejected with 0x2B/0x2C. Null/empty omits the
+   * options parameter entirely (spec defaults).
+   */
+  public static byte[] encodeGetAssertion(
+      final String rpId,
+      final byte[] clientDataHash,
+      final List<CredentialId> allowCredentials,
+      final String appId,
+      final Map<String, Boolean> options) {
+    return encodeGetAssertion(rpId, clientDataHash, allowCredentials, appId, options, null);
+  }
+
+  /**
+   * Same request with an optional pinUvAuthParam: after a ClientPIN handshake the platform retries
+   * with key 6 = pinAuth (16-byte HMAC over the clientDataHash) and key 7 = pinUvAuthProtocol id
+   * (auth-rs get_assertion.rs keys 6/7 — the PIN_REQUIRED 0x36 retry path).
+   */
+  public static byte[] encodeGetAssertion(
+      final String rpId,
+      final byte[] clientDataHash,
+      final List<CredentialId> allowCredentials,
+      final String appId,
+      final Map<String, Boolean> options,
+      final byte[] pinAuth) {
+    final CBORObject map = CBORObject.NewMap();
+    map.Add(CBORObject.FromObject(1), CBORObject.FromObject(rpId));
+    map.Add(CBORObject.FromObject(2), CBORObject.FromObject(clientDataHash));
+    if (allowCredentials != null && !allowCredentials.isEmpty()) {
+      final CBORObject arr = CBORObject.NewArray();
+      for (final CredentialId cred : allowCredentials) {
+        // allowList descriptors use TEXT keys (spec examples; WebAuthn 5.8.3).
+        final CBORObject desc = CBORObject.NewMap();
+        desc.Add(CBORObject.FromObject("type"), CBORObject.FromObject("public-key"));
+        desc.Add(CBORObject.FromObject("id"), CBORObject.FromObject(cred.id));
+        arr.Add(desc);
+      }
+      map.Add(CBORObject.FromObject(3), arr);
+    }
+    if (appId != null && !appId.isEmpty()) {
+      final CBORObject ext = CBORObject.NewMap();
+      ext.Add(CBORObject.FromObject("appid"), CBORObject.FromObject(appId));
+      map.Add(CBORObject.FromObject(4), ext);
+    }
+    if (options != null && !options.isEmpty()) {
+      final CBORObject opts = CBORObject.NewMap();
+      for (final Map.Entry<String, Boolean> option : options.entrySet()) {
+        opts.Add(CBORObject.FromObject(option.getKey()),
+            CBORObject.FromObject(option.getValue().booleanValue()));
+      }
+      map.Add(CBORObject.FromObject(5), opts);
+    }
+    if (pinAuth != null) {
+      map.Add(CBORObject.FromObject(6), CBORObject.FromObject(pinAuth));
+      map.Add(CBORObject.FromObject(7), CBORObject.FromObject(1)); // pinUvAuthProtocol id
+    }
+    return map.EncodeToBytes(CTAP2_CANONICAL);
+  }
+
+  /**
+   * Decodes the authenticatorGetAssertion response. Response key 1 (credential) is an INTEGER key
+   * holding a TEXT-keyed descriptor — the classic CBOR key-type trap. It may be absent (e.g. a
+   * single-credential allowList response); the id is then recovered from {@code
+   * allowCredentials} when exactly one was allowed.
+   */
+  public static GetAssertionResponse decodeGetAssertion(
+      final byte[] bytes, final List<CredentialId> allowCredentials) {
+    final CBORObject map = CBORObject.DecodeFromBytes(bytes);
+    // Key 1 is the selected credential: CTAP2 5.2 defines it as a single
+    // PublicKeyCredentialDescriptor (a TEXT-keyed map { "id": <bytes>, "type": ... }), but a few
+    // authenticators emit an ARRAY of descriptors, and a device-resident credential may omit the
+    // key entirely. Handle all three defensively.
+    CBORObject credentialId = null;
+    final CBORObject credObj = map.get(1);
+    if (credObj != null) {
+      if (credObj.getType() == CBORType.Array && credObj.size() > 0) {
+        credentialId = credObj.get(0).get("id");
+      } else if (credObj.getType() == CBORType.Map) {
+        credentialId = credObj.get("id");
+      }
+    }
+    if (credentialId == null
+        && allowCredentials != null
+        && allowCredentials.size() == 1) {
+      credentialId = CBORObject.FromObject(allowCredentials.get(0).id);
+    }
+    if (credentialId == null) {
+      throw new IllegalStateException("CTAP2 response missing credential (key 1)");
+    }
+    byte[] userHandle = null;
+    final CBORObject userObj = map.get(4);
+    if (userObj != null && userObj.getType() == CBORType.Map) {
+      // The user entity's id is a byte string under the text key "id" (WebAuthn
+      // PublicKeyCredentialUserEntity); integer key 1 is the CTAP2 wire form.
+      final CBORObject uid =
+          userObj.get("id") != null ? userObj.get("id") : userObj.get(1);
+      if (uid != null && uid.getType() == CBORType.ByteString) {
+        userHandle = uid.GetByteString();
+      }
+    }
+    return new GetAssertionResponse(
+        asBytes(credentialId, "credential.id"),
+        asBytes(map.get(2), "authData"),
+        asBytes(map.get(3), "signature"),
+        userHandle);
+  }
+
+  /**
+   * Encodes authenticatorMakeCredential (CTAP2 spec section 5.1). {@code clientDataHash} must be
+   * the SHA-256 of the clientDataJSON. Top-level CTAP2 parameters use INTEGER keys (1..7); the
+   * nested [WebAuthn] structures (rp, user, credential descriptors, pubKeyCredParams entries)
+   * use TEXT keys. "up" is always true; "rk" is sent only when the request asks for a resident
+   * (discoverable) credential, and "uv" only when user verification is required — an unrequested
+   * option risks CTAP2_ERR_UNSUPPORTED_OPTION.
+   */
+  public static byte[] encodeMakeCredential(
+      final byte[] clientDataHash,
+      final String rpId,
+      final String rpName,
+      final byte[] userId,
+      final String userName,
+      final String userDisplayName,
+      final List<PublicKeyCredParam> pubKeyCredParams,
+      final List<CredentialId> excludeList,
+      final Map<String, Boolean> options) {
+    return encodeMakeCredential(
+        clientDataHash, rpId, rpName, userId, userName, userDisplayName, pubKeyCredParams,
+        excludeList, options, null);
+  }
+
+  /**
+   * Same request with an optional pinUvAuthParam: key 8 = pinAuth, key 9 = pinUvAuthProtocol id
+   * (auth-rs make_credentials.rs keys 8/9 — the PIN_REQUIRED 0x36 retry path).
+   */
+  public static byte[] encodeMakeCredential(
+      final byte[] clientDataHash,
+      final String rpId,
+      final String rpName,
+      final byte[] userId,
+      final String userName,
+      final String userDisplayName,
+      final List<PublicKeyCredParam> pubKeyCredParams,
+      final List<CredentialId> excludeList,
+      final Map<String, Boolean> options,
+      final byte[] pinAuth) {
+    final CBORObject map = CBORObject.NewMap();
+    map.Add(CBORObject.FromObject(1), CBORObject.FromObject(clientDataHash));
+
+    final CBORObject rp = CBORObject.NewMap();
+    rp.Add(CBORObject.FromObject("id"), CBORObject.FromObject(rpId));
+    if (rpName != null && !rpName.isEmpty()) {
+      rp.Add(CBORObject.FromObject("name"), CBORObject.FromObject(rpName));
+    }
+    map.Add(CBORObject.FromObject(2), rp);
+
+    final CBORObject user = CBORObject.NewMap();
+    user.Add(CBORObject.FromObject("id"), CBORObject.FromObject(userId));
+    if (userName != null && !userName.isEmpty()) {
+      user.Add(CBORObject.FromObject("name"), CBORObject.FromObject(userName));
+    }
+    if (userDisplayName != null && !userDisplayName.isEmpty()) {
+      user.Add(CBORObject.FromObject("displayName"), CBORObject.FromObject(userDisplayName));
+    }
+    map.Add(CBORObject.FromObject(3), user);
+
+    final CBORObject params = CBORObject.NewArray();
+    for (final PublicKeyCredParam p : pubKeyCredParams) {
+      // pubKeyCredParams entries use TEXT keys (PublicKeyCredentialParameters, [WebAuthn] 5.8).
+      final CBORObject entry = CBORObject.NewMap();
+      entry.Add(CBORObject.FromObject("type"), CBORObject.FromObject("public-key"));
+      entry.Add(CBORObject.FromObject("alg"), CBORObject.FromObject(p.alg));
+      params.Add(entry);
+    }
+    map.Add(CBORObject.FromObject(4), params);
+
+    if (excludeList != null && !excludeList.isEmpty()) {
+      final CBORObject arr = CBORObject.NewArray();
+      for (final CredentialId cred : excludeList) {
+        // excludeList descriptors use TEXT keys (PublicKeyCredentialDescriptor, [WebAuthn] 5.8.3)
+        // — same shape as allowList entries.
+        final CBORObject entry = CBORObject.NewMap();
+        entry.Add(CBORObject.FromObject("type"), CBORObject.FromObject("public-key"));
+        entry.Add(CBORObject.FromObject("id"), CBORObject.FromObject(cred.id));
+        arr.Add(entry);
+      }
+      map.Add(CBORObject.FromObject(5), arr);
+    }
+
+    if (options != null && !options.isEmpty()) {
+      // Options are caller-composed from the key's GetInfo report; "up" is normative and not sent.
+      final CBORObject opts = CBORObject.NewMap();
+      for (final Map.Entry<String, Boolean> option : options.entrySet()) {
+        opts.Add(CBORObject.FromObject(option.getKey()),
+            CBORObject.FromObject(option.getValue().booleanValue()));
+      }
+      map.Add(CBORObject.FromObject(7), opts);
+    }
+    if (pinAuth != null) {
+      map.Add(CBORObject.FromObject(8), CBORObject.FromObject(pinAuth));
+      map.Add(CBORObject.FromObject(9), CBORObject.FromObject(1)); // pinUvAuthProtocol id
+    }
+    return map.EncodeToBytes(CTAP2_CANONICAL);
+  }
+
+  /**
+   * authenticatorClientPIN (0x06) GetKeyAgreement sub-request for pinUvAuthProtocol 1: {@code
+   * {1: 1, 2: 0x02}}. Message shapes mirror the production Rust client (auth-rs client_pin.rs):
+   * optional keys are omitted, not nulled.
+   */
+  public static byte[] encodeClientPinGetKeyAgreement() {
+    final CBORObject map = CBORObject.NewMap();
+    map.Add(CBORObject.FromObject(1), CBORObject.FromObject(1)); // pinUvAuthProtocol 1
+    map.Add(CBORObject.FromObject(2), CBORObject.FromObject(2)); // subCommand GetKeyAgreement
+    return map.EncodeToBytes(CTAP2_CANONICAL);
+  }
+
+  /**
+   * authenticatorClientPIN GetPinToken sub-request: {@code {1: 1, 2: 0x05, 3: platformKeyAgreement
+   * (COSE EC2 map), 6: pinHashEnc (AES-256-CBC of the 16-byte pin hash)}}.
+   */
+  public static byte[] encodeClientPinGetPinToken(
+      final CBORObject platformKeyAgreement, final byte[] pinHashEnc) {
+    final CBORObject map = CBORObject.NewMap();
+    map.Add(CBORObject.FromObject(1), CBORObject.FromObject(1));
+    map.Add(CBORObject.FromObject(2), CBORObject.FromObject(5)); // subCommand GetPinToken (spec 5.5.7; 0x03 is setPIN)
+    map.Add(CBORObject.FromObject(3), platformKeyAgreement);
+    map.Add(CBORObject.FromObject(6), CBORObject.FromObject(pinHashEnc));
+    return map.EncodeToBytes(CTAP2_CANONICAL);
+  }
+
+  /** GetKeyAgreement response: key 1 is the authenticator's keyAgreement COSE EC2 map. */
+  public static CBORObject decodeClientPinKeyAgreement(final byte[] bytes) {
+    final CBORObject ka = CBORObject.DecodeFromBytes(bytes).get(1);
+    if (ka == null || ka.getType() != CBORType.Map) {
+      throw new IllegalStateException("ClientPIN response missing keyAgreement map");
+    }
+    return ka;
+  }
+
+  /** GetPinToken response: key 2 is pinTokenEnc, an AES-256-CBC encrypted pinToken. */
+  public static byte[] decodeClientPinPinTokenEnc(final byte[] bytes) {
+    final CBORObject enc = CBORObject.DecodeFromBytes(bytes).get(2);
+    if (enc == null || enc.getType() != CBORType.ByteString) {
+      throw new IllegalStateException("ClientPIN response missing pinTokenEnc bytes");
+    }
+    return enc.GetByteString();
+  }
+
+  /**
+   * Decodes the authenticatorMakeCredential response. The raw CTAP2 (section 5.1) envelope uses
+   * INTEGER keys: 1=fmt (text), 2=authData (byte string), 3=attStmt (a CBOR map). That envelope is
+   * NOT what Gecko's (auth-rs) parser consumes — it expects the [WebAuthn] attestation object, a
+   * map with TEXT keys { authData, fmt, attStmt }. This decodes the raw envelope and re-encodes the
+   * WebAuthn object, mirroring what the GMS FIDO client handed to Gecko. The caller recovers the
+   * credentialId from {@link MakeCredentialResponse#authData}.
+   */
+  public static MakeCredentialResponse decodeMakeCredential(final byte[] bytes) {
+    final CBORObject map = CBORObject.DecodeFromBytes(bytes);
+    final CBORObject fmt = map.get(1);
+    final CBORObject authData = map.get(2);
+    final CBORObject attStmt = map.get(3);
+    if (fmt == null || authData == null || attStmt == null) {
+      throw new IllegalStateException("CTAP2 makeCredential response missing fmt/authData/attStmt");
+    }
+    final byte[] authDataBytes = asBytes(authData, "authData");
+    final String fmtString = fmt.AsString();
+
+    // Re-encode as the [WebAuthn] attestation object (TEXT keys) Gecko/auth-rs expects.
+    final CBORObject attObj = CBORObject.NewMap();
+    attObj.Add(CBORObject.FromObject("authData"), CBORObject.FromObject(authDataBytes));
+    attObj.Add(CBORObject.FromObject("fmt"), CBORObject.FromObject(fmtString));
+    attObj.Add(CBORObject.FromObject("attStmt"), attStmt);
+    final byte[] attestationObject = attObj.EncodeToBytes(CTAP2_CANONICAL);
+    return new MakeCredentialResponse(fmtString, authDataBytes, attestationObject);
+  }
+
+  private static byte[] asBytes(final CBORObject item, final String field) {
+    if (item == null) {
+      throw new IllegalStateException("CTAP2 response missing key: " + field);
+    }
+    if (item.getType() == CBORType.ByteString) {
+      return item.GetByteString();
+    }
+    if (item.getType() == CBORType.TextString) {
+      return item.AsString().getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    }
+    throw new IllegalStateException("CTAP2 response field " + field + " is not a byte string");
+  }
+}
