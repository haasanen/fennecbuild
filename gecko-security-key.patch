+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+/**
+ * Transport- or CTAP-level failure of the native FIDO2 flow. {@link #ctapStatus} carries the raw
+ * CTAP2 status byte (spec section 6.1) when the key itself rejected the command, or 0 for
+ * host-side failures. The WebAuthn seam maps these to WebAuthn error names.
+ *
+ * <p>Ported (Java) from the Proton Mail fork's proven fido-nfc module.
+ */
+public class Ctap2Error extends RuntimeException {
+  private final int mCtapStatus;
+
+  public Ctap2Error(final String message) {
+    this(message, 0, null);
+  }
+
+  public Ctap2Error(final String message, final int ctapStatus, final Throwable cause) {
+    super(message, cause);
+    mCtapStatus = ctapStatus;
+  }
+
+  /** The raw CTAP2 status byte, or 0 for host-side failures. */
+  public int getCtapStatus() {
+    return mCtapStatus;
+  }
+}
