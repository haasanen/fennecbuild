+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+/**
+ * Transport- or CTAP-level failure of the native FIDO2 flow. {@link #ctapStatus} carries the raw
+ * CTAP2 status byte (spec section 6.1) when the key itself rejected the command, or 0 for
+ * host-side failures. The WebAuthn seam maps these to WebAuthn error names.
+ *
+ * <p>Ported (Java) from the Proton Mail fork's proven fido-nfc module.
+ */
+public class Ctap2Error extends RuntimeException {
+  private final int mCtapStatus;
+
+  public Ctap2Error(final String message) {
+    this(message, 0, null);
+  }
+
+  public Ctap2Error(final String message, final int ctapStatus, final Throwable cause) {
+    super(message, cause);
+    mCtapStatus = ctapStatus;
+  }
+
+  /** The raw CTAP2 status byte, or 0 for host-side failures. */
+  public int getCtapStatus() {
+    return mCtapStatus;
+  }
+
+  /**
+   * Official name of a CTAP2 status byte (CTAP 2.0 section 6.1 base error values; the table was
+   * taken from the published FIDO Alliance spec, not guessed). Diagnostics only — routing uses
+   * {@link #getCtapStatus()}.
+   */
+  public static String describe(final int status) {
+    switch (status) {
+      case 0x00: return "OK";
+      case 0x11: return "CBOR_UNEXPECTED_TYPE";
+      case 0x12: return "INVALID_CBOR";
+      case 0x14: return "MISSING_PARAMETER";
+      case 0x15: return "LIMIT_EXCEEDED";
+      case 0x16: return "UNSUPPORTED_EXTENSION";
+      case 0x19: return "CREDENTIAL_EXCLUDED";
+      case 0x21: return "PROCESSING";
+      case 0x22: return "INVALID_CREDENTIAL";
+      case 0x23: return "USER_ACTION_PENDING";
+      case 0x24: return "OPERATION_PENDING";
+      case 0x25: return "NO_OPERATIONS";
+      case 0x26: return "UNSUPPORTED_ALGORITHM";
+      case 0x27: return "OPERATION_DENIED";
+      case 0x28: return "KEY_STORE_FULL";
+      case 0x2A: return "NO_OPERATION_PENDING";
+      case 0x2B: return "UNSUPPORTED_OPTION";
+      case 0x2C: return "INVALID_OPTION";
+      case 0x2D: return "KEEPALIVE_CANCEL";
+      case 0x2E: return "NO_CREDENTIALS";
+      case 0x2F: return "USER_ACTION_TIMEOUT";
+      case 0x30: return "NOT_ALLOWED";
+      case 0x31: return "PIN_INVALID";
+      case 0x32: return "PIN_BLOCKED";
+      case 0x33: return "PIN_AUTH_INVALID";
+      case 0x34: return "PIN_AUTH_BLOCKED";
+      case 0x35: return "PIN_NOT_SET";
+      case 0x36: return "PIN_REQUIRED";
+      case 0x37: return "PIN_POLICY_VIOLATION";
+      case 0x38: return "PIN_TOKEN_EXPIRED";
+      case 0x39: return "REQUEST_TOO_LARGE";
+      case 0x3A: return "ACTION_TIMEOUT";
+      case 0x3B: return "UP_REQUIRED";
+      default:
+        if (status >= 0xE0 && status <= 0xEF) {
+          return "EXTENSION_RANGE";
+        }
+        if (status >= 0xF0) {
+          return "VENDOR_RANGE";
+        }
+        return "UNKNOWN";
+    }
+  }
+}
