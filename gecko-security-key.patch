new file mode 100644
index 0000000000..a19bcc44e2
--- /dev/null
+++ b/mobile/android/geckoview/src/test/java/org/mozilla/gecko/ctap2/UsbCtap2LifecycleTest.java
@@ -0,0 +1,187 @@
+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package org.mozilla.gecko.ctap2;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+/**
+ * Lifecycle contract tests driven by a SCRIPTED KEY that enforces the CTAPHID rules itself
+ * (spec 8.1.5.4 + 8.1.9.1.3): a CBOR command on a channel the key never allocated (or has aged
+ * out) is answered with CTAPHID ERROR 0x04 (invalid channel). This is the regression class that
+ * shipped as "USB channel not initialized" + a DOM NotAllowedError on 2026-11-08: a GetInfo probe
+ * rode a probe-time channel the key had already discarded. A self-round-trip through our own
+ * constants could never see it — the scripted peer here allocates its OWN CIDs and derives its own
+ * error responses.
+ */
+@RunWith(RobolectricTestRunner.class)
+public class UsbCtap2LifecycleTest {
+
+  /** Minimal CTAPHID key: fresh CID on every INIT, nonce echo, ERROR 0x04 on unknown channels. */
+  private static final class FakeKey implements UsbCtap2Transport.ReportIo {
+    static final int BROADCAST = 0xFFFFFFFF;
+    static final int INIT = 0x06;
+    static final int ERROR = 0x3F;
+    static final int CBOR = 0x10;
+
+    final List<String> observed = new ArrayList<>();
+    final Set<Integer> active = new HashSet<>();
+    int nextCid = 0x11111111;
+    boolean echo = true;
+    byte[] cborBody = new byte[] {0x00, (byte) 0xA0}; // status OK + empty CBOR map
+
+    private final Deque<ByteBuffer> out = new ArrayDeque<>();
+    private ByteBuffer collected;
+    private int cid;
+    private int bcnt;
+    private byte cmd;
+
+    @Override
+    public boolean send(final ByteBuffer packet) {
+      final ByteBuffer p = packet.duplicate();
+      p.rewind();
+      final int pcid = p.getInt();
+      final int header = p.get() & 0xFF;
+      if ((header & 0x80) != 0) {
+        bcnt = ((p.get() & 0xFF) << 8) | (p.get() & 0xFF);
+        cmd = (byte) (header & 0x7F);
+        cid = pcid;
+        collected = ByteBuffer.allocate(bcnt);
+      }
+      while (collected.hasRemaining() && p.hasRemaining()) {
+        collected.put(p.get());
+      }
+      if (!collected.hasRemaining()) {
+        respond();
+      }
+      return true;
+    }
+
+    private void respond() {
+      final byte[] payload = new byte[bcnt];
+      collected.rewind();
+      collected.get(payload);
+      observed.add(Integer.toHexString(cid) + ":" + Integer.toHexString(cmd & 0xFF));
+      if (cmd == INIT) {
+        final int newCid = echo ? nextCid++ : 0x55555555;
+        if (echo) {
+          active.add(newCid);
+        }
+        final ByteBuffer r = report(BROADCAST, INIT | 0x80, 17);
+        for (int i = 0; i < 8; i++) {
+          r.put(echo ? payload[i] : (byte) (payload[i] ^ 0xFF));
+        }
+        r.putInt(newCid);
+        r.put((byte) 0x05); // CTAPHID protocol version
+        r.put(new byte[] {0x04, 0x7F, 0x23}); // device version (placeholder)
+        r.put((byte) 0x04); // capabilities: CBOR
+        out.add(finish(r));
+      } else if (cmd == CBOR && !active.contains(cid)) {
+        final ByteBuffer r = report(cid, ERROR | 0x80, 1);
+        r.put((byte) 0x04); // CHANNEL_ERR: never allocated / aged out — the shipped bug witness
+        out.add(finish(r));
+      } else if (cmd == CBOR) {
+        final ByteBuffer r = report(cid, CBOR | 0x80, cborBody.length);
+        r.put(cborBody);
+        out.add(finish(r));
+      } else {
+        final ByteBuffer r = report(cid, ERROR | 0x80, 1);
+        r.put((byte) 0x01);
+        out.add(finish(r));
+      }
+    }
+
+    @Override
+    public ByteBuffer recvReport() {
+      return out.poll();
+    }
+
+    void forget() {
+      active.clear();
+    }
+
+    private static ByteBuffer report(final int reportCid, final int cmdByte, final int total) {
+      final ByteBuffer b = ByteBuffer.allocate(64);
+      b.putInt(reportCid);
+      b.put((byte) cmdByte);
+      b.put((byte) (total >> 8));
+      b.put((byte) (total & 0xFF));
+      return b;
+    }
+
+    private static ByteBuffer finish(final ByteBuffer b) {
+      b.rewind();
+      final ByteBuffer copy = ByteBuffer.allocate(64);
+      copy.put(b);
+      copy.rewind();
+      return copy;
+    }
+  }
+
+  @Test
+  public void cborCommandOnFreshTransportAllocatesChannelFirst() throws Exception {
+    final UsbCtap2Transport transport = new UsbCtap2Transport();
+    final FakeKey key = new FakeKey();
+    // Fresh transport holds NO channel — exactly the state bindDevice probing now leaves behind.
+    final byte[] body =
+        transport.sendCtapCommandIo(key, 0x04 /* GetInfo */, new byte[] {(byte) 0xA0});
+    assertEquals(
+        "the scripted key must see INIT before any CBOR",
+        "[ffffffff:6, 11111111:10]",
+        key.observed.toString());
+    assertArrayEquals(new byte[] {(byte) 0xA0}, body);
+  }
+
+  @Test
+  public void eachInitAllocatesItsOwnFreshChannel() throws Exception {
+    final UsbCtap2Transport transport = new UsbCtap2Transport();
+    final FakeKey key = new FakeKey();
+    assertTrue(transport.initializeIo(key));
+    final int first = transport.channelForTest();
+    assertEquals(0x11111111, first);
+    assertTrue(transport.initializeIo(key));
+    assertTrue("second INIT must yield a DIFFERENT channel", transport.channelForTest() != first);
+    assertEquals(0x11111112, transport.channelForTest()); // scripted key allocates a fresh CID each INIT
+  }
+
+  @Test
+  public void cborOnChannelKeyDiscardedSurfacesNamedError() throws Exception {
+    final UsbCtap2Transport transport = new UsbCtap2Transport();
+    final FakeKey key = new FakeKey();
+    assertTrue(transport.initializeIo(key));
+    key.forget(); // the key ages the channel out — legal per spec 8.1.5.4
+    try {
+      transport.sendCtapCommandIo(key, 0x04, new byte[] {(byte) 0xA0});
+      fail("expected Ctap2Error");
+    } catch (final Ctap2Error e) {
+      assertTrue(
+          "error must be named, never mislabeled: " + e.getMessage(),
+          e.getMessage().contains("CTAPHID error 0x4"));
+    }
+  }
+
+  @Test
+  public void initNonceMismatchIsRejected() {
+    final UsbCtap2Transport transport = new UsbCtap2Transport();
+    final FakeKey key = new FakeKey();
+    key.echo = false; // stale/corrupt INIT response must not win the freshness guard
+    assertFalse(transport.initializeIo(key));
+  }
+}
