+ */
+public final class WebAuthnCtap2 {
+
+  private static final String LOGTAG = "GeckoCtap2";
+
+  private static final String USB_PERMISSION_ACTION = "org.mozilla.gecko.ctap2.USB_PERMISSION";
+  private static final int USB_VENDOR_YUBICO = 0x1050;
