+
+  /**
+   * Arms both transports (or the already-present one) and returns the pending result. First
+   * transport to become available wins; the CTAP2 exchange then runs on a worker thread.
+   */
+  private static <T> GeckoResult<T> start(final Request request) {
+    synchronized (LOCK) {
+      if (sInFlight) {
+        return GeckoResult.fromException(new WebAuthnUtils.Exception("INVALID_STATE_ERR"));
+      }
+      sInFlight = true;
+    }
+    final FlowState flow = new FlowState(request);
