+      return;
+    }
+    // Claim the flow before tearing the arm down: nothing else can win now.
+    if (flow.nfcReader != null) {
+      final Activity activity = sResumedActivity.get();
+      if (activity != null) {
+        flow.nfcReader.stop(activity);
+      }
+    }
