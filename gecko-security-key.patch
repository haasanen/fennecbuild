+/**
+ * In-process FIDO2 ("Security Key") support for Gecko's Android WebAuthn backend, over USB
+ * (CTAPHID) and NFC (ISO-DEP), with no GMS/microG privileged FIDO service.
+ *
+ * <p>Replaces the {@code play-services-fido} PendingIntent flow in {@code WebAuthnTokenManager}:
+ * the challenge is answered directly by a roaming security key.
+ *
+ * <p>Design notes (browser case — differs from the Proton app flow this was ported from):
+ *
+ * <ul>
+ *   <li>Origin/clientDataJSON: the CTAP2 request is signed over {@code clientDataHash}, which
+ *       Gecko itself computes as SHA-256 of the spec-serialized clientDataJSON (with the RP
+ *       origin from the WebAuthn request) and passes into the Java seam. We reuse that hash and
+ *       leave the response's clientDataJson null so Gecko substitutes its own assembled copy —
+ *       no facet/APK-key-hash origin like the app case, and no second serializer to keep in
+ *       sync.
+ *   <li>Both makeCredential (enrollment) and getAssertion (sign-in) are implemented; the
+ *       transport command byte is generalized in the transports for exactly this.
+ *   <li>up is always required; uv is sent only when the request requires it, and rk only when a
+ *       resident credential is requested (an unrequested option risks
+ *       CTAP2_ERR_UNSUPPORTED_OPTION on plain keys).
+ *   <li>Transport selection is automatic and concurrent: a plugged-in USB key and an NFC tap are
+ *       both watched, first-wins; a key attached late is picked up by the attach receiver plus a
+ *       bounded deviceList poll (OS enumeration delay).
+ * </ul>
+ *
+ * <p>Blocking CTAP2 exchanges run on a daemon worker thread; all Android UI-touching steps
+ * (reader mode, permission dialog, receivers) run on the main thread.
+ *
+ * <p>Ported (Java) from the Proton Mail fork's fido-nfc module (GPL-3.0-or-later), with the
+ * browser-specific orchestration rewritten for the GeckoResult seam.
+ */
+public final class WebAuthnCtap2 {
+
+  private static final String LOGTAG = "GeckoCtap2";
+
+  private static final String USB_PERMISSION_ACTION = "org.mozilla.gecko.ctap2.USB_PERMISSION";
+  private static final int USB_VENDOR_YUBICO = 0x1050;
+  private static final long LATE_ATTACH_POLL_INTERVAL_MS = 1_000L;
+  private static final long LATE_ATTACH_WATCH_WINDOW_MS = 60_000L;
+  private static final long USB_GRANT_TIMEOUT_MS = 45_000L;
+  // The single flow that owns the USB permission dialog for the key. A device re-enumeration
+  // (replug) auto-denies every pending system request at once — the resulting broadcast must
+  // not kill a flow that was not the one the user was looking at; and only the owning flow may
+  // act on the result. Guarded by LOCK.
+  private static FlowState sPermissionOwner;
+  // Absolute watchdog for one operation (transport timeouts are shorter).
+  private static final long FLOW_WATCHDOG_MS = 90_000L;
+
+  private static final Object LOCK = new Object();
+  private static boolean sInFlight = false;
+
+  private static WeakReference<Activity> sResumedActivity = new WeakReference<>(null);
+  private static boolean sLifecycleHooked = false;
+
+  /*
+   * The main-thread Handler lives in a holder so touching the pure capability/option logic never
+   * initializes it: the android.jar Looper stub throws during class init on a plain JVM, and the
+   * GetInfo seam must stay unit-testable there (it is policy, not plumbing).
+   */
+  private static final class MainHolder {
+    static final Handler H = new Handler(Looper.getMainLooper());
+  }
+
+  private WebAuthnCtap2() {}
+
+  // ---------------------------------------------------------------- entry points
+
+  /**
+   * Runs authenticatorMakeCredential on a security key (USB or NFC, first one available wins).
+   *
+   * @param clientDataHash SHA-256 of the request's clientDataJSON, as computed by Gecko
+   * @return the MakeCredentialResponse for Gecko; clientDataJson is deliberately null so Gecko
+   *     substitutes its own clientDataJSON
+   */
+  public static GeckoResult<WebAuthnUtils.MakeCredentialResponse> makeCredential(
+      final String rpId,
+      final String rpName,
+      final byte[] userId,
+      final String userName,
+      final String userDisplayName,
+      final byte[] clientDataHash,
+      final List<Ctap2Cbor.PublicKeyCredParam> pubKeyCredParams,
+      final List<Ctap2Cbor.CredentialId> excludeList,
+      final boolean residentKeyRequested,
+      final boolean userVerificationRequired,
+      final boolean reportCredProps) {
+    final Request request = new Request();
+    request.makeCredential = true;
+    request.rpId = rpId;
+    request.rpName = rpName;
+    request.userId = userId;
+    request.userName = userName;
+    request.userDisplayName = userDisplayName;
+    request.clientDataHash = clientDataHash;
+    request.pubKeyCredParams = pubKeyCredParams;
+    request.excludeList = excludeList;
+    request.residentKeyRequested = residentKeyRequested;
+    request.userVerificationRequired = userVerificationRequired;
+    request.reportCredProps = reportCredProps;
+    return start(request);
+  }
+
+  /**
+   * Runs authenticatorGetAssertion on a security key (USB or NFC, first one available wins).
+   *
+   * @param clientDataHash SHA-256 of the request's clientDataJSON, as computed by Gecko
+   */
+  public static GeckoResult<WebAuthnUtils.GetAssertionResponse> getAssertion(
+      final String rpId,
+      final byte[] clientDataHash,
+      final List<Ctap2Cbor.CredentialId> allowList,
+      final String appId,
+      final boolean userVerificationRequired) {
+    final Request request = new Request();
+    request.makeCredential = false;
+    request.rpId = rpId;
+    request.clientDataHash = clientDataHash;
+    request.allowList = allowList;
+    request.appId = appId;
+    request.userVerificationRequired = userVerificationRequired;
+    return start(request);
+  }
+
+  // ---------------------------------------------------------------- flow state
+
+  private static final class Request {
+    boolean makeCredential;
+    String rpId;
+    String rpName;
+    byte[] userId;
+    String userName;
+    String userDisplayName;
+    byte[] clientDataHash;
+    List<Ctap2Cbor.PublicKeyCredParam> pubKeyCredParams;
+    List<Ctap2Cbor.CredentialId> excludeList;
+    List<Ctap2Cbor.CredentialId> allowList;
+    String appId;
+    boolean residentKeyRequested;
+    boolean userVerificationRequired;
+    boolean reportCredProps;
+  }
+
+  private static final class FlowState {
+    final Request request;
+    final GeckoResult<Object> result = new GeckoResult<>();
+    final AtomicBoolean settled = new AtomicBoolean(false);
+    // Claims the single transport worker for this flow (USB and NFC race to claim).
+    final AtomicBoolean transportClaimed = new AtomicBoolean(false);
+    NfcCtap2Transport.NfcReader nfcReader;
+    BroadcastReceiver permissionReceiver;
+    BroadcastReceiver attachReceiver;
+    Runnable grantTimeout;
+    Runnable watchdog;
+    Runnable poll;
+
+    FlowState(final Request request) {
+      this.request = request;
+    }
+
+    void settleSuccess(final Object value) {
+      if (!settled.compareAndSet(false, true)) {
+        return;
+      }
+      cleanup();
+      try {
+        result.complete(value);
+      } catch (final IllegalStateException e) {
+        // Result cancelled by Gecko in the meantime; nothing to deliver.
+        Log.d(LOGTAG, "result already complete at success time");
+      } finally {
+        finish();
+      }
+    }
+
+    void settleError(final WebAuthnUtils.Exception error) {
+      if (!settled.compareAndSet(false, true)) {
+        return;
+      }
+      cleanup();
+      try {
+        result.completeExceptionally(error);
+      } catch (final IllegalStateException e) {
+        // Result cancelled by Gecko in the meantime; nothing to deliver.
+        Log.d(LOGTAG, "result already complete at error time");
+      } finally {
+        finish();
+      }
+    }
+
+    private void finish() {
+      synchronized (LOCK) {
+        sInFlight = false;
+      }
+    }
+
+    void cleanup() {
+      MainHolder.H.removeCallbacks(grantTimeout);
+      MainHolder.H.removeCallbacks(watchdog);
+      MainHolder.H.removeCallbacks(poll);
+      synchronized (LOCK) {
+        if (sPermissionOwner == this) {
+          sPermissionOwner = null;
+        }
+      }
+      final Context ctx = GeckoAppShell.getApplicationContext();
+      if (permissionReceiver != null) {
+        try {
+          ctx.unregisterReceiver(permissionReceiver);
+        } catch (final Exception e) {
+          // already unregistered
+        }
+        permissionReceiver = null;
+      }
+      if (attachReceiver != null) {
+        try {
+          ctx.unregisterReceiver(attachReceiver);
+        } catch (final Exception e) {
+          // already unregistered
+        }
+        attachReceiver = null;
+      }
+      final Activity activity = sResumedActivity.get();
+      if (nfcReader != null && activity != null) {
+        nfcReader.stop(activity);
+      }
+      nfcReader = null;
+    }
+  }
+
+  /**
+   * Arms both transports (or the already-present one) and returns the pending result. First
+   * transport to become available wins; the CTAP2 exchange then runs on a worker thread.
+   */
+  private static <T> GeckoResult<T> start(final Request request) {
+    synchronized (LOCK) {
+      if (sInFlight) {
+        return GeckoResult.fromException(new WebAuthnUtils.Exception("INVALID_STATE_ERR"));
+      }
+      sInFlight = true;
+    }
+    final FlowState flow = new FlowState(request);
+    MainHolder.H.post(
+        () -> {
+          try {
+            arm(flow);
+          } catch (final Exception e) {
+            Log.e(LOGTAG, "failed to arm security-key flow", e);
+            flow.settleError(new WebAuthnUtils.Exception("UNKNOWN_ERR"));
+          }
+        });
+    @SuppressWarnings("unchecked")
+    final GeckoResult<T> typed = (GeckoResult<T>) flow.result;
+    return typed;
+  }
+
+  /** Main thread: fast-path an attached USB key, else arm NFC + late-USB watch. */
+  private static void arm(final FlowState flow) {
+    ensureActivityTracking();
+
+    flow.watchdog = () -> flow.settleError(new WebAuthnUtils.Exception("TIMEOUT_ERR"));
+    MainHolder.H.postDelayed(flow.watchdog, FLOW_WATCHDOG_MS);
+
+    final UsbDevice attached = findUsbSecurityKey();
+    if (attached != null) {
+      if (hasUsbPermission(attached)) {
+        Log.i(LOGTAG, "USB security key attached; using it directly");
+        startUsbFlow(flow, attached);
+      } else {
+        requestUsbPermission(flow, attached);
+      }
+      return;
+    }
+
+    // No key yet: watch NFC and USB at once, first-wins.
+    final Activity activity = sResumedActivity.get();
+    if (activity != null) {
+      final NfcCtap2Transport.NfcReader reader =
+          new NfcCtap2Transport.NfcReader(tag -> onTag(flow, tag));
+      if (reader.start(activity)) {
+        flow.nfcReader = reader;
+      } else {
+        Log.d(LOGTAG, "NFC reader mode unavailable; watching USB only");
+      }
+    } else {
+      Log.d(LOGTAG, "no resumed activity; watching USB only");
+    }
+    startLateUsbWatch(flow);
+  }
+
+  /** NFC binder thread: an IsoDep tag was tapped — USB must not start a second flow. */
+  private static void onTag(final FlowState flow, final Tag tag) {
+    if (flow.settled.get() || flow.transportClaimed.get()) {
+      return;
+    }
+    // Validate BEFORE claiming: a non-IsoDep tap (transit card, badge, misread) must leave
+    // the flow armed so the user can just tap the security key again. Claiming first made
+    // any stray tag permanently kill the attempt.
+    if (android.nfc.tech.IsoDep.get(tag) == null) {
+      Log.i(LOGTAG, "tapped tag is not IsoDep-capable; still waiting for a security key");
+      return;
+    }
+    if (!flow.transportClaimed.compareAndSet(false, true)) {
+      return;
+    }
+    // Reader mode STAYS armed for the whole CTAP2 exchange; it is torn down by
+    // cleanup() when the flow settles. Disabling it at claim time ends the NFCC's
+    // tag session right there (NfcActivityManager.disableReaderMode ->
+    // setReaderMode(token, 0)), so the worker's IsoDep.connect() then fails on the
+    // dead handle, and the still-tapped key is re-dispatched as an ordinary tag:
+    // its NDEF URI record pops the system "open URL?" chooser mid-flow.
+    unregisterAttachReceiver(flow);
+    MainHolder.H.removeCallbacks(flow.poll);
+    MainHolder.H.removeCallbacks(flow.grantTimeout);
