+    worker.start();
+  }
+
+  /** Starts the USB CTAP2 exchange for {@code device} (permission already granted). */
+  private static void startUsbFlow(final FlowState flow, final UsbDevice device) {
+    if (flow.settled.get() || !flow.transportClaimed.compareAndSet(false, true)) {
+      return;
+    }
