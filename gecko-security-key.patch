+    worker.start();
+  }
+
+  /**
+   * Requests USB access through the system dialog. FLAG_UPDATE_CURRENT, never FLAG_NO_CREATE:
+   * with FLAG_NO_CREATE the first call returns a null PendingIntent and the dialog would be
+   * started without a response channel.
+   */
+  @SuppressLint("UnspecifiedRegisterReceiverFlag")
+  private static void requestUsbPermission(final FlowState flow, final UsbDevice device) {
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    final UsbManager usb = (UsbManager) ctx.getSystemService(Context.USB_SERVICE);
+    if (usb == null) {
+      flow.settleError(new WebAuthnUtils.Exception("UNKNOWN_ERR"));
+      return;
+    }
+    final BroadcastReceiver receiver =
+        new BroadcastReceiver() {
+          @Override
+          public void onReceive(final Context c, final Intent intent) {
+            unregisterPermissionReceiver(flow);
+            if (!intent.getBooleanExtra(UsbManager.EXTRA_PERMISSION_GRANTED, false)) {
+              Log.i(LOGTAG, "USB access was not granted");
+              flow.settleError(new WebAuthnUtils.Exception("NOT_ALLOWED_ERR"));
+              return;
+            }
+            Log.i(LOGTAG, "USB access granted; starting USB flow");
+            startUsbFlow(flow, device);
+          }
+        };
+    flow.permissionReceiver = receiver;
+    // FLAG_UPDATE_CURRENT, never FLAG_NO_CREATE (see above).
+    final int piFlags = PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT;
+    final Intent intent = new Intent(USB_PERMISSION_ACTION).setPackage(ctx.getPackageName());
+    final PendingIntent pending = PendingIntent.getBroadcast(ctx, 0, intent, piFlags);
+    final IntentFilter filter = new IntentFilter(USB_PERMISSION_ACTION);
+    final Activity activity = sResumedActivity.get();
+    try {
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+        if (activity != null) {
+          activity.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        } else {
+          ctx.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        }
+      } else if (activity != null) {
+        activity.registerReceiver(receiver, filter);
+      } else {
+        ctx.registerReceiver(receiver, filter);
+      }
+    } catch (final Exception e) {
+      Log.e(LOGTAG, "registerReceiver (USB permission) failed", e);
+    }
+    try {
+      usb.requestPermission(device, pending);
+    } catch (final Exception e) {
+      Log.e(LOGTAG, "requestPermission failed", e);
+      flow.settleError(new WebAuthnUtils.Exception("UNKNOWN_ERR"));
+      return;
+    }
+    flow.grantTimeout =
+        () -> {
+          if (flow.permissionReceiver != null) {
+            Log.i(LOGTAG, "USB permission dialog did not complete in time");
+            flow.settleError(new WebAuthnUtils.Exception("NOT_ALLOWED_ERR"));
+          }
+        };
+    MAIN.postDelayed(flow.grantTimeout, USB_GRANT_TIMEOUT_MS);
+  }
+
+  private static void unregisterPermissionReceiver(final FlowState flow) {
+    MAIN.removeCallbacks(flow.grantTimeout);
+    if (flow.permissionReceiver != null) {
+      try {
+        GeckoAppShell.getApplicationContext().unregisterReceiver(flow.permissionReceiver);
+      } catch (final Exception e) {
+        // already unregistered
+      }
+      flow.permissionReceiver = null;
+    }
+  }
+
+  /**
+   * Arms the late-attach watch so a USB key plugged in after the prompt can still win:
+   * ACTION_USB_DEVICE_ATTACHED (primary) plus a bounded deviceList poll (some devices take
+   * seconds to enumerate). Both stop when a transport wins; the poll stops after the window.
+   */
+  @SuppressLint("UnspecifiedRegisterReceiverFlag")
+  private static void startLateUsbWatch(final FlowState flow) {
+    final BroadcastReceiver receiver =
+        new BroadcastReceiver() {
+          @Override
+          public void onReceive(final Context c, final Intent intent) {
+            final UsbDevice device = getUsbDeviceExtra(intent);
+            if (device == null || device.getVendorId() != USB_VENDOR_YUBICO) {
+              return;
+            }
+            onLateUsbAttach(flow, device);
+          }
+        };
+    flow.attachReceiver = receiver;
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    final IntentFilter filter = new IntentFilter(UsbManager.ACTION_USB_DEVICE_ATTACHED);
+    try {
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+        ctx.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED);
+      } else {
+        ctx.registerReceiver(receiver, filter);
+      }
+    } catch (final Exception e) {
+      Log.e(LOGTAG, "registerReceiver (USB attach) failed", e);
+    }
+    final long startMs = System.currentTimeMillis();
+    flow.poll =
+        new Runnable() {
+          @Override
+          public void run() {
+            if (flow.settled.get()) {
+              return;
+            }
+            final UsbDevice device = findUsbSecurityKey();
+            if (device != null) {
+              onLateUsbAttach(flow, device);
+            } else if (System.currentTimeMillis() - startMs < LATE_ATTACH_WATCH_WINDOW_MS) {
+              MAIN.postDelayed(this, LATE_ATTACH_POLL_INTERVAL_MS);
+            }
+          }
+        };
+    MAIN.postDelayed(flow.poll, LATE_ATTACH_POLL_INTERVAL_MS);
+  }
+
+  /** A YubiKey attached while the flow is active: USB wins the race. */
+  private static void onLateUsbAttach(final FlowState flow, final UsbDevice device) {
+    if (flow.settled.get() || flow.permissionReceiver != null) {
+      // settled already, or a permission dialog is up for this flow already
+      return;
+    }
+    Log.i(LOGTAG, "USB key attached during flow; switching NFC -> USB");
+    final Activity activity = sResumedActivity.get();
+    if (flow.nfcReader != null && activity != null) {
+      flow.nfcReader.stop(activity);
+    }
+    unregisterAttachReceiver(flow);
+    MAIN.removeCallbacks(flow.poll);
+    if (hasUsbPermission(device)) {
+      startUsbFlow(flow, device);
+    } else {
+      requestUsbPermission(flow, device);
+    }
+  }
+
+  private static void unregisterAttachReceiver(final FlowState flow) {
+    if (flow.attachReceiver != null) {
+      try {
+        GeckoAppShell.getApplicationContext().unregisterReceiver(flow.attachReceiver);
+      } catch (final Exception e) {
+        // already unregistered
+      }
+      flow.attachReceiver = null;
+    }
+  }
+
+  private static void stopLateUsbWatch(final FlowState flow) {
+    unregisterAttachReceiver(flow);
+    MAIN.removeCallbacks(flow.poll);
+  }
+
+  // ---------------------------------------------------------------- exchange
+
+  /** Worker thread: prepare the session and run the CTAP2 command for {@code flow}. */
+  private static void runExchange(final FlowState flow, final Ctap2Session session) {
+    final Request request = flow.request;
+    try {
+      if (!session.prepare()) {
+        throw new Ctap2Error("could not reach the FIDO2 authenticator on the security key");
+      }
+      final Object response =
+          request.makeCredential
+              ? doMakeCredential(request, session)
+              : doGetAssertion(request, session);
+      flow.settleSuccess(response);
+    } catch (final Exception e) {
+      Log.e(LOGTAG, "security key operation failed", e);
+      flow.settleError(mapError(e));
+    } finally {
+      try {
+        session.close();
+      } catch (final Exception e) {
+        // best-effort
+      }
+    }
+  }
+
+  private static WebAuthnUtils.MakeCredentialResponse doMakeCredential(
+      final Request request, final Ctap2Session session) {
+    final byte[] cbor =
+        Ctap2Cbor.encodeMakeCredential(
+            request.clientDataHash,
+            request.rpId,
+            request.rpName,
+            request.userId,
+            request.userName,
+            request.userDisplayName,
+            request.pubKeyCredParams,
+            request.excludeList,
+            request.residentKeyRequested,
+            request.userVerificationRequired);
+    final Ctap2Cbor.MakeCredentialResponse ctap =
+        Ctap2Cbor.decodeMakeCredential(
+            session.send(Ctap2Session.CTAP_MAKE_CREDENTIAL, cbor));
+    final WebAuthnUtils.MakeCredentialResponse.Builder builder =
+        new WebAuthnUtils.MakeCredentialResponse.Builder()
+            .setKeyHandle(extractCredentialId(ctap.authData))
+            .setClientDataJson(null)
+            .setAttestationObject(ctap.attestationObject)
+        .setTransports(new String[] {"usb", "nfc"})
+        .setAuthenticatorAttachment("cross-platform");
+    if (request.reportCredProps) {
+      // Best effort: report the rk option we actually sent.
+      builder.setCredProps(request.residentKeyRequested);
+    }
+    return builder.build();
+  }
+
+  private static WebAuthnUtils.GetAssertionResponse doGetAssertion(
+      final Request request, final Ctap2Session session) {
+    // WebAuthn L2 10.1 (appid): the AppID replaces the RP id in the CTAP2 request so legacy
+    // U2F credentials (scoped to the AppID) match; clientDataHash still covers the real origin.
+    final String rpIdForKey =
+        request.appId != null && !request.appId.isEmpty() ? request.appId : request.rpId;
+    final byte[] cbor =
+        Ctap2Cbor.encodeGetAssertion(
+            rpIdForKey,
+            request.clientDataHash,
+            request.allowList,
+            request.appId,
+            request.userVerificationRequired);
+    final Ctap2Cbor.GetAssertionResponse ctap =
+        Ctap2Cbor.decodeGetAssertion(
+            session.send(Ctap2Session.CTAP_GET_ASSERTION, cbor), request.allowList);
+    return new WebAuthnUtils.GetAssertionResponse.Builder()
+        .setClientDataJson(null)
+        .setKeyHandle(ctap.credentialId)
+        .setAuthData(ctap.authenticatorData)
+        .setSignature(ctap.signature)
+        .setUserHandle(ctap.userHandle)
+        .setAuthenticatorAttachment("cross-platform")
+        .build();
+  }
+
+  /**
+   * The credential id lives in the authenticator data: after rpIdHash(32) flags(1) signCount(4)
+   * aaguid(16) comes credIdLen(2) credId, present whenever the AT flag 0x40 is set (always the
+   * case for a makeCredential response).
+   */
+  private static byte[] extractCredentialId(final byte[] authData) {
+    if (authData != null
+        && authData.length >= 55
+        && (authData[32] & 0x40) != 0) {
+      final int credIdLen = ((authData[53] & 0xFF) << 8) | (authData[54] & 0xFF);
+      if (authData.length >= 55 + credIdLen) {
+        final byte[] id = new byte[credIdLen];
+        System.arraycopy(authData, 55, id, 0, credIdLen);
+        return id;
+      }
+    }
+    return new byte[0];
+  }
+
+  // ---------------------------------------------------------------- helpers
+
+  private static UsbDevice findUsbSecurityKey() {
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    final UsbManager usb = (UsbManager) ctx.getSystemService(Context.USB_SERVICE);
+    if (usb == null) {
+      return null;
+    }
+    for (final UsbDevice device : usb.getDeviceList().values()) {
+      if (device.getVendorId() == USB_VENDOR_YUBICO) {
+        return device;
+      }
+    }
+    return null;
+  }
+
+  private static boolean hasUsbPermission(final UsbDevice device) {
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    final UsbManager usb = (UsbManager) ctx.getSystemService(Context.USB_SERVICE);
+    return usb != null && usb.hasPermission(device);
+  }
+
+  @SuppressWarnings("deprecation")
+  private static UsbDevice getUsbDeviceExtra(final Intent intent) {
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+      return intent.getParcelableExtra(UsbManager.EXTRA_DEVICE, UsbDevice.class);
+    }
+    return intent.getParcelableExtra(UsbManager.EXTRA_DEVICE);
+  }
+
+  /**
+   * Maps CTAP2 status codes (spec section 6.1) and transport failures to the WebAuthn error names
+   * Gecko's AndroidWebAuthnService understands. Presence/consent failures map to NOT_ALLOWED_ERR
+   * per the WebAuthn spec.
+   */
+  private static WebAuthnUtils.Exception mapError(final Throwable ex) {
+    final int status = ex instanceof Ctap2Error ? ((Ctap2Error) ex).getCtapStatus() : 0;
+    switch (status) {
+      case 0x11: // CBOR_UNEXPECTED_TYPE
+      case 0x12: // INVALID_CBOR
+      case 0x14: // MISSING_PARAMETER
+        return new WebAuthnUtils.Exception("ENCODING_ERR");
+      case 0x16: // UNSUPPORTED_EXTENSION
+      case 0x26: // UNSUPPORTED_ALGORITHM
+      case 0x2B: // UNSUPPORTED_OPTION
+      case 0x2C: // INVALID_OPTION
+      case 0x39: // REQUEST_TOO_LARGE
+        return new WebAuthnUtils.Exception("NOT_SUPPORTED_ERR");
+      case 0x19: // CREDENTIAL_EXCLUDED (already registered)
+        return new WebAuthnUtils.Exception("INVALID_STATE_ERR");
+      case 0x2E: // NO_CREDENTIALS
+      case 0x2D: // KEEPALIVE_CANCEL
+      case 0x27: // OPERATION_DENIED
+        return new WebAuthnUtils.Exception("NOT_ALLOWED_ERR");
+      case 0x2F: // USER_ACTION_TIMEOUT
+      case 0x3A: // ACTION_TIMEOUT
+        return new WebAuthnUtils.Exception("TIMEOUT_ERR");
+      default:
+        Log.w(LOGTAG, "security key failure: " + ex.getMessage());
+        return new WebAuthnUtils.Exception("NOT_ALLOWED_ERR");
+    }
+  }
+
+  // ---------------------------------------------------------------- activity tracking
+
+  /**
+   * Tracks the resumed Activity from the application context: NFC reader mode and the
+   * permission/attach receivers are scoped to it. Registered lazily, once, on the main thread.
+   */
+  private static void ensureActivityTracking() {
+    if (sLifecycleHooked) {
+      return;
+    }
+    final Context ctx = GeckoAppShell.getApplicationContext();
+    if (!(ctx instanceof Application)) {
+      return;
+    }
+    ((Application) ctx)
+        .registerActivityLifecycleCallbacks(
+            new Application.ActivityLifecycleCallbacks() {
+              @Override
+              public void onActivityResumed(final Activity activity) {
+                sResumedActivity = new WeakReference<>(activity);
+              }
+
+              @Override
+              public void onActivityPaused(final Activity activity) {
+                final Activity tracked = sResumedActivity.get();
+                if (tracked == activity) {
+                  sResumedActivity = new WeakReference<>(null);
+                }
+              }
+
+              @Override
+              public void onActivityCreated(
+                  final Activity activity, final android.os.Bundle savedInstanceState) {}
+
+              @Override
+              public void onActivityStarted(final Activity activity) {}
+
+              @Override
+              public void onActivityStopped(final Activity activity) {}
+
+              @Override
+              public void onActivitySaveInstanceState(
+                  final Activity activity, final android.os.Bundle outState) {}
+
+              @Override
+              public void onActivityDestroyed(final Activity activity) {}
+            });
+    sLifecycleHooked = true;
+  }
+
+  // ---------------------------------------------------------------- sessions
+
+  private static final class NfcSession implements Ctap2Session {
+    private final NfcCtap2Transport mTransport;
+
+    NfcSession(final NfcCtap2Transport transport) {
+      mTransport = transport;
+    }
+
+    @Override
+    public boolean prepare() {
+      return mTransport.selectFidoApplet();
+    }
+
+    @Override
+    public byte[] send(final int ctapCmd, final byte[] cbor) {
+      return mTransport.sendCtapCommand(ctapCmd, cbor);
+    }
+
+    @Override
+    public void close() {
+      mTransport.release();
+    }
+  }
+
+  private static final class UsbSession implements Ctap2Session {
+    private final UsbCtap2Transport mTransport;
+
+    UsbSession(final UsbCtap2Transport transport) {
+      mTransport = transport;
+    }
+
+    @Override
+    public boolean prepare() {
+      if (!mTransport.initialize()) {
+        throw new Ctap2Error("the USB security key did not respond (channel allocation failed)");
+      }
+      return true;
+    }
+
+    @Override
+    public byte[] send(final int ctapCmd, final byte[] cbor) {
+      return mTransport.sendCtapCommand(ctapCmd, cbor);
+    }
+
+    @Override
+    public void close() {
+      mTransport.release();
+    }
+  }
+}
