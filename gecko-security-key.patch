+    final Thread worker =
+        new Thread(
+            () -> {
+              final NfcCtap2Transport transport = new NfcCtap2Transport();
+              Ctap2Session session;
+              try {
+                if (!transport.bindTag(tag)) {
+                  throw new Ctap2Error("the tag does not support contactless (IsoDep) exchange");
+                }
+                session = new NfcSession(transport);
+              } catch (final Ctap2Error e) {
+                transport.release();
+                flow.settleError(mapError(e));
+                return;
+              }
+              runExchange(flow, session);
+            },
+            "GeckoCtap2Nfc");
+    worker.setDaemon(true);
+    worker.start();
+  }
+
+  /** Starts the USB CTAP2 exchange for {@code device} (permission already granted). */
+  private static void startUsbFlow(final FlowState flow, final UsbDevice device) {
+    if (flow.settled.get() || !flow.transportClaimed.compareAndSet(false, true)) {
+      return;
+    }
+    stopLateUsbWatch(flow);
+    unregisterPermissionReceiver(flow);
+    final Activity activity = sResumedActivity.get();
+    if (flow.nfcReader != null && activity != null) {
+      flow.nfcReader.stop(activity);
+    }
+    final Thread worker =
+        new Thread(
+            () -> {
+              final UsbCtap2Transport transport = new UsbCtap2Transport();
+              final UsbManager usb =
+                  (UsbManager)
+                      GeckoAppShell.getApplicationContext()
+                          .getSystemService(Context.USB_SERVICE);
