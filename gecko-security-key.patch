+    }
+    map.Add(CBORObject.FromObject(2), rp);
+
+    final CBORObject user = CBORObject.NewMap();
+    user.Add(CBORObject.FromObject("id"), CBORObject.FromObject(userId));
+    if (userName != null && !userName.isEmpty()) {
+      user.Add(CBORObject.FromObject("name"), CBORObject.FromObject(userName));
+    }
+    if (userDisplayName != null && !userDisplayName.isEmpty()) {
+      user.Add(CBORObject.FromObject("displayName"), CBORObject.FromObject(userDisplayName));
+    }
+    map.Add(CBORObject.FromObject(3), user);
+
+    final CBORObject params = CBORObject.NewArray();
+    for (final PublicKeyCredParam p : pubKeyCredParams) {
+      // pubKeyCredParams entries use TEXT keys (PublicKeyCredentialParameters, [WebAuthn] 5.8).
+      final CBORObject entry = CBORObject.NewMap();
+      entry.Add(CBORObject.FromObject("type"), CBORObject.FromObject("public-key"));
+      entry.Add(CBORObject.FromObject("alg"), CBORObject.FromObject(p.alg));
+      params.Add(entry);
+    }
+    map.Add(CBORObject.FromObject(4), params);
+
+    if (excludeList != null && !excludeList.isEmpty()) {
+      final CBORObject arr = CBORObject.NewArray();
+      for (final CredentialId cred : excludeList) {
+        // excludeList descriptors use TEXT keys (PublicKeyCredentialDescriptor, [WebAuthn] 5.8.3)
+        // — same shape as allowList entries.
+        final CBORObject entry = CBORObject.NewMap();
+        entry.Add(CBORObject.FromObject("type"), CBORObject.FromObject("public-key"));
+        entry.Add(CBORObject.FromObject("id"), CBORObject.FromObject(cred.id));
+        arr.Add(entry);
+      }
+      map.Add(CBORObject.FromObject(5), arr);
+    }
+
+    final CBORObject opts = CBORObject.NewMap();
+    opts.Add(CBORObject.FromObject("up"), CBORObject.FromObject(true));
+    if (residentKey) {
+      opts.Add(CBORObject.FromObject("rk"), CBORObject.FromObject(true));
+    }
+    if (userVerificationRequired) {
+      opts.Add(CBORObject.FromObject("uv"), CBORObject.FromObject(true));
+    }
+    map.Add(CBORObject.FromObject(7), opts);
+    return map.EncodeToBytes(CTAP2_CANONICAL);
+  }
+
+  /**
+   * Decodes the authenticatorMakeCredential response. The raw CTAP2 (section 5.1) envelope uses
+   * INTEGER keys: 1=fmt (text), 2=authData (byte string), 3=attStmt (a CBOR map). That envelope is
+   * NOT what Gecko's (auth-rs) parser consumes — it expects the [WebAuthn] attestation object, a
+   * map with TEXT keys { authData, fmt, attStmt }. This decodes the raw envelope and re-encodes the
+   * WebAuthn object, mirroring what the GMS FIDO client handed to Gecko. The caller recovers the
+   * credentialId from {@link MakeCredentialResponse#authData}.
+   */
+  public static MakeCredentialResponse decodeMakeCredential(final byte[] bytes) {
+    final CBORObject map = CBORObject.DecodeFromBytes(bytes);
+    final CBORObject fmt = map.get(1);
+    final CBORObject authData = map.get(2);
+    final CBORObject attStmt = map.get(3);
+    if (fmt == null || authData == null || attStmt == null) {
+      throw new IllegalStateException("CTAP2 makeCredential response missing fmt/authData/attStmt");
+    }
+    final byte[] authDataBytes = asBytes(authData, "authData");
+    final String fmtString = fmt.AsString();
+
+    // Re-encode as the [WebAuthn] attestation object (TEXT keys) Gecko/auth-rs expects.
+    final CBORObject attObj = CBORObject.NewMap();
+    attObj.Add(CBORObject.FromObject("authData"), CBORObject.FromObject(authDataBytes));
+    attObj.Add(CBORObject.FromObject("fmt"), CBORObject.FromObject(fmtString));
+    attObj.Add(CBORObject.FromObject("attStmt"), attStmt);
+    final byte[] attestationObject = attObj.EncodeToBytes(CTAP2_CANONICAL);
+    return new MakeCredentialResponse(fmtString, authDataBytes, attestationObject);
+  }
+
+  private static byte[] asBytes(final CBORObject item, final String field) {
+    if (item == null) {
+      throw new IllegalStateException("CTAP2 response missing key: " + field);
+    }
+    if (item.getType() == CBORType.ByteString) {
+      return item.GetByteString();
+    }
+    if (item.getType() == CBORType.TextString) {
+      return item.AsString().getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    }
+    throw new IllegalStateException("CTAP2 response field " + field + " is not a byte string");
+  }
+}
