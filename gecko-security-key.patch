@@ -0,0 +1,272 @@
+/*
+ * Copyright (c) 2026 haasanen
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package org.mozilla.gecko.ctap2;
+
+import android.app.Activity;
+import android.nfc.NfcAdapter;
+import android.nfc.Tag;
+import android.nfc.tech.IsoDep;
+import android.util.Log;
+import java.io.ByteArrayOutputStream;
+
+/**
+ * CTAP2 over NFC (ISO 14443-4 / IsoDep) transport, per CTAP2 spec section 8.2.
+ *
+ * <p>Framing (spec 8.2.4):
+ *
+ * <ul>
+ *   <li>applet select: 00 A4 04 00 Lc &lt;AID&gt;. Success SW 9000.
+ *   <li>command: 80 10 00 00 Lc &lt;CTAP command byte || CBOR&gt; Le. The data field is the single
+ *       CTAP command byte followed by the CBOR parameters.
+ *   <li>response: SW 9000 + data, where data = CTAP status byte (1) || CBOR. 91 00 = status
+ *       update, 61 xx = xx more bytes; both are followed with a GETRESPONSE.
+ *   <li>GETRESPONSE: 80 C0 00 00 [Le]. INS 0xC0 per the spec's normative trace.
+ * </ul>
+ *
+ * <p>Ported (Java) from the Proton Mail fork's fido-nfc module; the request method is generalized
+ * to take the CTAP command byte so makeCredential (0x01) works beside getAssertion (0x02).
+ */
+public class NfcCtap2Transport {
+
+  static final String TAG = "GeckoCtap2Nfc";
+
+  private static final int TIMEOUT_MS = 5000;
+  private static final int MAX_SHORT_DATA = 255;
+  private static final byte INS_GETRESPONSE = (byte) 0xC0;
+
+  // FIDO2 AID: RID A0 00 00 06 47, PIX 2F 00 01.
+  private static final byte[] AID =
+      new byte[] {(byte) 0xA0, 0x00, 0x00, 0x06, 0x47, 0x2F, 0x00, 0x01};
+
+  private IsoDep mIsoDep;
+
+  /** Binds {@code tag}. Returns false if the tag does not support IsoDep or connect fails. */
+  public boolean bindTag(final Tag tag) {
+    final IsoDep dep = IsoDep.get(tag);
+    if (dep == null) {
+      return false;
+    }
+    try {
+      dep.connect();
+      mIsoDep = dep;
+      return true;
+    } catch (final Exception e) {
+      return false;
+    }
+  }
+
+  public void release() {
+    try {
+      if (mIsoDep != null) {
+        mIsoDep.close();
+      }
+    } catch (final Exception e) {
+      // best-effort
+    }
+    mIsoDep = null;
+  }
+
+  /** FIDO2 applet select (spec 8.2.3). Returns true when the applet is present. */
+  public boolean selectFidoApplet() {
+    final IsoDep dep = mIsoDep;
+    if (dep == null) {
+      return false;
+    }
+    try {
+      final byte[] apdu = new byte[5 + AID.length];
+      apdu[0] = 0x00;
+      apdu[1] = (byte) 0xA4;
+      apdu[2] = 0x04;
+      apdu[3] = 0x00;
+      apdu[4] = (byte) AID.length;
+      System.arraycopy(AID, 0, apdu, 5, AID.length);
+      final byte[] resp = transceive(dep, apdu);
+      final int sw = statusWord(resp);
+      return sw == 0x9000 || (sw >> 8) == 0x61;
+    } catch (final Exception e) {
+      return false;
+    }
+  }
+
+  /**
+   * Runs one CTAP2 command ({@link Ctap2Session#CTAP_MAKE_CREDENTIAL} or {@link
+   * Ctap2Session#CTAP_GET_ASSERTION}). Returns the CBOR response body when the CTAP status is
+   * 0x00; otherwise throws {@link Ctap2Error} with the CTAP status code.
+   */
+  public byte[] sendCtapCommand(final int ctapCmd, final byte[] cborPayload) {
+    final IsoDep dep = mIsoDep;
+    if (dep == null) {
+      throw new Ctap2Error("NFC transport not bound");
+    }
+    // Spec 8.2.4.1: data field = CTAP command byte || CBOR parameters.
+    final byte[] data = new byte[cborPayload.length + 1];
+    data[0] = (byte) ctapCmd;
+    System.arraycopy(cborPayload, 0, data, 1, cborPayload.length);
+    if (data.length > MAX_SHORT_DATA) {
+      throw new Ctap2Error(
+          "CTAP request too large for short APDU: " + data.length);
+    }
+    // Single short (case-4) APDU: 80 10 00 00 Lc <cmd || CBOR> Le=00.
+    final byte[] apdu = new byte[5 + data.length + 1];
+    apdu[0] = (byte) 0x80;
+    apdu[1] = 0x10;
+    apdu[2] = 0x00;
+    apdu[3] = 0x00;
+    apdu[4] = (byte) data.length;
+    System.arraycopy(data, 0, apdu, 5, data.length);
+    apdu[5 + data.length] = 0x00;
+    final byte[] raw = unwrapResponse(transceive(dep, apdu), dep);
+    if (raw.length == 0) {
+      throw new Ctap2Error("empty NFC response");
+    }
+    final int ctapStatus = raw[0];
+    final byte[] body = new byte[raw.length - 1];
+    System.arraycopy(raw, 1, body, 0, body.length);
+    if (ctapStatus != 0x00) {
+      throw new Ctap2Error(
+          "CTAP command 0x"
+              + Integer.toHexString(ctapCmd)
+              + " failed, status 0x"
+              + Integer.toHexString(ctapStatus & 0xFF).toUpperCase(),
+          ctapStatus,
+          null);
+    }
+    return body;
+  }
+
+  /**
+   * Unwraps the ISO 7816 layer: strips status words, follows 9100 (status update) and 61xx (xx
+   * trailing bytes) chains via GETRESPONSE. Returns the application data, i.e. CTAP status byte ||
+   * CBOR. The attestation object of a makeCredential response routinely exceeds 255 bytes, so the
+   * chain is not optional.
+   */
+  private byte[] unwrapResponse(final byte[] first, final IsoDep dep) {
+    final ByteArrayOutputStream out = new ByteArrayOutputStream();
+    byte[] resp = first;
+    int sw = statusWord(resp);
+    while (true) {
+      if (sw == 0x9000) {
+        out.write(bodyOf(resp), 0, bodyOf(resp).length);
+        return out.toByteArray();
+      } else if (sw == 0x9100) {
+        // Status update — poll for data.
+        resp = getResponse(dep, 0);
+        sw = statusWord(resp);
+      } else if ((sw & 0xFF00) == 0x6100) {
+        // xx trailing bytes available; request exactly that many.
+        final byte[] b = bodyOf(resp);
+        out.write(b, 0, b.length);
+        resp = getResponse(dep, sw & 0xFF);
+        sw = statusWord(resp);
+      } else {
+        throw new Ctap2Error(
+            "NFC rejected, SW 0x" + Integer.toHexString(sw).toUpperCase());
+      }
+    }
+  }
+
+  /**
+   * GETRESPONSE (INS 0xC0, per the spec's normative trace). {@code le} is the number of bytes to
+   * request; 0 = up to 256 (Le omitted / 0x00 in short form).
+   */
+  private byte[] getResponse(final IsoDep dep, final int le) {
+    final byte[] apdu =
+        le == 0
+            ? new byte[] {(byte) 0x80, INS_GETRESPONSE, 0x00, 0x00}
+            : new byte[] {(byte) 0x80, INS_GETRESPONSE, 0x00, 0x00, (byte) le};
+    return transceive(dep, apdu);
+  }
+
+  private byte[] transceive(final IsoDep dep, final byte[] apdu) {
+    dep.setTimeout(TIMEOUT_MS);
+    try {
+      return dep.transceive(apdu);
+    } catch (final Exception e) {
+      Log.e(TAG, "transceive failed req=[" + toHex(apdu) + "]", e);
+      throw new Ctap2Error("NFC transceive failed: " + e.getMessage(), 0, e);
+    }
+  }
+
+  private static byte[] bodyOf(final byte[] resp) {
+    if (resp.length <= 2) {
+      return new byte[0];
+    }
+    final byte[] body = new byte[resp.length - 2];
+    System.arraycopy(resp, 0, body, 0, body.length);
+    return body;
+  }
+
+  private static String toHex(final byte[] data) {
+    final StringBuilder sb = new StringBuilder();
+    for (final byte b : data) {
+      if (sb.length() > 0) {
+        sb.append(' ');
+      }
+      sb.append(String.format("%02X", b & 0xFF));
+    }
+    return sb.toString();
+  }
+
+  private static int statusWord(final byte[] resp) {
+    if (resp.length < 2) {
+      return -1;
+    }
+    return ((resp[resp.length - 2] & 0xFF) << 8) | (resp[resp.length - 1] & 0xFF);
+  }
+
+  /**
+   * Holds the host activity in NFC reader mode for the duration of a key tap; every
+   * IsoDep-capable tag is forwarded to the listener. Ending the activity tears the reader down
+   * (Android disables reader mode with the activity).
+   */
+  public static class NfcReader {
+
+    /** Receives every IsoDep-capable tag tapped while the reader is armed. */
+    public interface TagListener {
+      void onTag(Tag tag);
+    }
+
+    private final TagListener mListener;
+
+    public NfcReader(final TagListener listener) {
+      mListener = listener;
+    }
+
+    public boolean start(final Activity activity) {
+      final NfcAdapter adapter = NfcAdapter.getDefaultAdapter(activity);
+      if (adapter == null || !adapter.isEnabled()) {
+        return false;
+      }
+      try {
+        adapter.enableReaderMode(
+            activity,
+            tag -> mListener.onTag(tag),
+            NfcAdapter.FLAG_READER_NFC_A
+                | NfcAdapter.FLAG_READER_SKIP_NDEF_CHECK
+                | NfcAdapter.FLAG_READER_NO_PLATFORM_SOUNDS,
+            null);
+      } catch (final Exception e) {
+        return false;
+      }
+      return true;
+    }
+
+    /**
+     * Disables reader mode on {@code activity}. Called when the USB transport wins the first-wins
+     * race while reader mode is armed.
+     */
+    public void stop(final Activity activity) {
+      final NfcAdapter adapter = NfcAdapter.getDefaultAdapter(activity);
+      if (adapter == null) {
+        return;
+      }
+      try {
+        adapter.disableReaderMode(activity);
+      } catch (final Exception e) {
+        // best-effort
+      }
+    }
+  }
+}
diff --git a/mobile/android/geckoview/src/main/java/org/mozilla/gecko/ctap2/UsbCtap2Transport.java b/mobile/android/geckoview/src/main/java/org/mozilla/gecko/ctap2/UsbCtap2Transport.java
