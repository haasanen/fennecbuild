+  }
+
+  // ---------------------------------------------------------------- flow state
+
+  private static final class Request {
+    boolean makeCredential;
+    String rpId;
+    String rpName;
+    byte[] userId;
+    String userName;
+    String userDisplayName;
+    byte[] clientDataHash;
+    List<Ctap2Cbor.PublicKeyCredParam> pubKeyCredParams;
+    List<Ctap2Cbor.CredentialId> excludeList;
+    List<Ctap2Cbor.CredentialId> allowList;
+    String appId;
+    boolean residentKeyRequested;
+    boolean userVerificationRequired;
+    boolean reportCredProps;
+  }
+
+  private static final class FlowState {
+    final Request request;
+    final GeckoResult<Object> result = new GeckoResult<>();
+    final AtomicBoolean settled = new AtomicBoolean(false);
+    // Claims the single transport worker for this flow (USB and NFC race to claim).
+    final AtomicBoolean transportClaimed = new AtomicBoolean(false);
+    NfcCtap2Transport.NfcReader nfcReader;
+    BroadcastReceiver permissionReceiver;
+    BroadcastReceiver attachReceiver;
+    Runnable grantTimeout;
+    Runnable watchdog;
+    Runnable poll;
+
+    FlowState(final Request request) {
