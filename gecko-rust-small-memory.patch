--- a/build/moz.configure/rust.configure
+++ b/build/moz.configure/rust.configure
@@ -998,13 +998,12 @@ set_config("RUST_PGO_LDFLAGS", rust_pgo_ldflags)
 # cross-language LTO.
 # Never enable when sancov is enabled to work around https://github.com/rust-lang/rust/issues/90300.
 # Never enable when coverage is enabled to work around https://github.com/rust-lang/rust/issues/90045.
-rust_lto_eligible = (
-    ~developer_options
-    & ~debug_rust
-    & ~lto.rust_lto
-    & ~rust_sancov_flags
-    & ~code_coverage
-)
+# Fork (haasanen): Rust fat-LTO (and its -Cembed-bitcode feed) is disabled
+# on this builder: fat-LTO re-runs whole-crate LLVM passes on top of the
+# CGU change above and pushed the geckoservo rustc job past 10 GiB during
+# the 158 build. Setting the gate False turns off RUST_LTO_ELIGIBLE,
+# the per-spec lto flag and -Cembed-bitcode in one place.
+rust_lto_eligible = False
 
 set_config("RUST_LTO_ELIGIBLE", True, when=rust_lto_eligible)
 
@@ -1191,7 +1190,12 @@ set_config("MOZ_CARGO_PROGRAM_LDFLAGS_FILTER_OUT", cargo_ldflags_filter_out.prog
 # If this is a release build we want rustc to generate one codegen unit per
 # crate. This results in better optimization and less code duplication at the
 # cost of longer compile times.
-set_config("MOZ_RUSTFLAGS_CODEGEN", ["-C", "codegen-units=1"], when=~developer_options)
+# Fork (haasanen): force the default codegen-units (16) for
+# non-developer_options builds. Upstream pins CGU=1 (release binary
+# size), which makes single-crate rustc LLVM passes (geckoservo)
+# balloon on this builder. The fork build trades a few % size for
+# builder peak RSS.
+set_config("MOZ_RUSTFLAGS_CODEGEN", [], when=~developer_options)
 
